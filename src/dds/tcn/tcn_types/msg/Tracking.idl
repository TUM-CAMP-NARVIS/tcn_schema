#ifndef TCN_TYPES_MSG_TRACKING_IDL
#define TCN_TYPES_MSG_TRACKING_IDL

#include "tcn_types/msg/Geometry.idl"

module tcn_types {
  module msg {

    // What a tracker reports, and therefore what the engine calls the nodes it
    // discovers: the spatial-query-engine derives a node-name prefix from this
    // value, so every marker of a tracker of this kind becomes
    // '{prefix}__sis_marker__{id}'. It is not cosmetic and it is not free to
    // renumber -- an ordinal that changes meaning renames every node a tracker
    // of that kind ever created.
    //
    // **Append only.** New kinds go at the end.
    enum MarkerType {
      MARKER_TYPE_NONE,
      MARKER_TYPE_ARUCO_MARKER,
      MARKER_TYPE_ARUCO_BOARD,
      MARKER_TYPE_ARUCO_FRACTAL,
      MARKER_TYPE_IR_TARGET,
      MARKER_TYPE_HMD_POSE,
      MARKER_TYPE_APRILTAG
    };

    struct Marker {
      uint32 marker_id;
      Vector3 position;
      float quality; // Normalized 0.0 to 1.0
      boolean visible;
      // How well `position` is known: 0 or 6 doubles, the upper triangle of
      // the 3x3 in row-major order, in m^2. A marker is a 3D point, so this is
      // a 3x3 and not a sub-block of any pose's 6x6.
      //
      // Unrelated to `quality`: that is a vendor's tracking-confidence scalar,
      // this is a metric statement. Neither is derivable from the other.
      sequence<double, 6> position_covariance;
    };

    struct Target {
      uint32 target_id;
      RigidTransform pose;
      float quality; // Normalized 0.0 to 1.0
      sequence<Marker> markers;
      boolean is_tracked; // if enough markers on the tool are visible to track it
      // How well `pose` is known: 0 or 21 doubles, upper triangle of the 6x6,
      // row-major, (tx, ty, tz, rx, ry, rz), m^2/rad^2. Empty means "not
      // stated", which is different from a zero covariance meaning "known
      // exactly". Per target rather than per message, because a message
      // routinely mixes targets that state a covariance with targets that do
      // not; a covariance-aware variant of the whole message would force a
      // producer to fabricate one for the bare targets or discard it for the
      // stated ones.
      //
      // Unrelated to `quality`, as on Marker.
      sequence<double, 21> pose_covariance;
    };

  };
};

#endif
