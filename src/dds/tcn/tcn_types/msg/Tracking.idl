#ifndef TCN_TYPES_MSG_TRACKING_IDL
#define TCN_TYPES_MSG_TRACKING_IDL

#include "tcn_types/msg/Geometry.idl"

module tcn_types {
  module msg {

    // What a tracker reports. It is not cosmetic and it is not free to
    // renumber -- an ordinal that changes meaning changes what every existing
    // tracker of that kind reports.
    //
    // **Append only.** New kinds go at the end.
    @appendable enum MarkerType {
      MARKER_TYPE_NONE,
      MARKER_TYPE_ARUCO_MARKER,
      MARKER_TYPE_ARUCO_BOARD,
      MARKER_TYPE_ARUCO_FRACTAL,
      MARKER_TYPE_IR_TARGET,
      MARKER_TYPE_HMD_POSE,
      MARKER_TYPE_APRILTAG
    };

    // Informational: what kind of physical thing a registered target is.
    // Ordinal 0 is UNKNOWN (was SIS_TK_UNSPECIFIED in 0.9).
    @appendable enum SISTargetKind {
        SIS_TARGET_KIND_UNKNOWN,
        SIS_TARGET_KIND_RIGID_BODY,
        SIS_TARGET_KIND_FIDUCIAL,
        SIS_TARGET_KIND_BOARD,
        SIS_TARGET_KIND_DEVICE
    };

    // A tracked target as the target registry lists it.
    @appendable struct SISTargetInfo {
      uint32 id;
      string name;
      SISTargetKind kind;
    };

    // One target of a TargetTrackingMessage.
    @appendable struct Target {
      uint32 target_id;
      // Absent: no pose at all (not tracked, or never seen) -- never identity
      // (#37 T19).
      @optional RigidTransform pose;
      boolean is_tracked; // if enough markers on the tool are visible to track it
      // How well `pose` is known. Absent means "not stated", which is
      // different from a zero covariance meaning "known exactly". Per target
      // rather than per message, because a message routinely mixes targets
      // that state a covariance with targets that do not.
      @optional SRCovariance6 pose_covariance;
      // When this target's pose was captured, in the message's clock. Absent:
      // the message's header.capture_time_ns (#38 A5).
      @optional int64 capture_time_ns;
    };

  };
};

#endif
