#ifndef TCN_TYPES_MSG_GEOMETRY_IDL
#define TCN_TYPES_MSG_GEOMETRY_IDL

module tcn_types {
  module msg {

    @final struct Vector2 {
      double x;
      double y;
    };

    @final struct Vector3 {
      double x;
      double y;
      double z;
    };

    @final struct Quaternion {
      double x;
      double y;
      double z;
      double w;
    };

    @final struct RigidTransform {
      Vector3 translation;
      Quaternion rotation;
    };

    // How well a 6-DoF pose is known: the upper triangle of the 6x6, row-major,
    // (tx, ty, tz, rx, ry, rz), m^2/rad^2. Absent (an @optional member of this
    // type) means "not stated", which is different from a zero covariance
    // meaning "known exactly".
    @appendable struct SRCovariance6 {
      double upper[21];
    };

    // How well a position is known: the upper triangle of the 3x3, row-major,
    // (x, y, z), m^2.
    @appendable struct SRCovariance3 {
      double upper[6];
    };

    @appendable struct Ray {
      Vector3 origin;
      Vector3 direction;
    };

    @appendable struct ViewPose {
      Vector3 eye;
      Vector3 target;
      Vector3 up;
    };

        // --- coordinate conventions ------------------------------------------

        // Which signed axis plays each of the three roles. 6 x 4 x 2 = 48 valid
        // assignments; anything reusing an axis is degenerate.
        @appendable enum CoordinateAxis {
            COORDINATE_AXIS_UNKNOWN,
            COORDINATE_AXIS_X_POS,
            COORDINATE_AXIS_X_NEG,
            COORDINATE_AXIS_Y_POS,
            COORDINATE_AXIS_Y_NEG,
            COORDINATE_AXIS_Z_POS,
            COORDINATE_AXIS_Z_NEG
        };

        @appendable struct CoordinateSystem {
            CoordinateAxis forward;
            CoordinateAxis right;
            CoordinateAxis up;
            uint8 dimensions;             // 2 or 3
        };

  };
};

#endif
