#ifndef SQE_MSGS_MSG_TRANSFORMS_IDL
#define SQE_MSGS_MSG_TRANSFORMS_IDL

#include "tcn_types/msg/Camera.idl"
#include "tcn_types/msg/Geometry.idl"

module sqe_msgs {
  module msg {

        // A pose and how well it is known.
        //
        // `covariance` is the upper triangle of the 6x6, row-major, ordered
        // (tx, ty, tz, rx, ry, rz) -- translation first -- with m^2 on the
        // translational block and rad^2 on the rotational one; see
        // tcn_types::msg::SRCovariance6. Absent means "not stated", which is
        // different from a zero covariance meaning "known exactly".
        @appendable struct SRPose6D {
            tcn_types::msg::RigidTransform pose;
            @optional tcn_types::msg::SRCovariance6 covariance;
        };

        // A translation and its 3x3 (upper triangle, row-major, m^2); absent
        // means "not stated".
        @appendable struct SRTranslation3D {
            tcn_types::msg::Vector3 translation;
            @optional tcn_types::msg::SRCovariance3 covariance;
        };

        // A point in an image plane, in pixels. The result of a projection,
        // never a declared relation: nothing composes onto it, because the
        // projection that produced it discarded the depth a further hop needs.
        @final struct SRPoint2D {
            double u; double v;
        };

        @appendable enum SRTransformType {
          SR_TRANSFORM_TYPE_UNKNOWN,
          SR_TRANSFORM_TYPE_POSE6D,
          SR_TRANSFORM_TYPE_TRANSLATION3D,
          SR_TRANSFORM_TYPE_PROJECTION,
          SR_TRANSFORM_TYPE_POINT2D
        };

        // A transform's value. Covariance rides inside the pose and translation
        // cases, so there are no separate "with covariance" cases.
        @appendable union SRTransform switch(SRTransformType) {
        case SR_TRANSFORM_TYPE_POSE6D:
            SRPose6D pose6d;
        case SR_TRANSFORM_TYPE_TRANSLATION3D:
            SRTranslation3D translation3d;

        // The intrinsics of a projection edge. No pose: the camera's extrinsics
        // are the ordinary pose edge BEFORE the projection edge, so a camera
        // that moves is a dynamic pose edge like any tracked thing.
        case SR_TRANSFORM_TYPE_PROJECTION:
            tcn_types::msg::CameraIntrinsics projection;

        // A composed result, carried where a transform would otherwise be:
        // what a path ending in a projection resolves to.
        case SR_TRANSFORM_TYPE_POINT2D:
            SRPoint2D point2d;
        };

  };
};

#endif
