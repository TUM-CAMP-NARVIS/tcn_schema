#ifndef SQE_MSGS_MSG_GRAPH_IDL
#define SQE_MSGS_MSG_GRAPH_IDL

#include "builtin_interfaces/msg/Time.idl"
#include "sqe_msgs/msg/Transforms.idl"
#include "tcn_types/msg/Frames.idl"
#include "tcn_types/msg/Geometry.idl"
#include "tcn_types/msg/Ids.idl"
#include "tcn_types/msg/Tracking.idl"

module sqe_msgs {
  module msg {

        // --- nodes -------------------------------------------------------------

        @appendable enum SRNodeType {
          SR_NODE_TYPE_UNKNOWN,
          SR_NODE_TYPE_GENERIC,
          SR_NODE_TYPE_SENSOR,
          SR_NODE_TYPE_DISPLAY,
          SR_NODE_TYPE_TRACKABLE,
          SR_NODE_TYPE_CONTENT
        };

        // --- materialization ---------------------------------------------------

        // Why a node exists although nobody declared it: an observer saw a
        // marker the graph had no node for, and the engine made one.
        //
        // A client usually cannot know which ArUco ids are in the room, or which
        // instruments will be brought in. Such an entity is declared as a
        // device-side template (a frame ref whose selector is INSTANCES); when an
        // observation matches, the engine materializes a concrete node, and the
        // edges that attach to the template, carrying this record. Retiring the
        // template retires everything it materialized.
        @appendable struct SRMaterialization {

            // The template this node came from.
            tcn_types::msg::SRFrameRef template_device;

            // What kind of observation materialized it, and in which marker
            // system ("aruco_4x4_50", ...).
            tcn_types::msg::MarkerType marker_type;
            string marker_system;

            // The observed id that matched.
            uint32 marker_id;

            // The domain the marker id is unique in. "" means engine-wide.
            string marker_domain;

        };

        // A frame of reference. Its identity is (scope, owner, name), where the
        // owner is the declaring fragment for LOCAL, `domain` for DOMAIN and
        // empty for GLOBAL: see tcn_types::msg::SRFrameRef. `name` is the bare
        // identifier, never a composed string.
        @appendable struct SRNode {

            // Identity within its scope and owner. Edges reference nodes through
            // an SRFrameRef built from this.
            string name;

            tcn_types::msg::SRNodeScope scope;

            // Non-empty exactly when scope is DOMAIN: the domain the node joins.
            string domain;

            SRNodeType node_type;

            // The convention this node's data is expressed in.
            tcn_types::msg::CoordinateSystem coord;

            // Inactive nodes are not traversed when resolving a path.
            boolean active;

            // Survives fragment retraction. Set by whatever created the node
            // outside a fragment's lifecycle -- a surveyed fiducial, a
            // calibrated rig. The engine never sets this; it only honours it,
            // so no tool needs the engine's permission to keep its own data.
            boolean pinned;

            // Present: this node's device announces its streams on this topic.
            @optional string stream_descriptor_topic;

            // Stable identity across sessions; absent when unused.
            @optional tcn_types::msg::UUID uuid;

            // Present on a materialized node: where it came from.
            @optional SRMaterialization materialization;

            // For people, not for the engine: free text, both optional in
            // effect, and nothing behaves differently when they are empty -- a
            // reader falls back to `name`.
            string display_name;              // "Left wall marker 3"
            string description;               // how it was surveyed, by whom, when

        };

        // --- edges -------------------------------------------------------------

        // When an edge's value is known. Two different unknowns are expressible:
        // a template covers "which entity is this?"; STATIC_UNCALIBRATED covers
        // "both ends are known, but their relation has not been measured yet"
        // -- which is the work queue an external calibration tool reads.
        @appendable enum SREdgeTiming {
          SR_EDGE_TIMING_UNKNOWN,
          SR_EDGE_TIMING_STATIC,              // fixed by construction or declaration
          SR_EDGE_TIMING_STATIC_UNCALIBRATED, // declared; value not yet measured, not traversable
          SR_EDGE_TIMING_STATIC_CALIBRATED,   // fixed, and measured; carries provenance
          SR_EDGE_TIMING_DYNAMIC              // supplied live by a tracker
        };

        // What an edge relates, independent of when its value is known.
        //
        // A projection into an image plane (camera -> image_plane, the plane
        // being its own node) is `PROJECTION` whatever its timing: a zoom lens
        // is a dynamic projection. It changes what a path *is* -- a projection
        // may only be a path's LAST hop, the composed value is then a 2D image
        // point, and there is no inverse, so a path never walks it backwards.
        @appendable enum SREdgeKind {
          SR_EDGE_KIND_UNKNOWN,
          SR_EDGE_KIND_POSE,
          SR_EDGE_KIND_PROJECTION
        };

        // One edge, named by its endpoints and name. Used by `derived_from`.
        @appendable struct SRRelationRef {
            tcn_types::msg::SRFrameRef source;
            tcn_types::msg::SRFrameRef target;
            string name;
        };

        @appendable struct SRCalibration {
            string method;                    // free-form: "hand-eye", "aruco-board", ...

            // RMS error in metres; absent if not reported.
            @optional double residual;

            builtin_interfaces::msg::Time computed_at;

            // The full uncertainty of the calibrated edge, of which `residual`
            // is one scalar summary. Both are kept: `residual` is what a human
            // reads first, the covariance is what a consumer propagating
            // uncertainty through a chain needs. Absent when not stated.
            @optional tcn_types::msg::SRCovariance6 covariance;

            // Free text about *this* calibration run: which landmarks, whose
            // survey, what the operator noticed. `method` names an algorithm
            // and is matched on; this is never matched on.
            string description;
        };

        @appendable struct SREdge {

            // Identity within the declaring fragment. Parallel edges between the
            // same pair of nodes are legal and are distinguished by this.
            string name;

            tcn_types::msg::SRFrameRef source;
            tcn_types::msg::SRFrameRef target;

            SREdgeKind kind;
            SREdgeTiming timing;

            // The static value, or a dynamic edge's seed. Absent when no value
            // is known (for instance STATIC_UNCALIBRATED): absent is never
            // read as the identity.
            @optional SRTransform transform;

            // Traversal cost. Lower is preferred; a path minimises the sum.
            double weight;

            // Whether a path may walk this relation backwards by composing its
            // inverse. True for a rigid transform, which is what makes the graph
            // effectively bidirectional. False for a relation that discards
            // information -- a projection has no inverse to compose, and
            // pathfinding routes around it rather than through it backwards.
            boolean is_invertible;

            // Dynamic edges: where this edge's live value comes from.
            @optional string stream_descriptor_topic;

            // Which entry of a multi-pose tracker payload feeds this edge; see
            // the XR_POSE_* constants in tcnart_msgs/msg/PoseTracking.idl for
            // the ones this project defines. Present means "this entry, 0
            // included"; absent means "take any entry", which is what a
            // single-entry tracker sends.
            @optional uint32 entry_id;

            // Present for STATIC_CALIBRATED.
            @optional SRCalibration calibration;

            // Survives fragment retraction, exactly as SRNode::pinned does for
            // a node. Without it a calibrated edge is destroyed when the tool
            // that wrote it leaves, because a fragment's retraction deletes
            // every relation wholly within its nodes. The engine never sets
            // this; it only honours it.
            boolean pinned;

            // True on an edge created by materializing a template.
            boolean materialized;

            // True on a *derived* edge -- one published by a relation stream
            // rather than declared by a client; `derived_from` then names every
            // edge the stream's path walked.
            //
            // This is not bookkeeping. A derived edge is weighted below the
            // path it replaces so that pathfinding prefers it, which means
            // pathfinding actively steers into cycles: a stream asked to
            // recompute a relation it already publishes would route through its
            // own output. Compiling a stream excludes any derived edge that
            // transitively depends on the edge being compiled, and this list is
            // what makes that computable -- including after a restart, or by a
            // second engine reading the same graph.
            boolean derived;
            sequence<SRRelationRef> derived_from;

            // For people, not for the engine; see SRNode.
            string display_name;              // "Room to ceiling tracker"
            string description;               // free text: method, date, who

        };

        // --- graph -------------------------------------------------------------

        // A fragment: what one client declares about its own part of the graph.
        // The client's identifier is the key it is written under, not a field.
        @appendable struct SRGraph {

            // The root of this graph: the name of one of `nodes`.
            string origin;

            sequence<SRNode> nodes;
            sequence<SREdge> edges;

            // The fragment's own label, for people.
            string display_name;              // "Ceiling ART system"
            string description;
        };

        // --- views: the graph as the engine holds it --------------------------

        // Everything above is a *declaration*: what a client asserts about its
        // own fragment. The two types below are the other direction -- what a
        // read of the engine's graph answers with. A read is not confined to
        // one fragment: a node's neighbours may sit in another client's
        // fragment, so a view carries the declaring fragment alongside the
        // declaration.
        //
        // Endpoints are always SRFrameRefs, and a read always returns them
        // qualified (a LOCAL ref never has an empty owner), so a reader needs no
        // separate source/target client and never builds or splits a composed
        // string.
        //
        // The embedded SRNode / SREdge is the declaration as stored, so a
        // client may resubmit it unchanged (the write is an idempotent upsert).
        // Two things are still not round-trips, both properties of the store:
        //
        //   * an edge carries one transform in one representation. Pushing a
        //     translation over a pose replaces it, rotation included, and a
        //     view reports what is stored, not what was last sent.
        //   * an edge whose stored representation is ambiguous -- both a 6D and
        //     a 3D row, neither strictly newer -- reads back as
        //     STATIC_UNCALIBRATED with no transform.
        //
        // A view is an observation, not a template for a mutation.

        @appendable struct SRNodeView {

            // The fragment that declared this node.
            string fragment;

            // As stored.
            SRNode node;

        };

        @appendable struct SREdgeView {

            // The fragment that declared this edge. Not necessarily the owner
            // of either endpoint: a client may relate its own node to another
            // fragment's global node.
            string fragment;

            // As stored. `derived_from` names *declared* edges, so it means the
            // same thing whichever read produced this view.
            SREdge edge;

        };

  };
};

#endif
