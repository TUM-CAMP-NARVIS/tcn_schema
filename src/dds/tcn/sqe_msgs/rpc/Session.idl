// The Spatial Information Service.
//
// These are thin RPC envelopes over the spatial relationship graph defined in
// sqe_msgs/msg/Graph.idl and Transforms.idl. The graph is the model; nothing here
// re-describes it.

#ifndef SQE_MSGS_RPC_SESSION_IDL
#define SQE_MSGS_RPC_SESSION_IDL

#include "sqe_msgs/msg/Graph.idl"
#include "sqe_msgs/rpc/Queries.idl"
#include "sqe_msgs/rpc/Reply.idl"

module sqe_msgs {
  module rpc {

    // --- graph lifecycle ---------------------------------------------------

    // Announce a client and its whole graph at once. A QUERY since 0.9.0
    // (engine B73), answered with SISJoinReply once the fragment is stored:
    // a `stream/start` sent after the reply sees it. All or nothing -- a graph
    // whose origin is not among its nodes, or with any node or edge the engine
    // refuses, is answered REJECTED with every reason in `header.detail`, and
    // nothing is stored. A second join from the same client replaces its
    // fragment.
    @appendable struct SISJoinRequest {
        sqe_msgs::msg::SRGraph graph;
    };

    // Announce departure. Without this a client is only collected after the
    // inactivity timeout. Carries nothing: the client is the key's prefix
    // (`{client}/sis/leave`), so a body naming it could only disagree (N9).
    @appendable struct SISLeaveRequest {
    };

    // What the answering engine is and offers (#35 R5, D4). Carried by the join
    // reply, the operator info reply and the unscoped `sqe/{engine}/info` summary.
    @appendable struct SISEngineCapabilities {
        uint32 protocol_break;          // highest compatibility break (B<n>) implemented
        sequence<string> capabilities;  // optional features, each [a-z0-9_]{1,64}, e.g. "sample";
                                        //   a client refuses a malformed name
        string client_scope;            // the client-id prefix served, ending at a `/` chunk
                                        //   boundary; "" = every client
        string engine_version;
        string schema_version;          // tcn_schema release, e.g. "0.11.0"
    };

    // The answer to SISJoinRequest. `header.status` is OK when the fragment is
    // stored; otherwise as SISMutationReply (REJECTED, UNAVAILABLE, ...), and
    // `engine` is still filled so a refused client learns what it talked to.
    @appendable struct SISJoinReply {
        SISReplyHeader header;
        SISEngineCapabilities engine;
    };

    // The operator surface (B82, sqe/{engine_id}/op/*) is described at the top of sqe_msgs/rpc/Operator.idl; the
    // operator identity and op/info live here because every operator request and the engine info use them.

    // Who is asking. An operator key carries no client id, so this is what
    // the operator rate limit is keyed on and what the engine's log names.
    // Free-form, e.g. "tcn-web/lab-pc3/alice".
    @appendable struct SISOperatorRef {
        string requester;
    };

    // --- sqe/{engine_id}/op/info ------------------------------------------
    @appendable struct SISEngineInfoRequest {
        SISOperatorRef who;
    };

    @appendable enum SISStoreHealth {
        SIS_STORE_HEALTH_UNKNOWN,
        SIS_STORE_HEALTH_OK,              // a probe read came back in time
        SIS_STORE_HEALTH_DEGRADED,        // it came back slowly; store_detail says how
        SIS_STORE_HEALTH_UNAVAILABLE      // it failed or timed out; reads and writes will too
    };

    // The bounds one class of reader is held to.
    @appendable struct SISReadLimits {
        uint32 max_items;          // nodes plus relations per graph-read reply
        uint32 max_bytes;          // bytes per reply
        uint32 reads_per_second;   // per requester
    };

    // `header.status` is OK, REJECTED (MALFORMED: undecodable) or UNAVAILABLE
    // (LIMIT_EXCEEDED: the operator rate limit); every other field is then
    // zero or empty except `engine`.
    @appendable struct SISEngineInfoReply {
        SISReplyHeader header;
        SISEngineCapabilities engine;
        SISStoreHealth store;
        string store_detail;
        uint32 fragments_joined;   // clients holding a liveliness token now
        uint32 fragments_stored;   // fragments stored in scope, connected or not
        uint32 relation_streams;   // running
        SISReadLimits client_limits;     // {client_id}/sis/graph/query
        SISReadLimits operator_limits;   // sqe/{engine_id}/op/graph/query
    };

    // --- sqe/{engine_id}/info ---------------------------------------------
    //
    // Unscoped and unauthenticated: answers SISEngineInfoRequest with what a
    // client needs to choose an engine before joining, and nothing about its
    // load or store (#35 R5, D4).
    @appendable struct SISEngineSummaryReply {
        SISReplyHeader header;
        SISEngineCapabilities engine;
    };

  };
};

#endif
