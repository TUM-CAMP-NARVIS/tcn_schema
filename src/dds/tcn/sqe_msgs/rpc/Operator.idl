// The Spatial Information Service.
//
// These are thin RPC envelopes over the spatial relationship graph defined in
// sqe_msgs/msg/Graph.idl and Transforms.idl. The graph is the model; nothing here
// re-describes it.

#ifndef SQE_MSGS_RPC_OPERATOR_IDL
#define SQE_MSGS_RPC_OPERATOR_IDL

#include "sqe_msgs/rpc/Mutations.idl"
#include "sqe_msgs/rpc/Queries.idl"
#include "sqe_msgs/rpc/Reply.idl"
#include "sqe_msgs/rpc/Session.idl"
#include "sqe_msgs/rpc/Streams.idl"

module sqe_msgs {
  module rpc {

    // ======================================================================
    // B82 (0.9.2): the operator surface -- sqe/{engine_id}/op/*
    // ======================================================================
    //
    // For an operator tool (the SRG frontend in tcn_web_controller): what is
    // stored, what is connected, what changed, and edits to fragments the
    // tool does not own. In the engine's OWN namespace rather than under a
    // client's key, for three reasons: the questions are the operator's, not
    // a client's (SISGraphQueryRequest refuses cross-fragment reads on a
    // client key, by design); the key names the engine, so exactly one engine
    // answers; and an edit never has to impersonate the owning client.
    //
    // Answered only for fragments inside the engine's client scope
    // (`--client-scope`). Requests are CDR or JSON; replies mirror the
    // request's encoding.
    //
    //   sqe/{engine_id}/op/info         SISEngineInfoRequest -> SISEngineInfoReply
    //   sqe/{engine_id}/op/fragments    SISFragmentListRequest -> SISFragmentListReply
    //   sqe/{engine_id}/op/graph/query  SISOperatorGraphQueryRequest -> SISGraphQueryReply
    //   sqe/{engine_id}/op/update       SISOperatorMutationRequest -> SISMutationReply
    //   sqe/{engine_id}/op/explain      SISExplainRequest -> SISExplainReply
    //   sqe/{engine_id}/op/txlog        SISTransactionLogRequest -> SISTransactionLogReply
    //   sqe/{engine_id}/op/changes      SISGraphChangeNotification (published)
    //
    // Discover engines with a liveliness get on sqe/*/alive/*, then pick the
    // one whose SISEngineInfoReply.client_scope is your location.
    //
    // SISOperatorRef and the op/info types are in sqe_msgs/rpc/Session.idl.

    // --- sqe/{engine_id}/op/fragments -------------------------------------
    @appendable struct SISFragmentListRequest {
        SISOperatorRef who;
        string prefix;             // keep ids under this prefix, by whole chunks;
                                   //   "" = the whole scope; outside it = REJECTED + NOT_PERMITTED
        string cursor;             // opaque; "" on the first page
    };

    // Ordered by `fragment`. `header.status` is TRUNCATED with a `next_cursor` when there are more pages; the
    // statuses mean what they mean on a graph read. SISFragmentSummary is in Queries.idl.
    @appendable struct SISFragmentListReply {
        SISReplyHeader header;
        sequence<SISFragmentSummary> fragments;
        @optional string next_cursor;
    };

    // --- sqe/{engine_id}/op/graph/query -----------------------------------
    // The client graph read, unchanged, answered with SISGraphQueryReply.
    // Charged to the operator's bucket (SISEngineInfoReply.operator_limits),
    // and every anchor (a fragment, or the owner of a LOCAL frame) must lie in
    // the engine's scope; a GLOBAL frame always does. A snapshot
    // is the fragment list followed by one FRAGMENT read per fragment.
    @appendable struct SISOperatorGraphQueryRequest {
        SISOperatorRef who;
        SISGraphQueryRequest query;
    };

    // --- sqe/{engine_id}/op/changes (published) ---------------------------
    @appendable enum SISGraphChangeKind {
        SIS_GRAPH_CHANGE_KIND_UNKNOWN,
        SIS_GRAPH_CHANGE_KIND_FRAGMENT_REPLACED,  // a join or re-join: re-read the fragment
        SIS_GRAPH_CHANGE_KIND_FRAGMENT_REMOVED,   // retracted after its client left
        SIS_GRAPH_CHANGE_KIND_CLIENT_JOINED,      // liveliness token appeared; graph unchanged
        SIS_GRAPH_CHANGE_KIND_CLIENT_LEFT,        // liveliness token gone
        SIS_GRAPH_CHANGE_KIND_NODE_CHANGED,       // `node` is the node
        SIS_GRAPH_CHANGE_KIND_NODE_REMOVED,
        SIS_GRAPH_CHANGE_KIND_EDGE_CHANGED,   // `edge` is the relation; includes calibrations
                                   //   and operator edits
        SIS_GRAPH_CHANGE_KIND_EDGE_REMOVED
    };

    // Who made a change (#35 N10): `id` is the client id for CLIENT, the operator's `requester` for OPERATOR, and
    // empty for ENGINE.
    @appendable enum SISChangeOriginKind {
        SIS_CHANGE_ORIGIN_KIND_UNKNOWN,
        SIS_CHANGE_ORIGIN_KIND_CLIENT,      // a client's own write
        SIS_CHANGE_ORIGIN_KIND_OPERATOR,    // op/update
        SIS_CHANGE_ORIGIN_KIND_ENGINE       // the engine's own (derivation, retraction, collection)
    };

    @appendable struct SISChangeOrigin {
        SISChangeOriginKind kind;
        string id;
    };

    // Names what changed; does not carry it -- re-read what it names. `header` is an OK header (it carries the
    // `engine_epoch`); `sequence_number` is gapless within one `engine_epoch`: a gap, or a new epoch, means "re-read
    // everything". `node` is set for the NODE_* kinds and `edge` for the EDGE_* kinds; neither for the fragment
    // and client kinds.
    @appendable struct SISGraphChangeNotification {
        SISReplyHeader header;
        uint64 sequence_number;
        SISGraphChangeKind kind;
        string fragment;           // the fragment affected
        @optional tcn_types::msg::SRFrameRef node;
        @optional sqe_msgs::msg::SRRelationRef edge;
        SISChangeOrigin origin;
    };

    // --- sqe/{engine_id}/op/update ----------------------------------------
    @appendable enum SISOperatorMutationKind {
        SIS_OPERATOR_MUTATION_KIND_UNKNOWN,
        SIS_OPERATOR_MUTATION_KIND_NODE_UPDATE,
        SIS_OPERATOR_MUTATION_KIND_NODE_REMOVE,
        SIS_OPERATOR_MUTATION_KIND_EDGE_UPDATE,
        SIS_OPERATOR_MUTATION_KIND_EDGE_REMOVE
    };

    // The per-client mutation payloads, reused unchanged.
    @appendable union SISOperatorMutation switch (SISOperatorMutationKind) {
        case SIS_OPERATOR_MUTATION_KIND_NODE_UPDATE: SISNodeUpdateRequest node_update;
        case SIS_OPERATOR_MUTATION_KIND_NODE_REMOVE: SISNodeRemoveRequest node_remove;
        case SIS_OPERATOR_MUTATION_KIND_EDGE_UPDATE: SISEdgeUpdateRequest edge_update;
        case SIS_OPERATOR_MUTATION_KIND_EDGE_REMOVE: SISEdgeRemoveRequest edge_remove;
    };

    // Applies `mutation` to fragment `fragment` as though that client had sent
    // it: the same validation, answered with SISMutationReply.
    //
    // An operator edit lasts until the owner next declares the same thing: a
    // re-join replaces the whole fragment, and the owner's own update of the
    // same node or relation replaces the edit. The change feed reports both.
    @appendable struct SISOperatorMutationRequest {
        SISOperatorRef who;
        string fragment;           // the fragment to edit; must lie in scope
        SISOperatorMutation mutation;
    };

    // =====================================================================
    // B89 (0.9.3): explain -- how a relation is computed
    // =====================================================================
    //
    //   sqe/{engine_id}/op/explain     SISExplainRequest -> SISExplainReply
    //
    // Open to every client, like the other op/* reads, and answered only
    // inside the engine's client scope. Charged to the operator bucket of
    // `who.requester` (SISEngineInfoReply.operator_limits).
    //
    // A plan is the route the engine compiled for a relation, written down:
    // per materialized target an ordered chain of operations, the live inputs
    // the chain samples, and per hop where its value comes from. Composing the
    // ops left to right, with every DYNAMIC op replaced by its input's sample
    // at one instant, is exactly what the engine publishes for that instant.

    // What to explain. Ordinals are the wire encoding; append only.
    @appendable enum SISExplainKind {
        SIS_EXPLAIN_KIND_UNKNOWN,
        SIS_EXPLAIN_KIND_RELATION,        // dry run: compile observer/target now, start nothing
        SIS_EXPLAIN_KIND_STREAM           // the running stream `handle`: the route it is on
    };

    // What to explain (#35 F10): a relation, as a start would name it, or a running stream.
    @appendable union SISExplainSubject switch (SISExplainKind) {
        // The relation, as a SISRelationStreamStartRequest would name it. The same terms compile the same route a
        // start would.
        case SIS_EXPLAIN_KIND_RELATION: SISRelationTerms terms;
        // The handle a start reply issued.
        case SIS_EXPLAIN_KIND_STREAM: string handle;
    };

    @appendable struct SISExplainRequest {
        SISOperatorRef who;
        SISExplainSubject subject;
    };

    // What the engine knows about a running stream's inputs right now.
    @appendable struct SISPlanLive {
        boolean running;                // a pipeline is evaluating this stream here
        sequence<int64> input_newest_ns;   // per input: newest buffered stamp (ns), 0 = none
        string last_hole;               // why the last tick had no value; "" = none yet
        uint64 published;               // messages published since the pipeline started
    };

    // `header.status` says whether the question was answered:
    //   OK            answered; `relation` says what the relation is
    //   NOT_FOUND     SIS_EXPLAIN_KIND_STREAM: no stream has that handle
    //   REJECTED      MALFORMED (undecodable), or NOT_PERMITTED (a frame outside the client scope)
    //   UNAVAILABLE   the operator rate limit, or the graph read failed
    // `relation` is what a start would be answered (dry run) or what the
    // stream is (stream): ACTIVE with a plan, or PENDING with its park reason
    // and, when uncalibrated, `blocked_by` -- and then no plan. A dry run that
    // finds no route is REJECTED + NO_PATH (or CLOCK_DOMAIN_MISMATCH), with
    // `relation.detail` saying why.
    // `live` is present for a running stream, absent for a dry run.
    @appendable struct SISExplainReply {
        SISReplyHeader header;
        SISRelationStatus relation;
        @optional SISTranslationPlan plan;
        @optional SISPlanLive live;
    };

    // --- Transaction log (engine B92, tcn_schema 0.10.1) -----------------
    //
    //   sqe/{engine_id}/op/txlog   SISTransactionLogRequest -> SISTransactionLogReply
    //
    // Starts, stops or reads the engine's transaction log: every structural
    // change (fragments, relation writes with their outcome, computed
    // relations, streams with their terms, routes and status transitions) as
    // JSON Lines in a file on the engine's host, beginning with a snapshot.
    // Nothing realtime. Open to every operator, inside the engine's client
    // scope, on the operator budget. The engine logs only with
    // --transaction-log-dir; otherwise a start is REJECTED + UNSUPPORTED.

    // Ordinals are the wire encoding; append only.
    @appendable enum SISTransactionLogAction {
        SIS_TRANSACTION_LOG_ACTION_UNKNOWN,
        SIS_TRANSACTION_LOG_ACTION_STATUS,          // say what is running; change nothing
        SIS_TRANSACTION_LOG_ACTION_START,           // start a log labelled `label`, stopping a running one
        SIS_TRANSACTION_LOG_ACTION_STOP             // stop the running log
    };

    @appendable struct SISTransactionLogRequest {
        SISOperatorRef who;
        SISTransactionLogAction action;
        string label;           // SIS_TRANSACTION_LOG_ACTION_START: names the log; part of its file name
    };

    // The log the request leaves running, or the one it stopped. `header.status` is OK when the request was
    // carried out; REJECTED (UNSUPPORTED: no log directory; MALFORMED: a bad request) or UNAVAILABLE (the file
    // could not be created) with `header.detail` otherwise.
    @appendable struct SISTransactionLogReply {
        SISReplyHeader header;
        boolean active;
        string label;
        string file;            // on the engine's host
        int64 started_ns;       // ns since the Unix epoch; 0 = no log
        uint64 records;
        uint64 dropped;   // lost because the writer could not keep up
    };

  };
};

#endif
