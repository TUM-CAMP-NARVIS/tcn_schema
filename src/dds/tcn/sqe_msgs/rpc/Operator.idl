// The Spatial Information Service.
//
// These are thin RPC envelopes over the spatial relationship graph defined in
// sqe_msgs/msg/Graph.idl and Transforms.idl. The graph is the model; nothing here
// re-describes it.

#ifndef SQE_MSGS_RPC_OPERATOR_IDL
#define SQE_MSGS_RPC_OPERATOR_IDL

#include "sqe_msgs/rpc/Mutations.idl"
#include "sqe_msgs/rpc/Queries.idl"
#include "sqe_msgs/rpc/Session.idl"
#include "sqe_msgs/rpc/Streams.idl"

module sqe_msgs {
  module rpc {

    // --- sqe/{engine_id}/op/fragments -------------------------------------
    struct SISFragmentListRequest {
        SISOperatorRef who;
        string prefix;             // keep ids under this prefix, by whole chunks;
                                   //   "" = the whole scope; outside it = REJECTED
        uint32 max_items;          // may only lower the engine's cap; 0 = default
        string cursor;             // opaque; "" on the first page
    };

    struct SISFragmentSummary {
        string client;             // the fragment id (the client id it joined under)
        string origin;             // its origin node
        boolean joined;            // the client holds its liveliness token now; a
                                   //   stored fragment of a departed client is
                                   //   still served until it is collected
        int64 last_updated_ms;     // last accepted write or heartbeat
        uint32 node_count;
        uint32 relation_count;     // relations the fragment declares
    };

    // Ordered by `client`. SIS_GQ_TRUNCATED with a `next_cursor` when there
    // are more pages; the statuses mean what they mean on a graph read.
    struct SISFragmentListReply {
        SISGraphQueryStatus status;
        sequence<SISFragmentSummary> fragments;
        string next_cursor;
        string detail;
    };

    // --- sqe/{engine_id}/op/graph/query -----------------------------------
    // The client graph read, unchanged, answered with SISGraphQueryReply.
    // Charged to the operator's bucket (SISEngineInfoReply.operator_limits),
    // and every anchor (`client`, `from.client`, `to.client`) must lie in the
    // engine's scope; a global frame (empty client) always does. A snapshot
    // is the fragment list followed by one SIS_GQ_FRAGMENT read per fragment.
    struct SISOperatorGraphQueryRequest {
        SISOperatorRef who;
        SISGraphQueryRequest query;
    };

    // --- sqe/{engine_id}/op/changes (published) ---------------------------
    enum SISGraphChangeKind {
        SIS_GC_FRAGMENT_REPLACED,  // a join or re-join: re-read the fragment
        SIS_GC_FRAGMENT_REMOVED,   // retracted after its client left
        SIS_GC_CLIENT_JOINED,      // liveliness token appeared; graph unchanged
        SIS_GC_CLIENT_LEFT,        // liveliness token gone
        SIS_GC_NODE_CHANGED,       // `name` is the node
        SIS_GC_NODE_REMOVED,
        SIS_GC_RELATION_CHANGED,   // `name` is the relation; includes calibrations
                                   //   and operator edits
        SIS_GC_RELATION_REMOVED
    };

    // Names what changed; does not carry it -- re-read what it names.
    // `sequence_number` is gapless within one `engine_epoch`: a gap, or a new epoch,
    // means "re-read everything".
    struct SISGraphChangeNotification {
        uint64 sequence_number;
        uint64 engine_epoch;
        SISGraphChangeKind kind;
        string client;             // the fragment affected
        string name;               // node or relation name; "" for fragment kinds
        string origin;             // the client id for a client's own write, the
                                   //   operator's `requester` for op/update,
                                   //   "engine" for the engine's own
    };

    // --- sqe/{engine_id}/op/update ----------------------------------------
    enum SISOperatorMutationKind {
        SIS_OM_NODE_UPDATE,
        SIS_OM_NODE_REMOVE,
        SIS_OM_EDGE_UPDATE,
        SIS_OM_EDGE_REMOVE
    };

    // The per-client mutation payloads, reused unchanged.
    union SISOperatorMutation switch (SISOperatorMutationKind) {
        case SIS_OM_NODE_UPDATE: SISNodeUpdateRequest node_update;
        case SIS_OM_NODE_REMOVE: SISNodeRemoveRequest node_remove;
        case SIS_OM_EDGE_UPDATE: SISEdgeUpdateRequest edge_update;
        case SIS_OM_EDGE_REMOVE: SISEdgeRemoveRequest edge_remove;
    };

    // Applies `mutation` to fragment `client` as though that client had sent
    // it: the same validation, answered with SISMutationReply.
    //
    // An operator edit lasts until the owner next declares the same thing: a
    // re-join replaces the whole fragment, and the owner's own update of the
    // same node or relation replaces the edit. The change feed reports both.
    struct SISOperatorMutationRequest {
        SISOperatorRef who;
        string client;             // the fragment to edit; must lie in scope
        SISOperatorMutation mutation;
    };

    // =====================================================================
    // B89 (0.9.3): explain -- how a relation is computed
    // =====================================================================
    //
    //   sqe/{engine_id}/op/explain     SISExplainRequest -> SISExplainReply
    //
    // Open to every client, like the other op/* reads, and answered only
    // inside the engine's client scope. Charged to the operator bucket of
    // `who.requester` (SISEngineInfoReply.operator_limits).
    //
    // A plan is the route the engine compiled for a relation, written down:
    // per materialized target an ordered chain of operations, the live inputs
    // the chain samples, and per hop where its value comes from. Composing the
    // ops left to right, with every DYNAMIC op replaced by its input's sample
    // at one instant, is exactly what the engine publishes for that instant.

    // What to explain. Ordinals are the wire encoding; append only.
    enum SISExplainKind {
        SIS_EX_RELATION,        // dry run: compile observer/target now, start nothing
        SIS_EX_STREAM           // the running stream `handle`: the route it is on
    };

    struct SISExplainRequest {
        SISOperatorRef who;
        SISExplainKind kind;
        // SIS_EX_RELATION: the relation, as a SISRelationStreamStartRequest
        // would name it. The same frames, trigger and bias compile the same
        // route a start would.
        SISFrameRef observer;
        SISFrameRef target;
        SRStreamTrigger trigger;
        double freshness_bias;
        // SIS_EX_STREAM: the handle a SISRelationStreamReply issued.
        string handle;
    };

    // What the engine knows about a running stream's inputs right now.
    // Empty for a dry run.
    struct SISPlanLive {
        boolean running;                // a pipeline is evaluating this stream here
        sequence<int64> input_newest_ns;   // per input: newest buffered stamp (ns), 0 = none
        string last_hole;               // why the last tick had no value; "" = none yet
        uint64 published;               // messages published since the pipeline started
    };

    // `status` says whether the question was answered:
    //   SIS_GQ_OK            answered; `relation` says what the relation is
    //   SIS_GQ_UNKNOWN_FRAME SIS_EX_STREAM: no stream has that handle
    //   SIS_GQ_REJECTED      undecodable, or a frame outside the client scope
    //   SIS_GQ_UNAVAILABLE   the operator rate limit, or the graph read failed
    // `relation` is what a start would be answered (dry run) or what the
    // stream is (stream): SIS_RS_ACTIVE with a plan, or SIS_RS_NO_PATH /
    // SIS_RS_PENDING / SIS_RS_UNKNOWN_FRAME / SIS_RS_CLOCK_DOMAIN_MISMATCH
    // with `relation_detail` and, when pending, `blocked_by` -- and then an
    // empty plan.
    struct SISExplainReply {
        SISGraphQueryStatus status;
        string detail;
        SISRelationStreamStatus relation;
        string relation_detail;
        sequence<SISBlockingRelation> blocked_by;
        SISTranslationPlan plan;
        SISPlanLive live;
    };

    // --- Transaction log (engine B92, tcn_schema 0.10.1) -----------------
    //
    //   sqe/{engine_id}/op/txlog   SISTransactionLogRequest -> SISTransactionLogReply
    //
    // Starts, stops or reads the engine's transaction log: every structural
    // change (fragments, relation writes with their outcome, computed
    // relations, streams with their terms, routes and status transitions) as
    // JSON Lines in a file on the engine's host, beginning with a snapshot.
    // Nothing realtime. Open to every operator, inside the engine's client
    // scope, on the operator budget. The engine logs only with
    // --transaction-log-dir; otherwise a start is SIS_GQ_REJECTED.

    // Ordinals are the wire encoding; append only.
    enum SISTransactionLogAction {
        SIS_TL_STATUS,          // say what is running; change nothing
        SIS_TL_START,           // start a log labelled `label`, stopping a running one
        SIS_TL_STOP             // stop the running log
    };

    struct SISTransactionLogRequest {
        SISOperatorRef who;
        SISTransactionLogAction action;
        string label;           // SIS_TL_START: names the log; part of its file name
    };

    // The log the request leaves running, or the one it stopped. `status` is
    // SIS_GQ_OK when the request was carried out; SIS_GQ_REJECTED (no log
    // directory, a bad request) or SIS_GQ_UNAVAILABLE (the file could not be
    // created) with `detail` otherwise.
    struct SISTransactionLogReply {
        SISGraphQueryStatus status;
        string detail;
        boolean active;
        string label;
        string file;            // on the engine's host
        int64 started_ns;       // ns since the Unix epoch; 0 = no log
        uint64 records;
        uint64 dropped;   // lost because the writer could not keep up
    };

  };
};

#endif
