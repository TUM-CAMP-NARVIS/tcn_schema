// The Spatial Information Service.
//
// These are thin RPC envelopes over the spatial relationship graph defined in
// sqe_msgs/msg/Graph.idl and Transforms.idl. The graph is the model; nothing here
// re-describes it.

#ifndef SQE_MSGS_RPC_TARGETS_IDL
#define SQE_MSGS_RPC_TARGETS_IDL

#include "tcn_types/msg/Ids.idl"

module sqe_msgs {
  module rpc {

    // --- global target registry (0.9.0, engine B78) ------------------------
    //
    // One catalogue per engine of the physical things several tracking
    // systems see: "this is the probe; ART calls it body 3, NDI calls it the
    // tool on port 2". A registered target's `name` is used verbatim as the
    // name of a Global node, so two fragments that resolved the same target
    // meet at one node without coordinating their configs.
    //
    // Two consumers:
    //   * a template marker camera sets StreamDescriptorMessage.marker_system;
    //     a marker id registered under (marker_system, str(id)) is
    //     materialized as the registered target's node (name and uuid)
    //     instead of `{prefix}__sis_marker__{id}`;
    //   * a client that names its own nodes (concrete edge claims) resolves
    //     (system, key) here and declares the returned `name` as its Global
    //     node. The engine never rewrites node names inside a fragment.
    //
    // Not in the registry: poses, calibrations, static edges. Those are
    // fragments or pinned nodes owned by whoever measured them.

    @appendable enum SISTargetKind {
        SIS_TK_UNSPECIFIED,
        SIS_TK_RIGID_BODY,
        SIS_TK_FIDUCIAL,
        SIS_TK_BOARD,
        SIS_TK_DEVICE
    };

    // How one tracking system identifies a target. `(system, key)` is unique
    // across the whole registry: one alias, one target.
    @appendable struct SISTargetAlias {
        string system;   // namespace: "art", "ndi", "irtrack",
                         // "aruco:DICT_4X4_50", "apriltag:36h11", ...;
                         // installations of one kind by suffix ("art:lab1")
        string key;      // the system's configured identity, as a string:
                         // an ART body id ("3"), an ArUco id ("7"), a name
        string config;   // opaque to the engine: what a tracker needs to
                         // configure itself for this target (a ROM file name,
                         // a target definition file). May be empty.
    };

    @appendable struct SISGlobalTarget {
        string name;                       // the Global node name; immutable
        tcn_types::msg::UUID uuid;       // stable identity, goes into
                                           // SRNode.uuid. All-zero in a
                                           // REGISTER asks the engine to
                                           // assign one.
        SISTargetKind kind;                // informational
        sequence<SISTargetAlias> aliases;
        string description;
        string custom_data;                // same convention as SRNode
    };

    @appendable enum SISTargetQueryKind {
        SIS_TQ_RESOLVE,   // (system, key) -> the one target holding that alias
        SIS_TQ_LIST,      // system -> every target with an alias in it
        SIS_TQ_GET,       // name -> that target
        SIS_TQ_ALL        // every target (the export)
    };

    // `{client_id}/sis/target/query` -- a query.
    @appendable struct SISTargetQueryRequest {
        SISTargetQueryKind kind;
        string system;    // RESOLVE, LIST
        string key;       // RESOLVE
        string name;      // GET
    };

    @appendable enum SISTargetQueryStatus {
        SIS_TQS_OK,         // `targets` holds the answer; empty is an answer
                            // for LIST and ALL
        SIS_TQS_NOT_FOUND,  // RESOLVE or GET named nothing registered
        SIS_TQS_REJECTED    // malformed (a required field empty)
    };

    @appendable struct SISTargetQueryReply {
        SISTargetQueryStatus status;
        string detail;                       // empty exactly when OK
        sequence<SISGlobalTarget> targets;
    };

    @appendable enum SISTargetMutationKind {
        SIS_TM_REGISTER,  // a new name; refused if the name or any alias is
                          // taken (the detail names the holder)
        SIS_TM_UPDATE,    // replace kind, aliases, description and
                          // custom_data of an existing name; the uuid is kept
                          // (a non-zero uuid that differs is refused)
        SIS_TM_REMOVE     // by `target.name`; markers materialized under it
                          // fall back to their template names, fragments keep
                          // their (now unregistered) nodes
    };

    // `{client_id}/sis/target/update` -- a query answered with
    // SISMutationReply. The engine may be configured to accept mutations from
    // listed client ids only.
    @appendable struct SISTargetMutationRequest {
        SISTargetMutationKind kind;
        SISGlobalTarget target;
    };

    // Published by the engine on `sqe/{engine_id}/targets/changed` after every
    // accepted mutation. A client that resolved names re-resolves and re-joins
    // if a target it uses changed.
    @appendable struct SISTargetChange {
        boolean removed;            // true: `target` (name only is reliable)
                                    // is no longer registered
        SISGlobalTarget target;     // the entry after the change
    };

  };
};

#endif
