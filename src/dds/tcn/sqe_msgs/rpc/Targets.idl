// The Spatial Information Service.
//
// These are thin RPC envelopes over the spatial relationship graph defined in
// sqe_msgs/msg/Graph.idl and Transforms.idl. The graph is the model; nothing here
// re-describes it.

#ifndef SQE_MSGS_RPC_TARGETS_IDL
#define SQE_MSGS_RPC_TARGETS_IDL

#include "sqe_msgs/rpc/Reply.idl"
#include "tcn_types/msg/Ids.idl"
#include "tcn_types/msg/Tracking.idl"

module sqe_msgs {
  module rpc {

    // --- global target registry (0.9.0, engine B78) ------------------------
    //
    // One catalogue per engine of the physical things several tracking
    // systems see: "this is the probe; ART calls it body 3, NDI calls it the
    // tool on port 2". A registered target's `name` is used verbatim as the
    // name of a Global node, so two fragments that resolved the same target
    // meet at one node without coordinating their configs.
    //
    // Two consumers:
    //   * a template marker camera sets StreamDescriptorMessage.marker_system;
    //     a marker id registered under (family, variant, str(id)) is
    //     materialized as the registered target's node (name and uuid)
    //     instead of a node whose name the engine chooses (SRMaterialization
    //     records where it came from);
    //   * a client that names its own nodes (concrete edge claims) resolves
    //     (family, variant, key) here and declares the returned `name` as its Global
    //     node. The engine never rewrites node names inside a fragment.
    //
    // Not in the registry: poses, calibrations, static edges. Those are
    // fragments or pinned nodes owned by whoever measured them.

    // How one tracking system identifies a target (#35 N10). `(family, variant, key)` is unique across the whole
    // registry: one alias, one target. The 0.10 `system` string packed family and variant into one value
    // ("aruco:DICT_4X4_50", "art:lab1") and every consumer split it by hand; they are separate fields now.
    @appendable struct SISTargetAlias {
        string family;   // the tracking technology: "art", "ndi", "irtrack", "aruco", "apriltag", ...
        string variant;  // the configuration within the family: "DICT_4X4_50", "36h11", an
                         // installation ("lab1"). "" when the family has none
        string key;      // the system's configured identity, as a string:
                         // an ART body id ("3"), an ArUco id ("7"), a name
        string config;   // opaque to the engine: what a tracker needs to
                         // configure itself for this target (a ROM file name,
                         // a target definition file). May be empty.
    };

    @appendable struct SISGlobalTarget {
        string name;                       // the Global node name; immutable
        @optional tcn_types::msg::UUID uuid;   // stable identity, goes into SRNode.uuid. Absent in a REGISTER
                                           // asks the engine to assign one.
        tcn_types::msg::SISTargetKind kind;  // informational
        sequence<SISTargetAlias> aliases;
        string description;
    };

    @appendable enum SISTargetQueryKind {
        SIS_TARGET_QUERY_KIND_UNKNOWN,
        SIS_TARGET_QUERY_KIND_RESOLVE,   // (family, variant, key) -> the one target holding that alias
        SIS_TARGET_QUERY_KIND_LIST,      // family [, variant] -> every target with an alias in it
        SIS_TARGET_QUERY_KIND_GET,       // name -> that target
        SIS_TARGET_QUERY_KIND_ALL        // every target (the export)
    };

    @appendable struct SISTargetAliasKey {
        string family;
        string variant;     // "" when the family has none
        string key;
    };

    // LIST's argument: absent `variant` keeps every variant of the family.
    @appendable struct SISTargetFamily {
        string family;
        @optional string variant;
    };

    @appendable union SISTargetQuery switch (SISTargetQueryKind) {
        case SIS_TARGET_QUERY_KIND_RESOLVE: SISTargetAliasKey alias;
        case SIS_TARGET_QUERY_KIND_LIST: SISTargetFamily family;
        case SIS_TARGET_QUERY_KIND_GET: string name;
        case SIS_TARGET_QUERY_KIND_ALL: SISEmpty all;
    };

    // `{client_id}/sis/target/query` -- a query.
    @appendable struct SISTargetQueryRequest {
        SISTargetQuery query;
    };

    // `header.status`: OK (`targets` holds the answer; empty is an answer for LIST and ALL), NOT_FOUND (RESOLVE or
    // GET named nothing registered) or REJECTED + MALFORMED (a required field empty).
    @appendable struct SISTargetQueryReply {
        SISReplyHeader header;
        sequence<SISGlobalTarget> targets;
    };

    @appendable enum SISTargetMutationKind {
        SIS_TARGET_MUTATION_KIND_UNKNOWN,
        SIS_TARGET_MUTATION_KIND_REGISTER,  // a new name; refused if the name or any alias is
                          // taken (the detail names the holder)
        SIS_TARGET_MUTATION_KIND_UPDATE,    // replace kind, aliases and
                          // description of an existing name; the uuid is kept
                          // (a present uuid that differs is refused)
        SIS_TARGET_MUTATION_KIND_REMOVE     // by `target.name`; markers materialized under it
                          // fall back to their template names, fragments keep
                          // their (now unregistered) nodes
    };

    // `{client_id}/sis/target/update` -- a query answered with
    // SISMutationReply. The engine may be configured to accept mutations from
    // listed client ids only.
    @appendable struct SISTargetMutationRequest {
        SISTargetMutationKind kind;
        SISGlobalTarget target;
    };

    // Published by the engine on `sqe/{engine_id}/targets/changed` after every
    // accepted mutation. A client that resolved names re-resolves and re-joins
    // if a target it uses changed.
    @appendable struct SISTargetChange {
        SISReplyHeader header;      // an OK header
        boolean removed;            // true: `target` (name only is reliable)
                                    // is no longer registered
        SISGlobalTarget target;     // the entry after the change
    };

  };
};

#endif
