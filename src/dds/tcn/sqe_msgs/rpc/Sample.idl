// The Spatial Information Service.
//
// These are thin RPC envelopes over the spatial relationship graph defined in
// sqe_msgs/msg/Graph.idl and Transforms.idl. The graph is the model; nothing here
// re-describes it.

#ifndef SQE_MSGS_RPC_SAMPLE_IDL
#define SQE_MSGS_RPC_SAMPLE_IDL

#include "sqe_msgs/rpc/Streams.idl"
#include "tcn_types/msg/Tracking.idl"

module sqe_msgs {
  module rpc {

    // --- Relation sample (engine B93, tcn_schema 0.10.6) -----------------
    //
    //   {client}/sis/stream/sample     SISRelationSampleRequest -> SISRelationSampleReply
    //                                  (`/sis/relation/sample` until 0.11)
    //
    // One value of a relation at one instant: the route a start would compile,
    // evaluated once, from the same buffered samples and with the same
    // interpolation and extrapolation a stream uses -- so a sample at t equals a
    // running stream's message at t. Nothing is started: no handle, no status
    // topic, no derived edge, no transaction-log record. The engine keeps the
    // route and its inputs' subscriptions warm for a short time after each
    // sample (--sample-linger-ms), so a repeat is cheap. A read: charged to the
    // requester's graph-read bucket, frames inside the engine's client scope.
    // An engine older than B93 does not answer (the query closes empty).

    // Which instant to sample. Ordinals are the wire encoding; append only.
    @appendable enum SISRelationSampleInstant {
        SIS_RELATION_SAMPLE_INSTANT_UNKNOWN,
        SIS_RELATION_SAMPLE_INSTANT_AT,              // `stamp_ns`, a data stamp in the route's clock domain
        SIS_RELATION_SAMPLE_INSTANT_NOW,             // what a FIXED_RATE trigger samples at when the request
                                // arrives: host now - system latency - the route's
                                // largest declared sensor latency
        SIS_RELATION_SAMPLE_INSTANT_LATEST           // the newest instant every input has data for: the
                                // minimum over the inputs of their newest stamp. Never
                                // extrapolates
    };

    // `terms` exactly as a start would name the relation, so a sample compiles
    // the route that start would. `trigger` and `reoptimise` are validated
    // like a start's but do not change the value.
    @appendable struct SISRelationSampleRequest {
        SISRelationTerms terms;
        SISRelationSampleInstant instant;
        @optional int64 stamp_ns;       // present exactly when `instant` is AT: ns, > 0
        @optional uint32 wait_ms;       // how long to wait for data; absent = the engine's
                                        //   default (500), capped at 5000
        boolean include_plan;           // also return the route as a plan
    };

    // What a sample that was carried out (`header.status` OK) came to.
    // Ordinals are the wire encoding; append only.
    @appendable enum SISSampleOutcome {
        SIS_SAMPLE_OUTCOME_UNKNOWN,
        SIS_SAMPLE_OUTCOME_VALUE,       // a value at `stamp_ns`, for at least one instance
        SIS_SAMPLE_OUTCOME_NO_VALUE,    // a route, but no instance resolved at the instant: an
                                        //   input silent within the wait, or the instant past
                                        //   its extrapolation horizon (see `inputs`)
        SIS_SAMPLE_OUTCOME_TOO_OLD      // the instant is before an input's held history
                                        //   (about 2 s, and only while the input is read)
    };

    // One input of the route, in plan order: what was buffered for it when the
    // sample was evaluated.
    @appendable struct SISSampleInput {
        string topic;
        int64 oldest_ns;                // oldest buffered stamp; 0 = none
        int64 newest_ns;                // newest buffered stamp; 0 = none
        int64 extrapolated_ns;          // how far past newest_ns the instant was;
                                        //   0 = interpolated (or no value)
    };

    // `header.status`:
    //   OK            `outcome` says whether there is a value; `relation.state` is ACTIVE
    //   REJECTED      MALFORMED (undecodable, bias outside [0, 1], AT without a
    //                 stamp), NOT_PERMITTED (a frame outside the client scope),
    //                 NO_PATH (no route now) or CLOCK_DOMAIN_MISMATCH
    //   UNAVAILABLE   the rate limit or the sampler table (LIMIT_EXCEEDED), or the
    //                 graph read failed or timed out
    // On any status but OK, `relation` follows the rule in SISRelationStatus
    // (state UNKNOWN; `relation.detail` says why for NO_PATH and
    // CLOCK_DOMAIN_MISMATCH, as a start's reply would), and `outcome` is UNKNOWN.
    @appendable struct SISRelationSampleReply {
        SISReplyHeader header;
        SISRelationStatus relation;
        SISSampleOutcome outcome;
        @optional int64 stamp_ns;       // the instant evaluated; absent when none was
        tcn_types::msg::ClockDomain clock_domain;   // the route's
        // One per instance that resolved at the instant, exactly as a stream
        // publishes them on its data topic (target_id = materialized id; 0 for
        // a plain relation). An instance with a hole is absent.
        sequence<tcn_types::msg::Target> targets;
        sequence<SISSampleInput> inputs;
        boolean cached;                 // the route came from the sampler cache
        uint32 waited_ms;               // how long the engine waited for data
        @optional SISTranslationPlan plan;   // with include_plan and a route
    };

  };
};

#endif
