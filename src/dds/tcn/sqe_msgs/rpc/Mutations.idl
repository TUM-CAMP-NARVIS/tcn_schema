// The Spatial Information Service.
//
// These are thin RPC envelopes over the spatial relationship graph defined in
// sqe_msgs/msg/Graph.idl and Transforms.idl. The graph is the model; nothing here
// re-describes it.

#ifndef SQE_MSGS_RPC_MUTATIONS_IDL
#define SQE_MSGS_RPC_MUTATIONS_IDL

#include "sqe_msgs/msg/Graph.idl"
#include "sqe_msgs/rpc/Reply.idl"
#include "tcn_types/msg/Frames.idl"

module sqe_msgs {
  module rpc {

    // A query since 0.9.0 (B73), answered with SISMutationReply.
    @appendable struct SISNodeUpdateRequest {
        sqe_msgs::msg::SRNode node;
    };

    // Refused for the graph's origin node (REJECTED + NOT_PERMITTED). A query since 0.9.0 (B73).
    @appendable struct SISNodeRemoveRequest {
        tcn_types::msg::SRFrameRef node;
    };

    @appendable struct SISEdgeUpdateRequest {
        sqe_msgs::msg::SREdge edge;
    };

    // Removes exactly the named edge, not every edge between its endpoints: an edge is addressed by its two
    // endpoints and its name together (#35 N4), because a name alone may be declared by two fragments.
    // A query since 0.9.0 (B73).
    @appendable struct SISEdgeRemoveRequest {
        sqe_msgs::msg::SRRelationRef edge;
    };

    // --- the answer to a mutation -----------------------------------------

    // Every mutation key is a **queryable** (since 0.9.0, B73): node update/remove, edge update/remove, the target
    // registry update and the operator update answer with this one type, and join with SISJoinReply, which opens
    // with the same header. A `put` on any of them is ignored and logged by the engine as a peer built against an
    // older protocol. `/sis/leave` is the deliberate exception and never answers -- a withdrawn liveliness token
    // reaches the identical departure with no query behind it to answer, and one route answering while the other
    // cannot is worse than uniform silence.
    //
    // The rule this protocol follows is **queryable when the caller needs an answer**, not "queryable when the
    // operation reads". A calibration push is exactly the case: a rig that computed a transform and cannot tell
    // whether the graph now holds it has not finished its job.
    //
    // `header.status`:
    //   OK              stored: the row and its transform are in the database. It does NOT mean visible to the
    //                   next read -- a read is a separate query on a separate task, and nothing orders it against
    //                   this reply. There is no read-your-write guarantee here to give.
    //   UNKNOWN_CLIENT  no such fragment; join before mutating it
    //   UNKNOWN_FRAME   a named endpoint node does not exist; which one is in `detail`
    //   REJECTED        MALFORMED (undecodable, a non-finite weight, an invalid identifier), NOT_PERMITTED (a
    //                   timing transition the engine refuses, a push naming an engine-derived edge, removing the
    //                   origin node) or SCHEMA_MISMATCH; a join is all or nothing, with every reason in `detail`
    //   UNAVAILABLE     the write did not complete inside its bound (STORE_UNAVAILABLE when the store is down).
    //                   This means *unknown*, not "did not land"; retrying is safe because the write is an upsert.
    //
    // It carries no handle and no echo of what was written. An echo would be a read, and a read riding on a write
    // reply is the one shape guaranteed to disagree with the read RPC beside it (SISGraphQueryReply).
    @appendable struct SISMutationReply {
        SISReplyHeader header;
    };

  };
};

#endif
