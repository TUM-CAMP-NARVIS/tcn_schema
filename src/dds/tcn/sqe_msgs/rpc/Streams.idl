// The Spatial Information Service.
//
// These are thin RPC envelopes over the spatial relationship graph defined in
// sqe_msgs/msg/Graph.idl and Transforms.idl. The graph is the model; nothing here
// re-describes it.

#ifndef SQE_MSGS_RPC_STREAMS_IDL
#define SQE_MSGS_RPC_STREAMS_IDL

#include "sqe_msgs/msg/Graph.idl"
#include "sqe_msgs/msg/Transforms.idl"
#include "sqe_msgs/rpc/Reply.idl"
#include "tcnart_msgs/msg/PoseTracking.idl"
#include "tcn_types/msg/Camera.idl"
#include "tcn_types/msg/Clock.idl"
#include "tcn_types/msg/Frames.idl"
#include "tcn_types/msg/Geometry.idl"

module sqe_msgs {
  module rpc {

    // --- relation streams -------------------------------------------------

    // Which dynamic hop of a compiled path drives an SR_STREAM_TRIGGER_KIND_ON_REFERENCE
    // stream. Ordinals are the wire encoding; append only.
    @appendable enum SRReferencePolicy {
        SR_REFERENCE_POLICY_UNKNOWN,
        SR_REFERENCE_POLICY_FIRST,                  // the hop closest to the observer -- first in
                                        // path order, the request naming its path as
                                        // "target located in observer"
        SR_REFERENCE_POLICY_FASTEST,                // the hop with the highest declared frame_rate
        SR_REFERENCE_POLICY_SLOWEST                 // the hop with the lowest declared frame_rate
    };

    @appendable enum SRStreamTriggerKind {
        SR_STREAM_TRIGGER_KIND_UNKNOWN,
        SR_STREAM_TRIGGER_KIND_FIXED_RATE,         // a timer; sample at "now" less the system latency
        SR_STREAM_TRIGGER_KIND_ON_STREAM,          // a named stream; sample at its stamp
        SR_STREAM_TRIGGER_KIND_ON_ANY,             // any input on the path; sample at the arriving stamp
        SR_STREAM_TRIGGER_KIND_ON_REFERENCE        // one hop of the path; sample at its stamp
    };

    // When a relation stream is evaluated, and therefore at which instant every
    // edge on the path is sampled. They differ in more than rate: a fixed rate
    // extrapolates every edge to the present, while the others interpolate the
    // rest of the path to one arriving sample's timestamp.
    //
    // SR_STREAM_TRIGGER_KIND_ON_REFERENCE is the one to send for a composed relation, and
    // is what the engine's own clients default to. SR_STREAM_TRIGGER_KIND_ON_ANY fires
    // once per input, so a path's output rate is the *sum* of its inputs'
    // rates -- and since a derived edge is itself an input to whatever reuses
    // it, that compounds down a chain: on a six-joint arm whose every sensor
    // runs at 30 Hz, three chained relations published 90, 150 and 180 Hz.
    //
    // One relation is one stream, shared by every requester, so two clients
    // asking for the same relation with different triggers is refused. Pick
    // one and use it across the deployment.
    @appendable union SRStreamTrigger switch(SRStreamTriggerKind) {
    case SR_STREAM_TRIGGER_KIND_FIXED_RATE:
        double hz;
    case SR_STREAM_TRIGGER_KIND_ON_STREAM:
        string topic;
    case SR_STREAM_TRIGGER_KIND_ON_ANY:
        SISEmpty on_any;
    case SR_STREAM_TRIGGER_KIND_ON_REFERENCE:
        SRReferencePolicy policy;
    };

    // Whether the engine should keep looking for a better route once this
    // stream is running, or serve whatever was best at the moment it compiled.
    //
    // A stream's route is chosen by the pathfinder from what is *walkable* at
    // compile time, and an uncalibrated relation is not walkable. So a request
    // whose shortest route crosses a relation nobody has calibrated yet is
    // served over the longer walkable one -- correctly, and with no way to say
    // so, because relation state ACTIVE is what the client is told. If that
    // calibration later arrives, the shorter route becomes available and
    // nothing looks at it again.
    // UNKNOWN at 0 is never a valid request.
    @appendable enum SISReoptimisePolicy {
        SIS_REOPTIMISE_POLICY_UNKNOWN,
        SIS_REOPTIMISE_POLICY_BEST_AVAILABLE_NOW,  // ordinal 1. Today's behaviour, and the
                                    //   usual choice: serve the best route
                                    //   available at the moment of
                                    //   compilation, and re-evaluate only
                                    //   when something on that route changes.
        SIS_REOPTIMISE_POLICY_BEST_POSSIBLE        // ordinal 2. Serve me now over whatever is
                                    //   available, and move me when a better
                                    //   route appears -- typically when a
                                    //   calibration makes a shorter path
                                    //   walkable.
    };

    // Where a relation stream is evaluated (0.10.0, engine B90). Ordinals are
    // the wire encoding; append only.
    // UNKNOWN at 0 is never a valid request.
    @appendable enum SISEvaluationMode {
        SIS_EVALUATION_MODE_UNKNOWN,
        SIS_EVALUATION_MODE_ENGINE,          // ordinal 1, the usual choice: the engine composes and publishes
                                //   the relation on its handle, as every stream did before
        SIS_EVALUATION_MODE_LOCAL,           // the engine routes and publishes the plan; the client composes
                                //   the relation from the plan's inputs itself (sqe-local). No
                                //   pipeline, no input subscription, no derived edge, nothing
                                //   published on the handle
        SIS_EVALUATION_MODE_BOTH             // the relation on the handle, and the plan
    };

    // How a relation reachable over more than one route is computed (0.11). Only BEST_PATH is served today; FUSED and FILTERED are
    // refused REJECTED + UNSUPPORTED, UNKNOWN REJECTED + MALFORMED. Ordinals
    // are the wire encoding; append only.
    @appendable enum SISFusionPolicy {
        SIS_FUSION_POLICY_UNKNOWN,
        SIS_FUSION_POLICY_BEST_PATH,         // one route: the pathfinder's cheapest
        SIS_FUSION_POLICY_FUSED,             // every route, combined per instant
        SIS_FUSION_POLICY_FILTERED           // every route, combined by a filter over time
    };

    // What relation is asked for, and how it is to be served (0.11, #35 S3).
    // One type for a start, a sample and an explain, so the three name a
    // relation identically and compile the same route.
    //
    // This replaces topic translation. What a consumer wants is not a copy of
    // some pose stream re-expressed, but the answer to "where is target, as seen
    // from observer, at this instant" -- which the engine resolves through the
    // unified graph. The path may cross tracked edges, static edges, calibrated
    // edges, and several clients' graphs; it may also be entirely static.
    //
    // If `target`'s selector is INSTANCES, the stream carries one entry per
    // instance materialized from it -- "every ArUco marker this camera sees, in
    // the headset's frame" -- observed at one instant, in one message.
    //
    // **Stream identity.** `observer`, `target`, `trigger`, `freshness_bias`,
    // `evaluation` and `fusion` are what the engine compares when a second
    // request arrives for a relation it is already serving: one handle per
    // relation, and a request differing in any of them is refused CONFLICT +
    // TERMS_CONFLICT rather than attached, because each changes *what is
    // published*. `reoptimise` is the one member that is not identity: a second
    // request differing only there ATTACHES, and the policy is recorded against
    // the requester (see below).
    @appendable struct SISRelationTerms {
        tcn_types::msg::SRFrameRef observer;   // the frame poses are expressed in
        tcn_types::msg::SRFrameRef target;     // the frame being located
        SRStreamTrigger trigger;

        // How much this consumer prefers freshness over reuse, in [0, 1].
        //
        // A relation already computed by another stream is available as a
        // derived edge weighted below the path it replaces, so it is normally
        // preferred: fewer hops, less work. But it is strictly staler by one
        // publish-ingest-buffer round, which a render loop will never notice
        // and a latency-sensitive alignment might.
        //
        // 0 takes every shortcut available. 1 ignores derived edges entirely
        // and walks only measured relations. Values between move a derived
        // edge's effective weight toward the path it replaced. Applied when the
        // stream is compiled, so no weight changes at runtime and no path is
        // recompiled because a number drifted.
        double freshness_bias;

        // UNKNOWN is never a valid request (REJECTED + MALFORMED), so a client
        // always states a policy; BEST_AVAILABLE_NOW is the usual one.
        //
        // **Not part of stream identity.** Whichever route the engine settles
        // on, the stream carries the same relation, in the same frame, at the
        // same trigger, computed from live data. A stream re-optimises if ANY
        // of its requesters asked for BEST_POSSIBLE -- the union, not the
        // intersection -- so a best-available-now requester sharing such a
        // stream can be re-routed. A running stream is also re-routed whenever
        // a relation on its own path changes; this policy controls on which
        // *occasions* the engine looks for a better route, not whether
        // re-routing can happen at all.
        //
        // Watch `route_epoch` on SISRelationStreamStatusNotification to know
        // when a re-route actually happened.
        SISReoptimisePolicy reoptimise;

        // Part of stream identity. A LOCAL stream's plan is usually wanted
        // without engine-computed hops: send freshness_bias 1 (only measured
        // relations), or keep 0 to read another stream's output as an input (a
        // hybrid route). For LOCAL and BOTH the engine publishes the stream's
        // plan on the reply's `plan_topic` on every route change, answers a get
        // there with the last one, and carries it in the start reply.
        SISEvaluationMode evaluation;

        // Part of stream identity.
        SISFusionPolicy fusion;
    };

    // Publish the spatial relation between two frames as a stream. The client
    // asks *what* relation it wants, not *where* to put it: the engine answers
    // with the topics it assigned (SISRelationStreamReply, below).
    @appendable struct SISRelationStreamStartRequest {
        SISRelationTerms terms;
    };

    // Stops the stream named by the handle the engine issued in
    // SISRelationStreamReply.handle. An unknown handle is answered NOT_FOUND.
    @appendable struct SISRelationStreamStopRequest {
        string handle;
    };

    // --- the state of a relation (0.11, #35 R2) ---------------------------
    //
    // What a relation *is*, as opposed to whether the request about it was
    // carried out (SISReplyHeader.status). A refusal (`REJECTED` + `NO_PATH`,
    // say) is a status; a stream that is accepted but waiting is a state.

    // Ordinals are the wire encoding; append only.
    @appendable enum SISRelationState {
        SIS_RELATION_STATE_UNKNOWN,
        SIS_RELATION_STATE_ACTIVE,           // running: producing values on the data topic
        SIS_RELATION_STATE_PENDING,          // accepted, not producing yet; `park_reason` says why.
                                             //   Re-evaluated on every graph mutation, and resumes on
                                             //   its own once the missing part arrives
        SIS_RELATION_STATE_INACTIVE          // not running: stopped, or never started
    };

    // Why a PENDING relation is parked. Ordinals are the wire encoding; append only.
    @appendable enum SISParkReason {
        SIS_PARK_REASON_UNKNOWN,
        SIS_PARK_REASON_UNCALIBRATED,        // an edge on the route is STATIC_UNCALIBRATED; `blocked_by` names it
        SIS_PARK_REASON_AWAITING_DESCRIPTOR, // a dynamic edge's stream descriptor has not arrived
        SIS_PARK_REASON_INPUT_STARVED,       // an input has published nothing within its window
        SIS_PARK_REASON_RESOLVING,           // the engine is still compiling the route
        SIS_PARK_REASON_WITHDRAWN,           // a frame on the route was withdrawn and is not pinned
                                             //   (a running stream that loses its route)
        SIS_PARK_REASON_CLOCK_DOMAIN_MISMATCH   // the route now crosses unsynchronized clock domains
    };

    // One relation on a pending stream's path whose value is not usable yet.
    //
    // PENDING + UNCALIBRATED says *something* on the path is not calibrated;
    // this says **which**, in a form the client can act on: its next action is
    // a `/sis/edge/update` carrying a full SREdge, and that write is an upsert
    // keyed on (source, target, name) -- exactly `edge`. A declared name alone
    // does not address anything: two fragments may each declare an edge called
    // `origin_camera`.
    //
    // **Which fragment to send the update under.** The one owning a LOCAL
    // endpoint -- `edge.source.owner` when the source is LOCAL, otherwise
    // `edge.target.owner` when the target is, otherwise any joined fragment.
    //
    // The relation is **not** carried as a whole SREdge. An SREdge here would
    // be a read riding on a status message, and it would go stale the moment
    // anything else touched the row -- the same objection SISMutationReply
    // records for its own missing echo. What is carried is an address plus the
    // properties that say why the relation blocks.
    @appendable struct SISBlockingRelation {
        sqe_msgs::msg::SRRelationRef edge;

        // Why this relation cannot be composed: today always timing
        // STATIC_UNCALIBRATED, the one timing the pathfinder refuses (see
        // SREdgeTiming). Carried rather than assumed, so a client branches on
        // the reason instead of on a state that has only ever had one.
        sqe_msgs::msg::SREdgeKind kind;
        sqe_msgs::msg::SREdgeTiming timing;
    };

    // The state of one relation, as a start, a stop, a sample, an explain and
    // every status notification report it.
    //
    // `blocked_by` is filled only for PENDING + UNCALIBRATED, and is
    // **republished whenever the list itself changes**: a stream pending on two
    // uncalibrated relations, one of which is then supplied, publishes PENDING
    // again naming only the one that is left. A client drives its calibration
    // sequence off these republications and is done when ACTIVE arrives. An
    // empty `blocked_by` on any other PENDING is meaningful: there is nothing
    // for a calibration routine to do.
    //
    // **On a reply whose `header.status` is not OK** (a start, stop, sample or
    // explain that was refused or not carried out), `state` is UNKNOWN,
    // `park_reason` is absent and `blocked_by` is empty: the request was not
    // carried out, so there is no relation state to report. For a route
    // refusal (REJECTED + NO_PATH or CLOCK_DOMAIN_MISMATCH) `detail` says why
    // the frames do not connect; otherwise it is empty and `header.detail`
    // carries the reason. A status notification always has `header.status`
    // OK and a real state.
    @appendable struct SISRelationStatus {
        SISRelationState state;
        @optional SISParkReason park_reason;   // present exactly when `state` is PENDING
        string detail;                  // human-readable; may be empty. Not for parsing
        sequence<SISBlockingRelation> blocked_by;
    };

    // --- the plan of a relation (B89, 0.9.3; carried by stream replies since 0.10.0) ---
    //
    // A plan is the route the engine compiled for a relation, written down:
    // per materialized target an ordered chain of operations, the live inputs
    // the chain samples, and per hop where its value comes from. Composing the
    // ops left to right, with every DYNAMIC op replaced by its input's sample
    // at one instant, is exactly what the engine publishes for that instant.

    // Which operation a SISPlanOp is. Ordinals are the wire encoding; append only.
    @appendable enum SISPlanOpKind {
        SIS_PLAN_OP_KIND_UNKNOWN,
        SIS_PLAN_OP_KIND_STATIC,          // a fixed transform, already aligned to the walk
        SIS_PLAN_OP_KIND_DYNAMIC,         // a live input, sampled at the instant
        SIS_PLAN_OP_KIND_COORD_SWAP,      // a change of axis convention
        SIS_PLAN_OP_KIND_PROJECT          // terminal: into an image plane
    };

    @appendable struct SISPlanDynamicOp {
        uint32 input;           // index into SISTranslationPlan.inputs
        boolean inverted;       // compose the sample's inverse (the hop was walked backwards)
    };

    @appendable struct SISPlanCoordSwapOp {
        tcn_types::msg::CoordinateSystem from_coord;
        tcn_types::msg::CoordinateSystem to_coord;
    };

    // STATIC carries a POSE6D or TRANSLATION3D SRTransform; its covariance, when
    // present, is the edge's stated (systematic) one, already conjugated when
    // the hop was walked backwards.
    @appendable union SISPlanOp switch (SISPlanOpKind) {
        case SIS_PLAN_OP_KIND_STATIC:     sqe_msgs::msg::SRTransform static_transform;
        case SIS_PLAN_OP_KIND_DYNAMIC:    SISPlanDynamicOp dynamic;
        case SIS_PLAN_OP_KIND_COORD_SWAP: SISPlanCoordSwapOp coord_swap;
        case SIS_PLAN_OP_KIND_PROJECT:    tcn_types::msg::CameraIntrinsics project;
    };

    // One target's chain. A plain relation has one, `materialized_id` 0; a
    // template target ("every marker this camera sees") has one per
    // materialized marker, keyed by the marker's id.
    @appendable struct SISPlanInstance {
        uint32 materialized_id;
        sequence<SISPlanOp> ops;
    };

    // Where a live input's samples come from. Ordinals are the wire encoding.
    @appendable enum SISPlanInputSource {
        SIS_PLAN_INPUT_SOURCE_UNKNOWN,
        SIS_PLAN_INPUT_SOURCE_TRACKER,         // a sensor's pose stream
        SIS_PLAN_INPUT_SOURCE_ENGINE_STREAM,   // another relation stream's output (a derived edge)
        SIS_PLAN_INPUT_SOURCE_UNBOUND          // no adopted topic feeds this input right now
    };

    // Everything the engine's ingest knows about one live input: what to
    // subscribe to, how to read it, and how to correct its stamps.
    @appendable struct SISPlanInput {
        string topic;                   // the key the samples arrive on; "" when unbound
        string schema;                  // the declared payload type, e.g.
                                        //   "tcnart_msgs::msg::Pose6DMessage"
        tcn_types::msg::CoordinateSystem device_coord;   // the publisher's convention;
                                        //   ingest swaps each pose into the engine's
        // Which entry of a multi-entry payload to read (SREdge.entry_id).
        // Present means "this entry, 0 included"; absent means any entry
        // naming the edge's target.
        @optional uint32 entry_id;
        int64 sensor_latency_ns;        // subtracted from every stamp (override, else
                                        //   declared, else 0)
        @optional double frame_rate;    // declared Hz; absent when none is declared
        tcn_types::msg::ClockDomain clock_domain;   // the input's; `id` "" = the deployment clock
        SISPlanInputSource source;
        // The edge this input feeds: one buffer per edge, not per topic. Its
        // LOCAL endpoint's owner is the declaring fragment.
        sqe_msgs::msg::SRRelationRef edge;
    };

    // One hop of a route, in path order from the observer to the target.
    // The provenance a plan's ops were built from, and what explain is for.
    @appendable struct SISPlanHop {
        uint32 instance;                // index into SISTranslationPlan.instances
        sqe_msgs::msg::SRRelationRef edge;   // the edge as declared (source -> target)
        sqe_msgs::msg::SREdgeKind kind;
        sqe_msgs::msg::SREdgeTiming timing;
        boolean derived;                // another stream's output, published as an edge
        boolean walked_inverted;        // declared target -> source, walked source -> target
        double weight;                  // the pathfinder's cost for this hop
        sequence<sqe_msgs::msg::SRRelationRef> derived_from;   // a derived hop: the edges it composes
        @optional uint32 input;         // a live hop: index into inputs; absent for a fixed one
        @optional tcn_types::msg::SRCovariance6 covariance;   // a fixed hop's stated covariance;
                                                              //   absent = not stated
    };

    // The route a stream is on (#35 S6). Which stream it belongs to and the
    // engine's epoch travel on the carrier (SISRelationStreamReply,
    // SISPlanNotification, SISExplainReply), not in the plan.
    @appendable struct SISTranslationPlan {
        // The stream's route_epoch; absent for a dry run (an explain of a
        // relation, a sample). Restarts at 0 when the engine does, so plans
        // are ordered by (engine_epoch, route_epoch).
        @optional uint64 route_epoch;
        tcn_types::msg::CoordinateSystem target_coord;   // the output convention
        sequence<SISPlanInstance> instances;
        sequence<SISPlanInput> inputs;  // indexed by SISPlanDynamicOp.input
        @optional uint32 reference_input;   // the input an ON_REFERENCE trigger fires on
        sequence<sqe_msgs::msg::SRRelationRef> correlated_via;   // edges two hops share: the
                                        //   propagated covariance is optimistic (too tight)
        tcn_types::msg::ClockDomain clock_domain;   // the inputs' common domain
        double path_weight;             // the route's summed weight
        sequence<SISPlanHop> hops;
        sequence<string> route_notes;   // why this route, in words; not for parsing
    };

    // --- replies and notifications ------------------------------------------

    // The topics of one running stream (#35 H1, H2). Read every topic from
    // here; never compose one. `handle` is opaque: it is what a stop names,
    // and nothing about its shape is a promise (the engine may keep it equal
    // to `data_topic`).
    @appendable struct SISStreamHandle {
        string handle;
        string data_topic;              // SISRelationOutput, one per evaluation
        string status_topic;            // SISRelationStreamStatusNotification; a get answers the last
        string plan_topic;              // SISPlanNotification (LOCAL and BOTH); a get answers the last
    };

    // The answer to SISRelationStreamStartRequest and SISRelationStreamStopRequest.
    //
    // `relation.state`, by `header.status`:
    //   start, OK       ACTIVE or PENDING (with `park_reason`)
    //   stop, OK        INACTIVE
    //   not OK          UNKNOWN, as SISRelationStatus states for every reply
    //                   (REJECTED + NO_PATH, UNKNOWN_FRAME, CONFLICT +
    //                   TERMS_CONFLICT, NOT_FOUND for a stop of an unknown
    //                   handle, ...); `header.detail` is the same text the
    //                   engine logs for it
    //
    // `handle` is present exactly when `header.status` is OK and
    // `relation.state` is ACTIVE or PENDING -- the two states that mean "there
    // is a stream on these topics for you". A stop and every refusal carry no
    // handle.
    //
    // `relation` is on the reply as well as on the status topic because a
    // client told PENDING should learn why in the same answer: the notification
    // carrying the same list may have been published before the client
    // subscribed.
    //
    // `plan` is present when the stream was started LOCAL or BOTH and has a
    // route; later plans arrive on `handle.plan_topic`.
    @appendable struct SISRelationStreamReply {
        SISReplyHeader header;
        @optional SISStreamHandle handle;
        SISRelationStatus relation;
        @optional SISTranslationPlan plan;
    };

    // Published on the stream's `status_topic` when its state, its
    // `blocked_by` list or its route changes. A consumer otherwise cannot tell
    // "the engine says there is no path" from "the engine died", and only the
    // first is recoverable by waiting.
    //
    // A running stream that loses its route goes PENDING + WITHDRAWN (or
    // PENDING + CLOCK_DOMAIN_MISMATCH); `header.status` stays OK.
    //
    // **A route change republishes ACTIVE** for a stream that was already
    // active, with an incremented `route_epoch`. A different route is a
    // different composition of a different set of measurements, so the poses
    // step at the switch; a consumer detects a re-route by `route_epoch`
    // changing, not by the state.
    @appendable struct SISRelationStreamStatusNotification {
        SISReplyHeader header;
        string handle;
        uint64 sequence_number;         // per status topic: from 1, gapless per handle
        // Bumped whenever this stream's compiled route changes. Per stream,
        // monotonically increasing, starting at 0 on the first successful
        // compile; absent while the stream has never compiled (a PENDING
        // stream that never had a route). Resets with the engine (order by
        // header.engine_epoch first), as SISTranslationPlan.route_epoch.
        @optional uint64 route_epoch;
        SISRelationStatus relation;
    };

    // Published on the stream's `plan_topic` on every route change of a LOCAL
    // or BOTH stream (#35 R6); a get there answers the last one.
    @appendable struct SISPlanNotification {
        SISReplyHeader header;
        string handle;
        uint64 sequence_number;         // per plan topic: from 1, gapless per handle
        SISTranslationPlan plan;
    };

    // What a stream publishes on its `data_topic`, one per evaluation (#35 H3).
    // Replaces 0.10's bare TargetTrackingMessage with a 13-byte Zenoh
    // attachment: the epochs are now in the payload, and `targets` is a whole
    // TargetTrackingMessage, decoded by the same code as a tracker's.
    @appendable struct SISRelationOutput {
        uint64 engine_epoch;            // the engine's alive key {epoch}
        uint64 route_epoch;             // always set: an output is published only after a route compiled
        uint64 sequence_number;         // per data topic: from 1, gapless per handle
        tcn_types::msg::ClockDomain clock_domain;   // the route's; the targets' stamps are in it
        // Covariance completeness of the route, once per message (#35 E6):
        // `covariance_hops` of `total_hops` hops stated a covariance. Below
        // `total_hops`, the targets' covariances are lower bounds.
        uint32 total_hops;
        uint32 covariance_hops;
        // One target per instance that resolved (target_id = materialized id;
        // 0 for a plain relation). An instance with a hole is absent.
        tcnart_msgs::msg::TargetTrackingMessage targets;
    };

  };
};

#endif
