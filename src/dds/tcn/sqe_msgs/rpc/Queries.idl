// The Spatial Information Service.
//
// These are thin RPC envelopes over the spatial relationship graph defined in
// sqe_msgs/msg/Graph.idl and Transforms.idl. The graph is the model; nothing here
// re-describes it.

#ifndef SQE_MSGS_RPC_QUERIES_IDL
#define SQE_MSGS_RPC_QUERIES_IDL

#include "sqe_msgs/msg/Graph.idl"
#include "tcn_types/msg/Frames.idl"
#include "sqe_msgs/msg/Transforms.idl"
#include "sqe_msgs/rpc/Reply.idl"
#include "sqe_msgs/rpc/Streams.idl"

module sqe_msgs {
  module rpc {

    // --- reading the graph -------------------------------------------------

    // What a read may ask for.
    //
    // Every kind is bounded by something the asker already knows the size of.
    // There is no kind meaning "the whole graph", and that is the point rather
    // than an omission: the engine holds no in-memory graph, and the connected
    // region around any seed is the transitive closure over every relation,
    // which in a fused deployment is the entire fleet. A read of it is
    // unbounded however small the reply that comes back is shaped.
    @appendable enum SISGraphQueryKind {
        SIS_GRAPH_QUERY_KIND_UNKNOWN,
        SIS_GRAPH_QUERY_KIND_FRAGMENT,        // everything one client declared. Bounded by
                                //   that fragment's own size
        SIS_GRAPH_QUERY_KIND_NEIGHBOURS,      // one node and its incident relations. Bounded
                                //   by that node's degree
        SIS_GRAPH_QUERY_KIND_SEARCH,          // a filter within one of the two anchors above.
                                //   See SISGraphFilter
        SIS_GRAPH_QUERY_KIND_PATH             // B64: the relations connecting two frames.
                                //   Was reserved-and-refused, on the grounds
                                //   that a path read has to answer *which*
                                //   predicate it walked and a plain traversal
                                //   answers none of them. Resolved rather than
                                //   dropped: the REQUEST now names the
                                //   predicate (`predicate`, below), so the
                                //   answer is to one question, and the walk is
                                //   bounded by `radius` rather than being the
                                //   whole-graph read this service refuses
    };

    // B64. Which rule a path read walks by. A path is only meaningful with
    // respect to one of these, and a caller comparing a path against what a
    // relation stream did needs to ask for the same one.
    //
    // These mirror the engine's own predicates exactly -- there is no fourth,
    // looser rule reachable from here.
    @appendable enum SISPathPredicate {
        SIS_PATH_PREDICATE_UNKNOWN,
        SIS_PATH_PREDICATE_WALKABLE,        // the usual choice: refuses uncalibrated relations,
                                //   which is what a running stream composes by
        SIS_PATH_PREDICATE_CONNECTABLE,     // the relaxed shape rule a PENDING stream is
                                //   probed with: is there a route at all, once
                                //   the missing measurements arrive?
        SIS_PATH_PREDICATE_WALKABLE_STATIC  // walkable, and refusing anything that moves.
                                //   What a calibration asks when it needs a
                                //   relation to hold still
    };

    // Which anchor a SEARCH is bounded by (#35 G3). The anchor is mandatory: a SEARCH has no "everywhere".
    @appendable enum SISGraphAnchorKind {
        SIS_GRAPH_ANCHOR_KIND_UNKNOWN,
        SIS_GRAPH_ANCHOR_KIND_FRAGMENT,     // everything one fragment declared
        SIS_GRAPH_ANCHOR_KIND_NODE          // one node and its incident edges
    };

    @appendable union SISGraphAnchor switch (SISGraphAnchorKind) {
        case SIS_GRAPH_ANCHOR_KIND_FRAGMENT: string fragment;
        case SIS_GRAPH_ANCHOR_KIND_NODE: tcn_types::msg::SRFrameRef node;
    };

    // The filter of a SEARCH (#35 G3). Optional, ANDed, and applied to the anchored set -- never to the graph. An
    // empty sequence or an absent member means *unfiltered* for that field, so a SEARCH with an anchor and no
    // filter is "everything in this scope", which is the FRAGMENT or NEIGHBOURS read.
    //
    // The anchor is mandatory and has no default. An unanchored search IS the whole-graph read this service
    // refuses, and a default that widens to the graph is how one arrives without anyone deciding to add it. None
    // of the properties filtered on is indexed, so every filter is a post-filter over an already-loaded set. The
    // search anchor is one hop.
    //
    // Deliberately absent, each for a stated reason: no regex, glob, substring or name prefix (unbounded, and a
    // glob is one `*` away from the unanchored search); no top-level negation ("every edge that is NOT
    // calibrated" reads as a filter and behaves as a scan; negation *inside* `timing` is fine, the set is finite);
    // no sort key (it materialises the whole candidate set before the first page); no cross-fragment aggregation
    // (the operator's question, not a client's).
    @appendable struct SISGraphFilter {

        // Which edge timings to keep, as a set. Empty keeps all of them. The reason search exists:
        // { STATIC_UNCALIBRATED } is the work queue an external calibration tool reads.
        sequence<sqe_msgs::msg::SREdgeTiming> timing;

        // Which edge kinds to keep, as a set. Empty keeps all of them.
        sequence<sqe_msgs::msg::SREdgeKind> edge_kind;

        // Keep only edges (nodes) that are, or are not, materialized (#35 N8). Absent keeps both.
        @optional boolean materialized;

        // Keep only edges that are, or are not, engine-derived. Absent keeps both.
        @optional boolean derived;

        // Keep nodes materialized from this kind of marker / in this marker system / unique in this marker domain.
        // Absent keeps all of them.
        @optional tcn_types::msg::MarkerType marker_type;
        @optional string marker_system;
        @optional string marker_domain;
    };

    @appendable struct SISGraphSearch {
        SISGraphAnchor anchor;
        SISGraphFilter filter;
    };

    // PATH (B64): the relations connecting two frames, walked by one stated predicate and bounded by `radius`.
    @appendable struct SISGraphPath {
        tcn_types::msg::SRFrameRef from;        // the observer
        tcn_types::msg::SRFrameRef to;          // the target

        // Which rule to walk by. A path read that does not say which predicate it used produces an answer that
        // disagrees with a stream start using the other one, and the disagreement reads as an engine bug.
        SISPathPredicate predicate;

        // Hops from either named frame that the walk may consider. 0 asks for the engine's default; the engine's
        // own cap is a ceiling this may only lower. A path read within a stated radius is bounded before it
        // starts, and the reply says whether the radius stopped it.
        uint32 radius;
    };

    // What to read (#35 G3). One union and one key for all four kinds, so the item cap and the minimum interval
    // are ONE shared budget: four keys would be four rate-limit buckets per client, and a client respecting each
    // limit individually could still poll at four times the intended rate. Only the member of the chosen kind
    // exists; there are no ignored fields.
    @appendable union SISGraphQuery switch (SISGraphQueryKind) {
        case SIS_GRAPH_QUERY_KIND_FRAGMENT: string fragment;                    // whose fragment
        case SIS_GRAPH_QUERY_KIND_NEIGHBOURS: tcn_types::msg::SRFrameRef node;  // the node
        case SIS_GRAPH_QUERY_KIND_SEARCH: SISGraphSearch search;
        case SIS_GRAPH_QUERY_KIND_PATH: SISGraphPath path;
    };

    @appendable struct SISGraphQueryRequest {
        SISGraphQuery query;

        // Opaque; empty on a first page, otherwise the `next_cursor` of the page before. A cursor and not an
        // offset: the graph mutates under a paginated read and no transaction is held across pages. A client that
        // parses one has broken the contract. A reply is bounded by the engine's own item and byte caps; a client
        // cannot lower or raise them.
        string cursor;
    };

    // One fragment as the operator and a FRAGMENT read describe it (#35 F-D3; moved here from Operator.idl so a
    // FRAGMENT read can carry it).
    @appendable struct SISFragmentSummary {
        string fragment;           // the fragment id (the client id it joined under)
        string origin;             // its origin node
        boolean joined;            // the client holds its liveliness token now; a stored fragment of a departed
                                   //   client is still served until it is collected
        int64 last_updated_ms;     // last accepted write or heartbeat
        uint32 node_count;
        uint32 edge_count;         // edges the fragment declares
        string display_name;       // free text; may be empty
        string description;        // free text; may be empty
    };

    // `header.status`: OK (a search matching nothing is OK with empty sequences: "no uncalibrated edges" is the
    // SUCCESS of a calibration sweep), UNKNOWN_CLIENT (the named fragment does not exist), UNKNOWN_FRAME (an
    // anchored node does not exist), TRUNCATED (a page came back and `next_cursor` is present), REJECTED
    // (MALFORMED, an unanchored SEARCH), NOT_IN_SCOPE (a fragment outside the client scope; reason UNKNOWN) or UNAVAILABLE
    // (LIMIT_EXCEEDED for the per-client rate limit, STORE_UNAVAILABLE for a failed read).
    //
    // Nodes and edges rather than an SRGraph: an SRGraph names one owning client and one origin, and a reply may
    // span fragments and has no origin at all. The two sequences are also independently paged.
    @appendable struct SISGraphQueryReply {
        SISReplyHeader header;
        sequence<sqe_msgs::msg::SRNodeView> nodes;
        sequence<sqe_msgs::msg::SREdgeView> edges;

        // Absent when the reply is complete. Pass it back verbatim in `SISGraphQueryRequest.cursor` for the next
        // page, with the query unchanged.
        @optional string next_cursor;

        // PATH only. The relations connecting `from` to `to` under the predicate, in walk order. Empty when there
        // is no such path -- an OK answer, not a rejection. `nodes` and `edges` carry the same path as views.
        sequence<sqe_msgs::msg::SRRelationRef> path;

        // PATH only. True when the walk stopped at `radius` with the target still unreached -- so an empty `path`
        // means "not within the radius you asked for" rather than "not connected".
        boolean radius_exhausted;

        // FRAGMENT only: the fragment's summary. Absent for every other kind.
        @optional SISFragmentSummary fragment;
    };

    // ======================================================================
    // B63: pattern query -- "how could this edge be produced?"
    // ======================================================================
    //
    // Sent to {client_id}/sis/pattern/query.
    //
    // A NEW KEY, and not a fifth SISGraphQueryKind. The request above argues
    // for one key on the grounds that four keys mean four rate-limit buckets,
    // and that argument is respected rather than overturned: this key shares
    // the graph read's bucket, because it is the same cost against the same
    // database. What it does not share is the reply SHAPE -- a pattern
    // instance is bound roles, bound path segments, an expansion kind and a
    // measurement count, none of which belongs in a reply otherwise made of
    // nodes and edges.
    //
    // The model is Pustka, Huber, Bauer & Klinker, "Spatial Relationship
    // Patterns": a pattern is a small graph over roles, some edges inputs
    // that must exist and some outputs its algorithm produces, applied only
    // in an EXPANDED form -- several instances at one instant, or one
    // instance over several instants.

    // How a pattern was expanded to fit the graph. A pattern is never applied
    // unexpanded, so there is no third value meaning "as declared".
    @appendable enum SRPatternExpansion {
        SR_PATTERN_EXPANSION_UNKNOWN,
        SR_PATTERN_EXPANSION_SPACE,           // several instances at one instant: three
                                //   markers on a rigid body, seen together
        SR_PATTERN_EXPANSION_TIME             // one instance at several instants: one marker
                                //   moved through the volume. Preferred where
                                //   both are possible -- integrating over time
                                //   is more accurate than one snapshot
    };

    // One role of the pattern, bound to a real frame.
    @appendable struct SISPatternRole {
        string role;            // the pattern's own name for it: "camera"
        tcn_types::msg::SRFrameRef frame;      // what it was bound to
    };

    // One hop of a bound input.
    //
    // Self-contained on purpose: everything needed to subscribe to this hop
    // and to place it in a pipeline, so a caller never has to ask again. A
    // calibration tool composes these itself rather than asking the engine for
    // a relation stream, because a correspondence relates k measurements at
    // ONE instant and two streams have two independent triggers.
    @appendable struct SISPatternSegment {
        sqe_msgs::msg::SRRelationRef edge;      // the relation, by endpoints and declared name
        boolean dynamic;
        @optional string stream_topic;          // present exactly when dynamic

        // The one entry of the stream topic this hop reads (#35 E4). Absent when the hop is unbound and reads every
        // entry. Entry 0 is a real entry, so absent and 0 are different: a caller routing entries itself must
        // route on presence, and treating unbound as "entry 0" drops every other entry on a multi-entry topic.
        @optional uint32 entry_id;

        // The static value, or a seed. Absent when no value is known; absent is never the identity.
        @optional sqe_msgs::msg::SRTransform transform;
        boolean computed;               // derived from other edges rather than
                                        //   measured. Usable, and ranked below
                                        //   a raw hop: a computed value was
                                        //   already interpolated once, at its
                                        //   own producer's instants

        // --- B68 -----------------------------------------------------------
        // What a subscriber needs to read this hop the way the engine reads it, and cannot obtain for itself: a
        // descriptor is published ONCE, and a consumer that joins later never sees one.
        //
        // sensor_latency_ns: nanoseconds between the measurement and the header stamp. A sample stamped T was
        // measured at T - latency, and the engine subtracts it on ingest. Absent means unstated.
        //
        // frame_rate: this hop's declared rate in Hz; absent when unstated. Rolled up per input into
        // SISPatternInput::frame_rate, which is what a session picks its reference input by.
        @optional int64 sensor_latency_ns;
        @optional double frame_rate;
    };

    // One input of the pattern, bound to a concrete realisation.
    @appendable struct SISPatternInput {
        // The relations realising this input, in order. One entry is a single
        // declared edge; more is a composed path, and composing it is the
        // caller's -- which is what the basic inversion and concatenation
        // patterns are, applied implicitly.
        sequence<SISPatternSegment> segments;

        tcn_types::msg::SRFrameRef observer;
        tcn_types::msg::SRFrameRef target;

        // Slowest declared rate along this input's path, in Hz; absent when no hop
        // declares one.
        //
        // What a session picks its REFERENCE INPUT by. A correspondence spans
        // several inputs and needs one instant; the reference supplies it and
        // the others are interpolated to it. The slowest is the safe default:
        // interpolating a 200 Hz stream to 30 Hz instants spans at most 5 ms,
        // while the reverse spans up to 33 ms, and interpolating toward the
        // sparser signal is always the larger invention.
        @optional double frame_rate;
    };

    // --- B67 ---------------------------------------------------------------
    // One duplicate's realisation of one input, in a space expansion.
    //
    // A space expansion IS its duplicates. Absolute orientation over three
    // surveyed landmarks is three correspondences at one instant, one per
    // landmark, and a consumer needs a pipeline per landmark per input to
    // evaluate them.
    //
    // 0.6.0 carried the duplicated ROLES and nothing else, which the matcher
    // had already resolved to paths and then discarded. A consumer could
    // compile only the base binding, so a session over three landmarks would
    // have been a calibration from one of them -- determined, plausible, and
    // wrong. A tool that noticed refused the candidate outright, which is
    // correct and is not what anyone wants.
    //
    // FLAT, AND TAGGED BY DUPLICATE, rather than a sequence of inputs nested
    // inside a sequence of duplicates. Two reasons, and the second is a hard
    // one:
    //
    //  - it keeps space_instances meaning what it meant, so this is an
    //    APPEND rather than a change in the middle of SISPatternInstance;
    //  - a fourth level of nested unbounded sequences (reply -> instances ->
    //    duplicates -> inputs -> segments) overflows the uint32 the IDL
    //    generator computes a worst-case CDR size into. That is not a style
    //    preference; the generated code does not compile.
    @appendable struct SISPatternExpansionInput {
        // Which duplicate this input belongs to: an index into
        // SISPatternInstance::space_instances.
        //
        // One index and not a set of role bindings, because exactly one role
        // of a pattern is expandable -- a matcher that met two would have to
        // pair their duplicates, and no catalogue entry asks for that. So each
        // entry of space_instances IS one duplicate, and indexing it is
        // unambiguous.
        uint32 instance;

        // Which of the pattern's inputs this realises: an index into
        // SISPatternInstance::inputs. Only the correspondence inputs appear
        // here; the others are shared across every duplicate and are already
        // bound once on the instance.
        uint32 input;

        // This duplicate's own path for that input.
        SISPatternInput binding;
    };

    @appendable struct SISPatternInstance {
        string pattern;                 // catalogue name: "hand_eye"
        string method;                  // the estimator this needs
        sequence<SISPatternRole> roles;
        sequence<SISPatternInput> inputs;

        SRPatternExpansion expansion;

        // For SR_PATTERN_EXPANSION_SPACE: the duplicates FOUND in the graph, one entry per
        // duplicate, each naming its own binding of the expandable role. Empty
        // for SR_PATTERN_EXPANSION_TIME, where the edges are the same on every measurement.
        //
        // Found, not assumed: three point correspondences for absolute
        // orientation are three nodes each observed by both frames, and a
        // graph holding one marker supports no space expansion however often
        // it is asked.
        //
        // These NAME the duplicates; space_inputs below is what makes them
        // runnable. Both are required for a space expansion and a reply
        // carrying only the first is one a consumer must refuse (B67).
        sequence<SISPatternRole> space_instances;

        uint32 min_measurements;        // what the estimator needs

        // The engine's own ordering, ascending, best first: computed hops
        // dominate, then hop count, then any stated covariance.
        //
        // AN OPINION, NOT AN AUTHORITY. Which of several solutions is best is
        // left open by the paper this implements, and is left open here.
        double cost;

        // --- B67 -----------------------------------------------------------
        // Every duplicate's own path for every correspondence input, tagged by
        // which duplicate and which input it realises.
        //
        // Empty for SR_PATTERN_EXPANSION_TIME. For SR_PATTERN_EXPANSION_SPACE this is what makes the
        // expansion runnable: space_instances names the duplicates and this
        // says how to evaluate each one. A consumer that finds space_instances
        // non-empty and this empty is talking to a pre-0.7.0 engine and should
        // refuse the candidate rather than estimate from the base binding
        // alone -- see SISPatternExpansionInput.
        sequence<SISPatternExpansionInput> space_inputs;
    };

    @appendable struct SISPatternQueryRequest {

        // The edge to be produced. Both frames must exist; the edge need not,
        // and normally does not -- that is the point.
        tcn_types::msg::SRFrameRef from;
        tcn_types::msg::SRFrameRef to;

        // What kind of relation is wanted. Patterns are matched against their
        // OUTPUTS: a caller does not choose a method, it states a result, and
        // the methods that produce that result are what come back.
        sqe_msgs::msg::SRTransformType wanted;

        // Hops from either named frame. 0 asks for the engine's default.
        uint32 radius;
    };

    @appendable struct SISPatternQueryReply {
        // The refusals are the graph read's: rate limited, unknown frame, malformed request.
        SISReplyHeader header;

        // Ordered best-first by SISPatternInstance.cost. EMPTY IS AN ANSWER,
        // and an OK one: "nothing in this graph produces that edge" is
        // what an under-instrumented setup looks like, and it is the reply
        // that tells an operator to add a landmark or a marker rather than to
        // retry.
        sequence<SISPatternInstance> instances;
    };

  };
};

#endif
