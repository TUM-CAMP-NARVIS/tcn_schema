#ifndef PCPD_MSGS_RPC_PARAMETERS_IDL
#define PCPD_MSGS_RPC_PARAMETERS_IDL

module pcpd_msgs {
  module rpc {

    struct ParameterList;
    struct Parameter;
    union ParameterValue;

    @appendable enum RPCResponseStatus {
      RPC_RESPONSE_STATUS_UNKNOWN,
      RPC_RESPONSE_STATUS_SUCCESS,
      RPC_RESPONSE_STATUS_ERROR
    };

    // null
    @appendable struct NullRequest {
        uint8 dummy;
    };

    @appendable struct NullReply {
        RPCResponseStatus status;
    };

    @appendable struct BoolReply {
        boolean value;
        RPCResponseStatus status;
    };

    @appendable struct StringListRequest {
      sequence<string> values;
    };

    @appendable struct StringListReply {
      sequence<string> values;
      RPCResponseStatus status;
    };

    // Generic Parameter Interface
    @appendable enum ParameterValueType {
      PARAMETER_VALUE_TYPE_UNKNOWN,
      PARAMETER_VALUE_TYPE_STRING,
      PARAMETER_VALUE_TYPE_INT32,
      PARAMETER_VALUE_TYPE_INT64,
      PARAMETER_VALUE_TYPE_FLOAT,
      PARAMETER_VALUE_TYPE_DOUBLE,
      PARAMETER_VALUE_TYPE_BOOL,
      PARAMETER_VALUE_TYPE_STRUCT,
      // 0.9.0, appended: the ordinals above are unchanged.
      PARAMETER_VALUE_TYPE_UINT32,
      PARAMETER_VALUE_TYPE_UINT64
    };

    @appendable struct ParameterList {
        sequence<Parameter> parameters;
    };

    @appendable struct Parameter {
        string key;
        ParameterValue value;
    };

    @appendable union ParameterValue switch(ParameterValueType) {
    case PARAMETER_VALUE_TYPE_STRING:
        string string_value;
    case PARAMETER_VALUE_TYPE_INT32:
        int32 int32_value;
    case PARAMETER_VALUE_TYPE_INT64:
        int64 int64_value;
    case PARAMETER_VALUE_TYPE_FLOAT:
        float float_value;
    case PARAMETER_VALUE_TYPE_DOUBLE:
        double double_value;
    case PARAMETER_VALUE_TYPE_BOOL:
        boolean bool_value;
    case PARAMETER_VALUE_TYPE_STRUCT:
        ParameterList struct_value;
    // 0.9.0, appended.
    case PARAMETER_VALUE_TYPE_UINT32:
        uint32 uint32_value;
    case PARAMETER_VALUE_TYPE_UINT64:
        uint64 uint64_value;
    };

    @appendable struct ParameterSchema {
        string key;
        ParameterValueType value_type;
        sequence<ParameterValue> valid_entries;
    };

    @appendable struct ParameterListSchema {
        sequence<ParameterSchema> parameters;
    };

    // generic
    @appendable struct GenericParameterRequest {
        ParameterList value;
    };

    @appendable struct GenericParameterReply {
        ParameterList value;
        RPCResponseStatus status;
    };

    // ------------------------------------------------------------------
    // 0.9.0: parameter-protocol extensions. All additive; nothing above
    // changed position. See MIGRATION-0.9.0.md for the verbs and the
    // canonical JSON mapping.
    // ------------------------------------------------------------------

    // A1. Rich parameter descriptor, served by `parameters/describe`
    // (request: StringListRequest of keys, empty = all).

    /// How a parameter can be changed.
    @appendable enum ParameterAccess {
      PARAMETER_ACCESS_UNKNOWN,
      PARAMETER_ACCESS_READ_WRITE_LIVE,      // set takes effect while running (next compute / next frame)
      PARAMETER_ACCESS_READ_WRITE_RESTART,   // set accepted, applies after a restart / recompile
      PARAMETER_ACCESS_READ_ONLY             // get only
    };

    /// One allowed enum value: the label as shown and sent (PARAMETER_VALUE_TYPE_STRING),
    /// and the underlying integer value.
    @appendable struct EnumEntry {
        string label;
        int64 value;
    };

    /// Full description of one parameter. ParameterSchema stays as the
    /// compact form.
    ///
    /// minimum / maximum / step are optional. `@optional` is not used: with
    /// fast-cdr 2.0.0 and the DDS_CDR (XCDR1) encoding every peer uses, an
    /// optional member does not round-trip. Each is a plain member with a
    /// `has_*` flag before it; when the flag is false the value is
    /// meaningless (default-constructed) and must be ignored.
    @appendable struct ParameterDescriptor {
        string key;
        ParameterValueType value_type;
        ParameterAccess access;
        string description;                 // one line, may be empty
        string unit;                        // SI or display unit ("m", "ms", "px", ""), may be empty
        boolean has_minimum;
        ParameterValue minimum;             // inclusive; same type as value_type
        boolean has_maximum;
        ParameterValue maximum;             // inclusive
        boolean has_step;
        ParameterValue step;                // UI hint; absent = continuous
        sequence<EnumEntry> enum_entries;   // non-empty for enums (value_type PARAMETER_VALUE_TYPE_STRING)
        sequence<ParameterValue> valid_entries;  // other discrete sets (0.8.0 parity)
        ParameterValue default_value;
        uint64 generation;                  // server-side change counter of the current value
    };

    @appendable struct ParameterDescriptorList {
        sequence<ParameterDescriptor> parameters;
    };

    @appendable struct ParameterDescriptorReply {
        ParameterDescriptorList value;
        RPCResponseStatus status;
    };

    // A3. Per-key set results, served by `parameters/set_ex`
    // (request: GenericParameterRequest). `parameters/set` (NullReply) stays.

    @appendable enum ParameterSetStatus {
      PARAMETER_SET_STATUS_UNKNOWN,
      PARAMETER_SET_STATUS_APPLIED,          // in effect
      PARAMETER_SET_STATUS_UNCHANGED,        // equal to the current value
      PARAMETER_SET_STATUS_PENDING,          // accepted, not yet in effect within the server's wait
      PARAMETER_SET_STATUS_OUT_OF_RANGE,
      PARAMETER_SET_STATUS_TYPE_MISMATCH,
      PARAMETER_SET_STATUS_UNKNOWN_KEY,
      PARAMETER_SET_STATUS_READ_ONLY,
      PARAMETER_SET_STATUS_REJECTED          // other; see message
    };

    @appendable struct ParameterSetResult {
        string key;
        ParameterSetStatus status;
        string message;
    };

    @appendable struct ParameterSetReply {
        sequence<ParameterSetResult> results;
        RPCResponseStatus status;   // SUCCESS only if every key is APPLIED or UNCHANGED
    };

    // A4. Change notification, published on
    // `<prefix>/str/service/<name>/parameters` whenever a value takes effect.

    @appendable struct ParameterChanged {
        string service;
        ParameterList value;   // keys that changed, with their new values
        uint64 generation;
    };

  };
};

#endif
