#ifndef PCPD_MSGS_MSG_MESHBITSTREAM_IDL
#define PCPD_MSGS_MSG_MESHBITSTREAM_IDL

#include "std_msgs/msg/Header.idl"
#include "tcn_types/msg/Geometry.idl"

module pcpd_msgs {
  module msg {

    @appendable struct MeshBitstreamMessage {

      std_msgs::msg::Header header;

      boolean enable_mesh_indices;
      uint32 num_camera_ids;

      uint64 vertices_capacity;
      uint64 faces_capacity;

      uint64 vertex_size_bytes;

      uint64 num_vertices;
      uint64 num_faces;

      uint64 data_bytes;
      sequence<uint8> data;

    };

  };
};

#endif
