// The shared person stream (0.11 decisions §7 HumanPose; design: docs/proposals/2026-11-27-0.11-humanpose-draft.md).
// Producers: HTA's pose tracker after stabilising (merged from PersonTrackingMessage tracks), tcnart's human_pose
// feature, and tcnart apps that track their own user (TCN_LITE from XR poses, TCN_BODY from IK or vision).
// Consumers: avatars (Unity, Unreal), agents, the web controller.
//
// - HumanPoseMessage: one per capture group, the persons' joints;
// - HumanShapeMessage: latched, re-published on change, the persons' shapes (bone lengths, SMPL betas);
// - PersonStreamInfo: the descriptor's person case, the stream's latched properties.
//
// Joint sets (the order of joints and bones, parents, rest pose and body frame, the rotation convention, the
// retired joint_set strings): the generated table tcnart_msgs/msg/JointSets.md. A consumer refuses an unknown
// (joint_set, joint_set_version) pair.
//
// Positions are metres, right-handed, in the stream's frame (header.frame). Rotations never depend on the up axis.
// One person can come from two producers: consumers de-duplicate by `member`, preferring the self-tracked head and
// hands and the tracked body.

#ifndef TCNART_MSGS_MSG_HUMANPOSE_IDL
#define TCNART_MSGS_MSG_HUMANPOSE_IDL

#include "tcn_types/msg/Geometry.idl"
#include "tcn_types/msg/Stream.idl"
#include "tcnart_msgs/msg/JointSet.idl"

module tcnart_msgs {
  module msg {

    // HumanPose.state: the life cycle of a person.
    // TRACKED: joints from a current observation. COASTING: unmatched, predicted to the group's time for up to
    // PersonStreamInfo.coast_limit_s; re-identification can bring the same `person` back within reid_window_s.
    // LOST: sent once, when the id can no longer come back (after reid_window_s); a person never returns after it.
    @appendable enum PersonState {
      PERSON_STATE_UNKNOWN,
      PERSON_STATE_TRACKED,
      PERSON_STATE_COASTING,
      PERSON_STATE_LOST
    };

    // HumanJoint.source: where a joint's value comes from.
    // OBSERVED: from an observation in this interval. DERIVED: computed from other joints (e.g. TCN_LITE's chest and
    // pelvis, the pelvis as mid-hip). DEFAULTED: no data, a neutral default (e.g. a controller that is not held,
    // with confidence 0).
    @appendable enum JointSource {
      JOINT_SOURCE_UNKNOWN,
      JOINT_SOURCE_OBSERVED,
      JOINT_SOURCE_DERIVED,
      JOINT_SOURCE_DEFAULTED
    };

    // The SMPL family model SmplParams and HumanShape refer to. The schema carries numbers only, no model data.
    @appendable enum SmplModel {
      SMPL_MODEL_UNKNOWN,
      SMPL_MODEL_SMPL,
      SMPL_MODEL_SMPLH,
      SMPL_MODEL_SMPLX
    };

    // HumanShape.smpl_gender: the SMPL model variant the betas belong to.
    @appendable enum SmplGender {
      SMPL_GENDER_UNKNOWN,
      SMPL_GENDER_NEUTRAL,
      SMPL_GENDER_FEMALE,
      SMPL_GENDER_MALE
    };

    // PersonStreamInfo.smoothing: the producer's temporal filter. Its parameters stay in the stream descriptor's
    // properties: with ONE_EURO, `min_cutoff_hz`, `beta`, `d_cutoff_hz` and `bone_tol`.
    @appendable enum PersonSmoothing {
      PERSON_SMOOTHING_UNKNOWN,
      PERSON_SMOOTHING_OFF,
      PERSON_SMOOTHING_ONE_EURO
    };

    // One joint, in the order of the message's joint set.
    // `position`: m, in the stream's frame (header.frame).
    // `confidence`: [0,1].
    // `rotation`: the orientation of the joint's frame in the stream's frame, relative to the joint set's rest pose:
    // the joint's outgoing bones point along rotation * rest_dir (JointSets.md, "Rotations"). Absent: the producer
    // has no rotation for this joint -- never read it as identity. Positions-only sets carry none.
    @appendable struct HumanJoint {
      tcn_types::msg::Vector3 position;
      float confidence;
      JointSource source;
      @optional tcn_types::msg::Quaternion rotation;
    };

    // A person's SMPL pose for one frame; the shape (betas) is in HumanShape.
    // `global_orient`: axis-angle, rad (joint 0). `translation`: m, in the stream's frame.
    // `pose`: SMPL's parent-relative axis-angle (rad) per joint, in the order of the model's joint set (SMPL_24,
    // SMPLH_52 or SMPLX_55) without joint 0. `expression`: SMPL-X only; empty otherwise.
    // A producer that fits SMPL also sends HumanJoint.rotation in its stream's joint set; conversions between
    // parent-relative and rest-pose-relative rotations live in the client libraries, never on the wire.
    @appendable struct SmplParams {
      SmplModel model;
      tcn_types::msg::Vector3 global_orient;
      tcn_types::msg::Vector3 translation;
      sequence<tcn_types::msg::Vector3, 54> pose;
      sequence<float, 100> expression;
    };

    // One person.
    // `person`: stable per producer; never reused within a session.
    // `member`: the session member's client id when the person is that user. HTA's tracker sets it once it links
    // a tracked person to a headset user; a self-tracking tcnart app always sets it. Absent: not linked.
    // `confidence`: [0,1], the person as a whole.
    // `source_ids`: the source tracks merged into this person (PersonTrackingMessage's Person.id), newest first;
    // may be empty.
    // `joints`: one per joint of the message's joint set, in its order.
    // `smpl`: absent unless the producer fits SMPL.
    @appendable struct HumanPose {
      uint32 person;
      @optional string<128> member;
      PersonState state;
      float confidence;
      sequence<uint32, 8> source_ids;
      sequence<HumanJoint, 64> joints;
      @optional SmplParams smpl;
    };

    // The persons of one capture group. Coasting persons are predicted to the group's time: one stamp per message.
    // `header`: capture_time_ns is the capture time of the group in the header's clock (absent: the descriptor's
    // clock domain, e.g. the capture host's clock, the clock of the mesh and camera streams of the same capture);
    // a producer that interpolates poses (tcnart's human_pose) stamps the deployment-clock time of the
    // interpolated pose and states that clock. group_id matches the PersonTrackingMessage group the persons came
    // from. frame: the frame every position, rotation and translation is in (e.g. the domain node of the rig
    // calibration's world).
    // `joint_set`, `joint_set_version`: the order of every person's joints (JointSets.md). They equal the stream
    // descriptor's PersonStreamInfo.joint_set and joint_set_version: one joint set per stream.
    @appendable struct HumanPoseMessage {
      tcn_types::msg::StreamHeader header;
      JointSet joint_set;
      uint16 joint_set_version;
      sequence<HumanPose, 32> persons;
    };

    // One person's shape, keyed by `person` (HumanPose.person).
    // `bone_lengths`: m, one per bone of the joint set's bone list, in its order; NaN for a bone not frozen yet (a
    // track's lengths become valid once it is confirmed). A deliberate per-element marker in a fixed-order sequence,
    // which @optional cannot express (decisions §7 point 4). A set without bones sends none.
    // `smpl_model`, `smpl_gender`: absent without SMPL. `smpl_betas`: empty without SMPL.
    @appendable struct HumanShape {
      uint32 person;
      JointSet joint_set;
      uint16 joint_set_version;
      sequence<float, 64> bone_lengths;
      @optional SmplModel smpl_model;
      @optional SmplGender smpl_gender;
      sequence<float, 300> smpl_betas;
    };

    // The persons' shapes; latched, re-published whenever a shape changes. Same producer, frame and clock as the
    // stream's HumanPoseMessage.
    @appendable struct HumanShapeMessage {
      tcn_types::msg::StreamHeader header;
      sequence<HumanShape, 32> persons;
    };

    // The latched properties of a person stream (PersonTrackingMessage, HumanPoseMessage): the stream descriptor's
    // person case, StreamInfo.persons (#35 S1, #38 A2).
    // `joint_set`, `joint_set_version`: the stream's one joint set; every message of the stream carries exactly
    // this pair in its own joint_set and joint_set_version (and so does every HumanShape of its HumanShapeMessage).
    // `up`: unit vector pointing up, in the stream's frame; it differs per site (HTA: from each site's rig
    // calibration world). Deprecated once the frame states its own axes (#38 A9).
    // `coast_limit_s`: how long an unmatched person is predicted (COASTING / PREDICTED; HTA: max_gap_s, 1.0).
    // `reid_window_s`: after this, LOST is final (HTA: 5.0).
    // `smoothing`: the filter; its parameters stay in the descriptor's properties (PersonSmoothing).
    // The descriptor's header states the stream's frame, clock and rate: `frame`, `clock` (ClockDomain ids of person
    // streams: `capture:<host>` live, the host whose clock stamps the capture, or `recording:<id>` on replay) and
    // `frame_rate`, the rate the stream is published at (one message per capture group; it replaces the 0.10
    // `rate_hz` property). Handedness (right) and units (m) are fixed by this schema and are not sent.
    @appendable struct PersonStreamInfo {
      JointSet joint_set;
      uint16 joint_set_version;
      tcn_types::msg::Vector3 up;
      float coast_limit_s;
      float reid_window_s;
      PersonSmoothing smoothing;
    };

  };
};

#endif
