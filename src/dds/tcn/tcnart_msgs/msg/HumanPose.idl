// The persons tcnart's human_pose authority publishes for avatars (Unity, Unreal): stabilised, merged from source
// tracks (e.g. PersonTrackingMessage) and linked to session participants. Joint sets, units and frames:
// tcnart_msgs/msg/JointSets.md. Proposed by tcnart (roadmap 4.6), new in 0.10.5.

#ifndef TCNART_MSGS_MSG_HUMANPOSE_IDL
#define TCNART_MSGS_MSG_HUMANPOSE_IDL

#include "std_msgs/msg/Header.idl"
#include "tcn_types/msg/Geometry.idl"

module tcnart_msgs {
  module msg {

    // HumanPose.state
    const uint8 HUMAN_POSE_TRACKED  = 0;   // joints from a current observation

    const uint8 HUMAN_POSE_COASTING = 1;   // source lost for < 0.5 s; joints held / predicted

    const uint8 HUMAN_POSE_LOST     = 2;   // last message for this person

    // HumanJoint.flags (bits)
    const uint8 HUMAN_JOINT_OBSERVED     = 1;  // from an observation of the source in this interval

    const uint8 HUMAN_JOINT_DERIVED      = 2;  // computed from other joints (e.g. pelvis = mid-hip)

    const uint8 HUMAN_JOINT_DEFAULTED    = 4;  // no data: a neutral default (e.g. toe forward of the ankle)

    const uint8 HUMAN_JOINT_HAS_ROTATION = 8;  // `rotation` is valid; else identity, ignore

    @appendable struct HumanJoint {
      tcn_types::msg::Vector3 position;        // m, header.frame_id
      tcn_types::msg::Quaternion rotation;     // header.frame_id, relative to the joint set's rest pose
      float confidence;        // [0,1]
      uint8 flags;             // HUMAN_JOINT_* bits
    };

    @appendable struct HumanPose {
      uint32 person;                    // stable id after merging source tracks; never reused within a session
      string<32> participant;           // session user name linked to this person; empty: anonymous
      uint8 state;                      // HUMAN_POSE_*
      sequence<uint32, 8> source_ids;   // the source track ids merged into this person (Person.id), newest first
      sequence<HumanJoint, 32> joints;  // order of joint_set
      sequence<float, 32> bone_lengths; // m, the joint set's bone list; frozen after 2 s of confident observation
    };

    // The persons of one site as tcnart's human_pose authority sees them.
    @appendable struct HumanPoseMessage {
      std_msgs::msg::Header header;     // stamp: deployment clock time of the poses; frame_id: Global SQE node
      string<64> joint_set;             // e.g. "tcnart_body_v1"
      string<64> source;                // the source topic (e.g. holoscan-tcn's persons stream)
      sequence<HumanPose, 16> persons;
    };

  };
};

#endif
