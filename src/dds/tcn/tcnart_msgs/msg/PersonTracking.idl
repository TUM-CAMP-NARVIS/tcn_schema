// The tracker-level output of a multi-camera person tracker (HTA, holoscan-tcn-applications; design 65): the tracks
// of one capture group. HTA's stabiliser and tcnart's human_pose feature turn them into the shared person stream
// (HumanPose.idl), which matches a group by header.group_id. The stream's latched properties (up axis, coasting,
// smoothing and its filter parameters, clock domain, rate) are the descriptor's PersonStreamInfo (HumanPose.idl).
// Joint sets: the generated table tcnart_msgs/msg/JointSets.md.

#ifndef TCNART_MSGS_MSG_PERSONTRACKING_IDL
#define TCNART_MSGS_MSG_PERSONTRACKING_IDL

#include "tcn_types/msg/Geometry.idl"
#include "tcn_types/msg/Stream.idl"
#include "tcnart_msgs/msg/JointSet.idl"

module tcnart_msgs {
  module msg {

    // Person.state: the life cycle of a track. 0.10 sent these as `const uint8 PERSON_STATE_*` 0-2; each value is
    // one higher now, UNKNOWN takes 0 (E6). (PERSON_STATE_* now names HumanPose's PersonState.)
    // TENTATIVE: seen, not yet confirmed. CONFIRMED: observed in enough views over enough frames. PREDICTED: not
    // observed in this frame; the pose is the filter's prediction (for up to PersonStreamInfo.coast_limit_s).
    @appendable enum PersonTrackState {
      PERSON_TRACK_STATE_UNKNOWN,
      PERSON_TRACK_STATE_TENTATIVE,
      PERSON_TRACK_STATE_CONFIRMED,
      PERSON_TRACK_STATE_PREDICTED
    };

    // One skeleton joint, in the order of PersonTrackingMessage.joint_set.
    @appendable struct PersonJoint {
      tcn_types::msg::Vector3 position;     // m, in PersonTrackingMessage.header.frame
      float confidence;     // [0,1]
      boolean observed;     // true: triangulated from at least two views in this frame; false: predicted
      float age_s;          // s since this joint was last observed (0 when observed in this frame)
    };

    // What one camera contributed to a person in this frame.
    @appendable struct PersonCameraView {
      uint8 camera;         // index of the camera, < PersonTrackingMessage.camera_count
      float box[4];         // person bounding box in that camera's image: x_min, y_min, x_max, y_max, pixels
      uint8 joints_used;    // number of joints that camera's detection contributed to the 3D pose
    };

    // One tracked person.
    @appendable struct Person {
      uint32 id;                  // track id, stable while the track lives (never reused within a stream)
      // The id of the track this one continues under a new id (set from the frame the link is made on: the consumer
      // merges the two). Absent: it continues none (0.10 sent 0).
      @optional uint32 previous_id;
      PersonTrackState state;
      boolean ambiguous;          // the assignment of this track was ambiguous in this group (another person close)
      float confidence;           // [0,1]
      double age_s;               // seconds since the track was created
      int64 last_seen_ns;         // capture time (ns, the header's clock) of the last frame the person was observed
      tcn_types::msg::Vector3 root;               // m, in header.frame: the pelvis (mid-hip; halpe26: its hip centre)
      // One per joint of the message's joint_set, in its order (tcnart_msgs/msg/JointSets.md). While the person is
      // PERSON_TRACK_STATE_PREDICTED its joints move with the root (the last observed pose carried along the root's
      // prediction), every joint observed false, age_s the time since that joint was last observed.
      sequence<PersonJoint, 32> joints;
      // m, NaN until the length is frozen (a named exception to the @optional rule, docs/idl-style.md, as
      // HumanShape.bone_lengths); one per bone of the joint set's bone list (tcnart_msgs/msg/JointSets.md).
      sequence<float, 32> bone_lengths;
      sequence<PersonCameraView, 8> views;

    };

    // The persons tracked in one capture group (design 65). XCDR2 with the encapsulation header (00 09), like
    // every tcn type. Positions are metres, right-handed, in header.frame.
    // `header`: capture_time_ns is the capture time of the frame group, in the clock of the mesh and camera streams
    // of the same capture (header.clock, absent: the descriptor's clock domain, e.g. `capture:<host>`);
    // group_id is the producer's frame-group sequence number (was `group`; absent: unknown); frame is the frame all
    // positions are in, the SQE node of the rig calibration's world (was `world_frame`). The up axis (was `up`) is
    // PersonStreamInfo.up.
    // `joint_set`, `joint_set_version`: the joints' and bones' order (was a "coco17" / "halpe26" string;
    // JointSets.md, "Retired names"). They equal the stream descriptor's PersonStreamInfo.joint_set and
    // joint_set_version: one joint set per stream. Only a set with at most 32 joints and 32 bones fits
    // (Person.joints, Person.bone_lengths): COCO17, HALPE26, TCN_LITE, TCN_BODY or SMPL_24, never SMPLX_55 or
    // SMPLH_52 (those travel in HumanPoseMessage; JointSets.md, "Bounds").
    // `camera_count`: number of cameras (<= 8) that fed the group.
    // `camera_reprojection_px`: per camera, the median reprojection residual of the group, pixels.
    @appendable struct PersonTrackingMessage {
      tcn_types::msg::StreamHeader header;
      JointSet joint_set;
      uint16 joint_set_version;
      uint8 camera_count;
      sequence<Person, 16> persons;
      sequence<float, 8> camera_reprojection_px;
    };

  };
};

#endif
