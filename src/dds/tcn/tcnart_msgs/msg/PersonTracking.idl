#ifndef TCNART_MSGS_MSG_PERSONTRACKING_IDL
#define TCNART_MSGS_MSG_PERSONTRACKING_IDL

#include "std_msgs/msg/Header.idl"
#include "tcn_types/msg/Geometry.idl"

module tcnart_msgs {
  module msg {

    // Person.state: the life cycle of a track.
    const uint8 PERSON_STATE_TENTATIVE = 0;   // seen, not yet confirmed

    const uint8 PERSON_STATE_CONFIRMED = 1;   // observed in enough views over enough frames

    const uint8 PERSON_STATE_PREDICTED = 2;   // not observed in this frame; the pose is the filter's prediction

    // One skeleton joint, in the order of PersonTrackingMessage.joint_set.
    struct PersonJoint {
      tcn_types::msg::Vector3 position;     // m, in PersonTrackingMessage.world_frame
      float confidence;     // [0,1]
      boolean observed;     // true: triangulated from at least two views in this frame; false: predicted
      float age_s;          // s since this joint was last observed (0 when observed in this frame)
    };

    // What one camera contributed to a person in this frame.
    struct PersonCameraView {
      uint8 camera;         // index of the camera, < PersonTrackingMessage.camera_count
      float box[4];         // person bounding box in that camera's image: x_min, y_min, x_max, y_max, pixels
      uint8 joints_used;    // number of joints that camera's detection contributed to the 3D pose
    };

    // One tracked person.
    struct Person {
      uint32 id;                  // track id, stable while the track lives (never reused within a stream)
      uint32 previous_id;         // 0: none; the id of the track this one continues (set from the frame the link is
                                  // made on: the consumer merges the two)
      uint8 state;                // PERSON_STATE_*
      boolean ambiguous;          // the assignment of this track was ambiguous in this group (another person close)
      float confidence;           // [0,1]
      double age_s;               // seconds since the track was created
      int64 last_seen_ns;         // capture time (ns, the header's clock) of the last frame the person was observed
      tcn_types::msg::Vector3 root;               // m, in world_frame: the pelvis (mid-hip; halpe26: its hip centre)
      // One per joint of the message's joint_set, in its order (tcnart_msgs/msg/JointSets.md). While the person is
      // PERSON_STATE_PREDICTED every joint moves with the root, observed false, age_s growing.
      sequence<PersonJoint, 32> joints;
      // m, NaN until the length is frozen; one per bone of the joint set's bone list (tcnart_msgs/msg/JointSets.md).
      sequence<float, 32> bone_lengths;
      sequence<PersonCameraView, 8> views;

      // The role the person plays (e.g. surgeon, nurse): an id from the application's role table and the
      // classifier's confidence. -1 and 0 while not assigned (reserved: not produced yet).
      int16 role;
      float role_confidence;

      // Orientations from a body-model fit with temporal smoothing (none yet: has_root_orientation false, the
      // sequences empty). world_frame, (x, y, z, w); the rest pose of each joint set is in tcnart_msgs/msg/JointSets.md.
      boolean has_root_orientation;
      tcn_types::msg::Quaternion root_orientation;                  // the pelvis
      sequence<tcn_types::msg::Quaternion, 32> joint_rotations;     // empty, or one per joint of the joint set
      sequence<float, 32> joint_rotation_confidence;  // empty, or one per joint, [0,1]
    };

    // The persons tracked in one frame group (design 65). CDR with the encapsulation header (DDS_CDR), like the
    // other tcnart_msgs messages. Positions are right-handed, metres. The stream's descriptor states the joint set,
    // frame, up axis, clock domain and smoothing (tcnart_msgs/msg/JointSets.md).
    struct PersonTrackingMessage {

      std_msgs::msg::Header header;   // stamp: capture time of the frame group, in the clock of the mesh and camera
                                      // streams of the same capture (clock domain in the descriptor); frame_id unused
      uint64 group;                   // the producer's frame-group sequence number (0: unknown)
      string<64> joint_set;           // "coco17" | "halpe26": the joints' and bones' order (tcnart_msgs/msg/JointSets.md)
      string<128> world_frame;        // the frame all positions are in: the SQE node of the rig calibration's world
      tcn_types::msg::Vector3 up;                     // unit vector pointing up, in world_frame (per site, as its calibration world)
      uint8 camera_count;             // number of cameras (<= 8) that fed the group
      sequence<Person, 16> persons;
      sequence<float, 8> camera_reprojection_px;  // per camera: median reprojection residual of the group, pixels

    };

  };
};

#endif
