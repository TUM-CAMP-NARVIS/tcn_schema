#ifndef TCNART_MSGS_MSG_HANDTRACKING_IDL
#define TCNART_MSGS_MSG_HANDTRACKING_IDL

#include "tcn_types/msg/Geometry.idl"
#include "tcn_types/msg/Stream.idl"

module tcnart_msgs {
  module msg {

    @appendable enum Handedness {
      HANDEDNESS_UNKNOWN,
      HANDEDNESS_LEFT,
      HANDEDNESS_RIGHT
    };

    @appendable struct HandJointPose {
      tcn_types::msg::RigidTransform pose;
      float radius;
    };

    @appendable struct HandState {
      Handedness hand;
      sequence<HandJointPose> joints;
    };

    @appendable struct HandTrackingMessage {

      tcn_types::msg::StreamHeader header;

      tcn_types::msg::ViewPose head_pose;
      @optional tcn_types::msg::Ray gaze;  // absent: no gaze this sample
      sequence<HandState> hands;

    };

  };
};

#endif
