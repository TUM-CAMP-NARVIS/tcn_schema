#ifndef TCNART_MSGS_MSG_DATAFLOWBUFFERINFO_IDL
#define TCNART_MSGS_MSG_DATAFLOWBUFFERINFO_IDL

module tcnart_msgs {
  module msg {

    @appendable struct BufferInfoPropertyUserData {
        @verbatim (language="comment", text=
                "BufferInfoPropertyUserData provides user-data for BufferInfoProperties")

        string key;

        sequence<octet> value;

    };

    @appendable struct BufferInfoProperty {
        @verbatim (language="comment", text=
                "BufferInfoProperty properties for BufferInfo")

        string name;

        int32 value;

        sequence<BufferInfoPropertyUserData> user_data;
    };

    @verbatim (language="comment", text=
      "BufferInfo struct for memory preallocation.")
    @appendable struct BufferInfo {
      @verbatim (language="comment", text=
        "Provides information about buffer allocation.")

      boolean is_valid;
      boolean is_fixed_size;
      uint64 semantic_type;
      uint64 frame_size;

      uint32 width;
      uint32 height;
      uint32 bits_per_element;
      uint32 stride;

      sequence<BufferInfoProperty> properties;

    };

  };
};

#endif
