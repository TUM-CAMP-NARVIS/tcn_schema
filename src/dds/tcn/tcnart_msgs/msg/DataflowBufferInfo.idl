#ifndef TCNART_MSGS_MSG_DATAFLOWBUFFERINFO_IDL
#define TCNART_MSGS_MSG_DATAFLOWBUFFERINFO_IDL

module tcnart_msgs {
  module msg {

    @appendable struct BufferInfoPropertyUserData {
        @verbatim (language="comment", text=
                "BufferInfoPropertyUserData provides user-data for BufferInfoProperties")

        string key;

        sequence<octet> value;

    };

    @appendable struct BufferInfoProperty {
        @verbatim (language="comment", text=
                "BufferInfoProperty: a vendor extension property of a stream descriptor (StreamDescriptorMessage.properties)")

        string name;

        int32 value;

        sequence<BufferInfoPropertyUserData> user_data;
    };

  };
};

#endif
