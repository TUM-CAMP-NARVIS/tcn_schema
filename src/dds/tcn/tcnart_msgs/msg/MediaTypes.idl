#ifndef TCNART_MSGS_MSG_MEDIATYPES_IDL
#define TCNART_MSGS_MSG_MEDIATYPES_IDL

module tcnart_msgs {
  module msg {

    @appendable enum SensorType {
        SENSOR_TYPE_NONE,
        SENSOR_TYPE_VIDEO_COLOR,
        SENSOR_TYPE_VIDEO_DEPTH,
        SENSOR_TYPE_VIDEO_IR,
        SENSOR_TYPE_TRACKING_POSE,
        SENSOR_TYPE_TRACKING_EYE,
        SENSOR_TYPE_TRACKING_HAND,
        SENSOR_TYPE_TRACKING_BODY,
        SENSOR_TYPE_AUDIO,
        SENSOR_TYPE_IMU_ACCEL,
        SENSOR_TYPE_IMU_GYRO,
        SENSOR_TYPE_IMU_MAG,
        SENSOR_TYPE_MESH_BITSTREAM,
        SENSOR_TYPE_SURFEL
    };

    @appendable enum VideoPixelFormat {
      VIDEO_PIXEL_FORMAT_UNKNOWN,
      VIDEO_PIXEL_FORMAT_NV12,
      VIDEO_PIXEL_FORMAT_RGB24,
      VIDEO_PIXEL_FORMAT_BGR24,
      VIDEO_PIXEL_FORMAT_BGRA32,
      VIDEO_PIXEL_FORMAT_L8,
      VIDEO_PIXEL_FORMAT_L16,
      VIDEO_PIXEL_FORMAT_RGBA32
    };

    @appendable enum VideoImageCompression {
        VIDEO_IMAGE_COMPRESSION_UNKNOWN,
        VIDEO_IMAGE_COMPRESSION_RAW,
        VIDEO_IMAGE_COMPRESSION_PNG,
        VIDEO_IMAGE_COMPRESSION_H26X,
        VIDEO_IMAGE_COMPRESSION_ZDEPTH,
        VIDEO_IMAGE_COMPRESSION_JPEG,
        // JPEG-LS (ISO 14495-1, CharLS): lossless or near-lossless 16-bit images (IR, depth); appended in 0.9.0,
        // receivers that do not know it skip the stream.
        VIDEO_IMAGE_COMPRESSION_JPEG_LS
    };

    @appendable enum VideoH26xProfile {
        VIDEO_H26X_PROFILE_NONE,
        VIDEO_H26X_PROFILE_H264_BASE,
        VIDEO_H26X_PROFILE_H264_MAIN,
        VIDEO_H26X_PROFILE_H264_HIGH,
        VIDEO_H26X_PROFILE_H265_MAIN
    };

    @appendable enum AudioAACProfile {
        AACProfile_12000,
        AACProfile_16000,
        AACProfile_20000,
        AACProfile_24000,
        AACProfile_None
    };

  };
};

#endif
