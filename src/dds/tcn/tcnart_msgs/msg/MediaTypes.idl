#ifndef TCNART_MSGS_MSG_MEDIATYPES_IDL
#define TCNART_MSGS_MSG_MEDIATYPES_IDL

module tcnart_msgs {
  module msg {

    enum SensorType {
        SENSOR_TYPE_NONE,
        SENSOR_TYPE_VIDEO_COLOR,
        SENSOR_TYPE_VIDEO_DEPTH,
        SENSOR_TYPE_VIDEO_IR,
        SENSOR_TYPE_TRACKING_POSE,
        SENSOR_TYPE_TRACKING_EYE,
        SENSOR_TYPE_TRACKING_HAND,
        SENSOR_TYPE_TRACKING_BODY,
        SENSOR_TYPE_AUDIO,
        SENSOR_TYPE_IMU_ACCEL,
        SENSOR_TYPE_IMU_GYRO,
        SENSOR_TYPE_IMU_MAG,
        SENSOR_TYPE_MESH_BITSTREAM,
        SENSOR_TYPE_SURFEL
    };

    enum VideoPixelFormat {
      PixelFormat_NV12,
      PixelFormat_RGB24,
      PixelFormat_BGR24,
      PixelFormat_BGRA32,
      PixelFormat_L8,
      PixelFormat_L16,
      PixelFormat_RGBA32
    };

    enum VideoImageCompression {
        CompressionType_Raw,
        CompressionType_Png,
        CompressionType_H26x,
        CompressionType_Zdepth,
        CompressionType_Jpeg,
        // JPEG-LS (ISO 14495-1, CharLS): lossless or near-lossless 16-bit images (IR, depth); appended in 0.9.0,
        // receivers that do not know it skip the stream.
        CompressionType_JpegLs
    };

    enum VideoH26xProfile {
        H264Profile_Base,
        H264Profile_Main,
        H264Profile_High,
        H265Profile_Main,
        H26xProfile_None
    };

    enum AudioAACProfile {
        AACProfile_12000,
        AACProfile_16000,
        AACProfile_20000,
        AACProfile_24000,
        AACProfile_None
    };

  };
};

#endif
