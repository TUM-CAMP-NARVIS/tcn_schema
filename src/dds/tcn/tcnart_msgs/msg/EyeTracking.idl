#ifndef TCNART_MSGS_MSG_EYETRACKING_IDL
#define TCNART_MSGS_MSG_EYETRACKING_IDL

#include "std_msgs/msg/Header.idl"
#include "tcn_types/msg/Geometry.idl"

module tcnart_msgs {
  module msg {

    @appendable enum XRGazeSpaceType {
      XR_GAZE_SPACE_TYPE_UNKNOWN,
      XR_GAZE_SPACE_TYPE_VIEW,
      XR_GAZE_SPACE_TYPE_LOCAL
    };

    // EyeTrackingMessage.valid: which fields carry data (0.10.3). A field whose bit is clear carries zeros.
    const uint32 EYE_VALID_CENTER = 1;                 // center

    const uint32 EYE_VALID_LEFT_GAZE = 2;              // left_eye

    const uint32 EYE_VALID_RIGHT_GAZE = 4;             // right_eye

    const uint32 EYE_VALID_LEFT_OPENNESS = 8;          // left_openness

    const uint32 EYE_VALID_RIGHT_OPENNESS = 16;        // right_openness

    const uint32 EYE_VALID_VERGENCE = 32;              // vergence_distance

    const uint32 EYE_VALID_LEFT_PUPIL_DIAMETER = 64;   // left_pupil_diameter

    const uint32 EYE_VALID_RIGHT_PUPIL_DIAMETER = 128; // right_pupil_diameter

    const uint32 EYE_VALID_LEFT_PUPIL_POSITION = 256;  // left_pupil_position

    const uint32 EYE_VALID_RIGHT_PUPIL_POSITION = 512; // right_pupil_position

    const uint32 EYE_VALID_LEFT_EXPRESSION = 1024;     // left_squeeze, left_wide

    const uint32 EYE_VALID_RIGHT_EXPRESSION = 2048;    // right_squeeze, right_wide

    const uint32 EYE_VALID_SCENE_POINT = 4096;         // scene_point (0.10.4)

    // One eye-tracker sample. Rays: origin in metres, direction a unit vector, both in gaze_space (absent or LOCAL:
    // the header's frame_id). viewpoint: the head pose at the sample. Openness, squeeze, wide in [0,1].
    @appendable struct EyeTrackingMessage {

      std_msgs::msg::Header header;
      
      tcn_types::msg::RigidTransform viewpoint;

      tcn_types::msg::Ray center;
      tcn_types::msg::Ray left_eye;
      tcn_types::msg::Ray right_eye;
      
      float left_openness;
      float right_openness;
      
      float vergence_distance;  // metres from center.origin to the closest approach of the eye rays
      uint32 valid;             // EYE_VALID_* bits

      // appended in 0.10.3
      float left_pupil_diameter;    // mm; 0 when not valid
      float right_pupil_diameter;
      tcn_types::msg::Vector2 left_pupil_position;  // normalized [0,1] in the eye sensor area, +y up; (0,0) when not valid
      tcn_types::msg::Vector2 right_pupil_position;
      float left_squeeze;           // [0,1]
      float right_squeeze;
      float left_wide;              // [0,1]
      float right_wide;
      // The space the rays are in. Absent means LOCAL (the header's frame_id); a producer that only ever has the
      // local space leaves it absent (0.11, decisions §4).
      @optional XRGazeSpaceType gaze_space;

      // The gaze point in the image of the head-mounted scene (world-facing) camera, normalized [0,1], +x right,
      // +y down (image convention). Present only when measured (e.g. Tobii Pro Glasses 2); a writer sets
      // EYE_VALID_SCENE_POINT exactly when it is present. Appended in 0.10.4; optional since 0.11.
      @optional tcn_types::msg::Vector2 scene_point;
    };

  };
};

#endif
