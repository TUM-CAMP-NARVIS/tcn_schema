#ifndef CONVERSATION_MSGS_RPC_DISCOVERY_IDL
#define CONVERSATION_MSGS_RPC_DISCOVERY_IDL

#include "conversation_msgs/msg/Common.idl"
#include "conversation_msgs/msg/Face.idl"

module conversation_msgs {
  module rpc {

  @appendable struct AppServerInfo {
    conversation_msgs::msg::MessageHeader header;
    string display_name;
    string topic_prefix;
    string environment;
    string message_encoding;
    string session_id;

    conversation_msgs::msg::AudioFormat uplink_format;
    conversation_msgs::msg::AudioFormat expected_stt_format;
    conversation_msgs::msg::AudioFormat expected_tts_format;
    conversation_msgs::msg::AudioFormat downlink_format;
    unsigned long recommended_playback_prebuffer_ms;

    string stt_backend;
    string llm_backend;
    string tts_backend;
    string language_hint;
    string voice_hint;

    boolean allow_barge_in;
    boolean enable_partial_stt;
    boolean enable_partial_llm;
    boolean enable_partial_tts;

    // Optional features this server supports (#36 D1, D4): names match [a-z0-9_]{1,64}; a client ignores a name it
    // does not know. 0.11.0: `playback_events` (it consumes msg::PlaybackEvent), `barge_in_modes` (it honours
    // SessionStart.barge_in_mode), `wake_word` (turns are gated by a wake word).
    sequence<string> capabilities;
    conversation_msgs::msg::BargeInMode barge_in_mode;  // the server's mode (#36 S6)
    sequence<conversation_msgs::msg::FaceAnimationLayout> face_layouts;  // #36 F3, D5
  };

  };
};

#endif
