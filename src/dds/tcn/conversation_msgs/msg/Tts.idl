#ifndef CONVERSATION_MSGS_MSG_TTS_IDL
#define CONVERSATION_MSGS_MSG_TTS_IDL

#include "conversation_msgs/msg/Common.idl"

module conversation_msgs {
  module msg {

  @appendable struct TtsRequest {
    MessageHeader header;
    string backend;
    string voice;
    string language;
    string text;
    float speaking_rate;
    float pitch;
    float volume_gain_db;
    boolean stream_output;
    unsigned long segment_index;
    boolean is_final_segment;
  };

  @appendable struct TtsAudioChunk {
    MessageHeader header;
    string backend;
    string voice;
    AudioFormat format;
    PayloadKind payload_kind;
    unsigned long chunk_index;
    boolean is_final_chunk;
    sequence<float> samples_f32;
    ShmRef shm_ref;
  };

  @appendable struct TtsDone {
    MessageHeader header;
    string backend;
    string voice;
    unsigned long total_chunks;
    Status status;
  };

  };
};

#endif
