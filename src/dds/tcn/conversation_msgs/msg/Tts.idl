#ifndef CONVERSATION_MSGS_MSG_TTS_IDL
#define CONVERSATION_MSGS_MSG_TTS_IDL

#include "conversation_msgs/msg/Common.idl"

module conversation_msgs {
  module msg {

  @appendable struct TtsRequest {
    MessageHeader header;
    string text;
    unsigned long segment_index;
    boolean is_final_segment;
  };

  @appendable struct TtsAudioChunk {
    MessageHeader header;
    string backend;
    string voice;
    AudioFormat format;
    unsigned long chunk_index;
    boolean is_final_chunk;
    // The first sample's position on the turn timeline, at format.sample_rate_hz (#36 F1): 0 at the turn's first TTS
    // sample, continuous across the turn's segments.
    unsigned long long turn_sample_index;
    sequence<float> samples_f32;
  };

  @appendable struct TtsDone {
    MessageHeader header;
    string backend;
    string voice;
    unsigned long total_chunks;
    unsigned long long total_samples;  // the reply's length (#36 T1), at sample_rate_hz
    unsigned long sample_rate_hz;
    Status status;
  };

  };
};

#endif
