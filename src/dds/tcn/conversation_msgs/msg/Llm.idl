#ifndef CONVERSATION_MSGS_MSG_LLM_IDL
#define CONVERSATION_MSGS_MSG_LLM_IDL

#include "conversation_msgs/msg/Common.idl"
#include "conversation_msgs/msg/Control.idl"

module conversation_msgs {
  module msg {

  @appendable enum MemoryScopeKind {
    MEMORY_SCOPE_KIND_UNKNOWN,
    MEMORY_SCOPE_KIND_DISABLED,
    MEMORY_SCOPE_KIND_SESSION,
    MEMORY_SCOPE_KIND_CLIENT,
    MEMORY_SCOPE_KIND_USER,
    MEMORY_SCOPE_KIND_ANONYMOUS
  };

  @appendable struct MemoryScope {
    MemoryScopeKind kind;
    string key;
  };

  @appendable enum InteractionMode {
    INTERACTION_MODE_UNKNOWN,
    INTERACTION_MODE_DIRECT,
    INTERACTION_MODE_PIPELINE
  };

  @appendable enum RetrievalPolicy {
    RETRIEVAL_POLICY_UNKNOWN,
    RETRIEVAL_POLICY_AUTO,  // was `auto_` (C++ keyword; the pipeline says `auto`), value 0 in 0.10
    RETRIEVAL_POLICY_ALWAYS,
    RETRIEVAL_POLICY_NEVER
  };

  @appendable enum ExecutionPreference {
    EXECUTION_PREFERENCE_UNKNOWN,
    EXECUTION_PREFERENCE_AUTO,
    EXECUTION_PREFERENCE_FAST,
    EXECUTION_PREFERENCE_AGENTIC
  };

  @appendable struct RetrievalOptions {
    RetrievalPolicy policy;
    string filter;
    unsigned long top_k;
  };

  @appendable struct ImageAttachment {
    string mime_type;
    sequence<octet> data;
  };

  @appendable struct InteractionRequest {
    MessageHeader header;
    string request_id;
    InteractionMode mode;
    string text;
    sequence<ImageAttachment> images;
    boolean stream_output;
    RetrievalOptions retrieval;
    ClientIdentity identity;
  };

  @appendable struct InteractionPartial {
    MessageHeader header;
    string request_id;
    string text_delta;
    unsigned long token_count;
  };

  @appendable enum InteractionActivityState {
    INTERACTION_ACTIVITY_STATE_UNKNOWN,
    INTERACTION_ACTIVITY_STATE_STARTED,
    INTERACTION_ACTIVITY_STATE_PROGRESS,
    INTERACTION_ACTIVITY_STATE_COMPLETED,
    INTERACTION_ACTIVITY_STATE_FAILED
  };

  @appendable struct InteractionActivity {
    MessageHeader header;
    string request_id;
    string call_id;
    string tool_name;
    InteractionActivityState state;
  };

  @appendable struct InteractionResponse {
    MessageHeader header;
    string request_id;
    string text;
    string finish_reason;
    unsigned long generated_tokens;
  };

  @appendable struct LlmRequest {
    MessageHeader header;
    MemoryScope memory_scope;
    string backend;
    string model;
    string user_text;
    boolean stream_output;
    string interaction_request_id;
    sequence<ImageAttachment> images;
    RetrievalOptions retrieval;
    ExecutionPreference execution_preference;
  };

  @appendable struct LlmPartial {
    MessageHeader header;
    string text_delta;
    unsigned long token_count;
    string model;
  };

  @appendable struct LlmFinal {
    MessageHeader header;
    string text;
    string finish_reason;
    @optional unsigned long prompt_tokens;
    @optional unsigned long generated_tokens;
    string model;
  };

  };
};

#endif
