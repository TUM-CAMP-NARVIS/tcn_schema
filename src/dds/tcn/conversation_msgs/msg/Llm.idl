#ifndef CONVERSATION_MSGS_MSG_LLM_IDL
#define CONVERSATION_MSGS_MSG_LLM_IDL

#include "conversation_msgs/msg/Common.idl"
#include "conversation_msgs/msg/Control.idl"

module conversation_msgs {
  module msg {

  enum MemoryScopeKind {
    disabled,
    session,
    client,
    user,
    anonymous
  };

  struct MemoryScope {
    MemoryScopeKind kind;
    string key;
  };

  enum InteractionMode {
    direct,
    pipeline
  };

  enum RetrievalPolicy {
    auto_,  // C++ keyword; the pipeline names it `auto`; same value (0)
    always,
    never
  };

  enum ExecutionPreference {
    AUTO,
    FAST,
    AGENTIC
  };

  struct RetrievalOptions {
    RetrievalPolicy policy;
    sequence<string> preferred_domains;
    sequence<string> excluded_domains;
    string filter;
    unsigned long top_k;
  };

  struct ImageAttachment {
    string mime_type;
    sequence<octet> data;
  };

  struct InteractionRequest {
    MessageHeader header;
    string request_id;
    InteractionMode mode;
    string text;
    sequence<ImageAttachment> images;
    boolean stream_output;
    RetrievalOptions retrieval;
    ClientIdentity identity;
  };

  struct InteractionPartial {
    MessageHeader header;
    string request_id;
    string text_delta;
    unsigned long token_count;
  };

  enum InteractionActivityState {
    started,
    progress,
    completed,
    failed
  };

  struct InteractionActivity {
    string request_id;
    string call_id;
    string tool_name;
    InteractionActivityState state;
  };

  struct InteractionResponse {
    MessageHeader header;
    string request_id;
    string text;
    string finish_reason;
    unsigned long generated_tokens;
  };

  struct LlmRequest {
    MessageHeader header;
    MemoryScope memory_scope;
    string backend;
    string model;
    string system_prompt;
    string user_text;
    boolean stream_output;
    boolean low_latency_mode;
    string interaction_request_id;
    sequence<ImageAttachment> images;
    RetrievalOptions retrieval;
    ExecutionPreference execution_preference;
  };

  struct LlmPartial {
    MessageHeader header;
    string text_delta;
    unsigned long token_count;
    string model;
    EventState state;
  };

  struct LlmFinal {
    MessageHeader header;
    string text;
    string finish_reason;
    unsigned long prompt_tokens;
    unsigned long generated_tokens;
    boolean has_prompt_tokens;
    boolean has_generated_tokens;
    string model;
    EventState state;
  };

  };
};

#endif
