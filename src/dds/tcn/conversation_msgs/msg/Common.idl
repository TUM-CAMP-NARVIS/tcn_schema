#ifndef CONVERSATION_MSGS_MSG_COMMON_IDL
#define CONVERSATION_MSGS_MSG_COMMON_IDL

module conversation_msgs {
  module msg {

  @appendable enum AudioCodec {
    AUDIO_CODEC_UNKNOWN,
    AUDIO_CODEC_PCM_F32,
    AUDIO_CODEC_PCM_S16LE,
    AUDIO_CODEC_OPUS
  };

  @appendable enum ChannelLayout {
    CHANNEL_LAYOUT_UNKNOWN,
    CHANNEL_LAYOUT_MONO,
    CHANNEL_LAYOUT_STEREO
  };

  @appendable enum StreamDirection {
    STREAM_DIRECTION_UNKNOWN,
    STREAM_DIRECTION_UPLINK,
    STREAM_DIRECTION_DOWNLINK
  };

  @appendable enum CancelTarget {
    CANCEL_TARGET_UNKNOWN,
    CANCEL_TARGET_STT,
    CANCEL_TARGET_LLM,
    CANCEL_TARGET_TTS,
    CANCEL_TARGET_ALL
  };

  @appendable enum SessionState {
    SESSION_STATE_UNKNOWN,
    SESSION_STATE_IDLE,
    SESSION_STATE_LISTENING,
    SESSION_STATE_CAPTURING_UTTERANCE,
    SESSION_STATE_STT_FINALIZING,
    SESSION_STATE_LLM_GENERATING,
    SESSION_STATE_TTS_SYNTHESIZING,
    SESSION_STATE_PLAYING,
    SESSION_STATE_STOPPED,
    SESSION_STATE_ERROR
  };

  // Why a session changed state (#36 S5): a return to LISTENING after a completed reply, a barge-in, an ignored
  // noise, an utterance without the wake word or a cancel. NONE when there is nothing to say (the first enumerator
  // is NONE, not UNKNOWN). Errors keep their detail in SessionStateEvent.status.
  @appendable enum SessionStateReason {
    SESSION_STATE_REASON_NONE,
    SESSION_STATE_REASON_COMPLETED,
    SESSION_STATE_REASON_BARGE_IN,
    SESSION_STATE_REASON_NON_SPEECH,
    SESSION_STATE_REASON_NOT_ADDRESSED,
    SESSION_STATE_REASON_CANCELLED,
    SESSION_STATE_REASON_ERROR
  };

  // The server's barge-in mode (#36 S6), advertised in AppServerInfo.barge_in_mode; a client may lower it with
  // SessionStart.barge_in_mode. UNKNOWN is 0 (E6), so OFF is 1 (#36 S6 had OFF = 0).
  @appendable enum BargeInMode {
    BARGE_IN_MODE_UNKNOWN,
    BARGE_IN_MODE_OFF,
    BARGE_IN_MODE_VAD,
    BARGE_IN_MODE_SUSTAINED,
    BARGE_IN_MODE_WORDS
  };

  @appendable enum ErrorCode {
    ERROR_CODE_NONE,
    ERROR_CODE_UNKNOWN,
    ERROR_CODE_INVALID_ARGUMENT,
    ERROR_CODE_DECODE_FAILED,
    ERROR_CODE_RESAMPLE_FAILED,
    ERROR_CODE_VAD_FAILED,
    ERROR_CODE_STT_FAILED,
    ERROR_CODE_LLM_FAILED,
    ERROR_CODE_TTS_FAILED,
    ERROR_CODE_ENCODE_FAILED,
    ERROR_CODE_TIMEOUT,
    ERROR_CODE_CANCELLED,
    ERROR_CODE_BACKPRESSURE,
    ERROR_CODE_SESSION_NOT_FOUND,
    ERROR_CODE_UNSUPPORTED_FORMAT
  };

  @appendable struct MessageHeader {
    string msg_id;
    string trace_id;

    string producer;
    string site;
    string node;
    string service;

    string session_id;
    unsigned long long turn_id;
    unsigned long long seq_no;

    unsigned long long ts_mono_ns;
    unsigned long long ts_wall_unix_ns;

    unsigned short schema_version_major;
    unsigned short schema_version_minor;
  };

  @appendable struct AudioFormat {
    AudioCodec codec;
    unsigned long sample_rate_hz;
    unsigned short channels;
    ChannelLayout channel_layout;
    unsigned short frame_duration_ms;
  };

  @appendable struct Status {
    ErrorCode code;
    string message;
  };

  };
};

#endif
