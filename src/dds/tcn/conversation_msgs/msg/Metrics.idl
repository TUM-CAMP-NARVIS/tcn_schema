#ifndef CONVERSATION_MSGS_MSG_METRICS_IDL
#define CONVERSATION_MSGS_MSG_METRICS_IDL

#include "conversation_msgs/msg/Common.idl"

module conversation_msgs {
  module msg {

  struct StageMetric {
    MessageHeader header;

    string stage;
    string backend;
    string model;

    unsigned long long queue_depth;
    unsigned long long drop_count;

    double processing_time_ms;
    double time_to_first_partial_ms;
    double time_to_final_ms;
    double time_to_first_audio_ms;

    double cpu_utilization_pct;
    double gpu_utilization_pct;
    double memory_used_mb;
  };

  struct HealthStatus {
    MessageHeader header;
    string _component;  // IDL keyword: the leading underscore escapes it; the member is `component`
    boolean ready;
    Status status;
  };

  };
};

#endif
