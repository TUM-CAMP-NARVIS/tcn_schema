#ifndef CONVERSATION_MSGS_MSG_CONTROL_IDL
#define CONVERSATION_MSGS_MSG_CONTROL_IDL

#include "conversation_msgs/msg/Common.idl"

module conversation_msgs {
  module msg {

  @appendable struct ClientIdentity {
    string client_id;
    string user_id;
    string display_name;
  };

  @appendable struct SessionStart {
    MessageHeader header;
    StreamDirection direction;

    AudioFormat ingress_format;
    AudioFormat expected_stt_format;
    AudioFormat expected_tts_format;
    AudioFormat egress_format;

    string stt_backend;
    string llm_backend;
    string tts_backend;

    string language_hint;
    string voice_hint;

    boolean allow_barge_in;
    boolean enable_partial_stt;
    boolean enable_partial_llm;
    boolean enable_partial_tts;
    ClientIdentity identity;
  };

  @appendable struct SessionStop {
    MessageHeader header;
    string reason;
  };

  @appendable struct SessionCancel {
    MessageHeader header;
    CancelTarget target;
    string reason;
  };

  @appendable struct SessionConfigUpdate {
    MessageHeader header;

    boolean has_language_hint;
    string language_hint;

    boolean has_voice_hint;
    string voice_hint;

    boolean has_allow_barge_in;
    boolean allow_barge_in;

    boolean has_enable_partial_stt;
    boolean enable_partial_stt;

    boolean has_enable_partial_llm;
    boolean enable_partial_llm;

    boolean has_enable_partial_tts;
    boolean enable_partial_tts;
  };

  @appendable struct SessionStateEvent {
    MessageHeader header;
    SessionState state;
    Status status;
  };

  };
};

#endif
