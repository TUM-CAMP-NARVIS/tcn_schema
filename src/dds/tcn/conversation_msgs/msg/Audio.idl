#ifndef CONVERSATION_MSGS_MSG_AUDIO_IDL
#define CONVERSATION_MSGS_MSG_AUDIO_IDL

#include "conversation_msgs/msg/Common.idl"

module conversation_msgs {
  module msg {

  @appendable struct AudioOpusFrame {
    MessageHeader header;
    StreamDirection direction;
    AudioFormat format;

    boolean end_of_utterance;
    boolean end_of_stream;

    unsigned long long capture_ts_mono_ns;
    unsigned long long first_sample_index;  // session-continuous, for loss detection
    unsigned long long turn_sample_index;   // on the turn timeline (#36 F2; egress rescales the TTS position)

    sequence<octet> packet;
  };

  @appendable struct AudioPcmChunk {
    MessageHeader header;
    StreamDirection direction;
    AudioFormat format;

    boolean end_of_utterance;
    boolean end_of_stream;

    unsigned long long capture_ts_mono_ns;
    unsigned long long first_sample_index;
    unsigned long sample_count_per_channel;

    sequence<float> samples_f32;
  };

  // #36 A1: an onset (speech_active) or an offset, at its position in the utterance stream.
  @appendable struct VadEvent {
    MessageHeader header;

    boolean speech_active;
    unsigned long long stream_position_ms;
    @optional float speech_probability;  // only from a VAD that has one
    string backend;
  };

  };
};

#endif
