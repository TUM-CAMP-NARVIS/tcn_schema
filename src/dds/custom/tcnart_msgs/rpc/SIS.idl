#ifndef TCNART_RPC_SIS
#define TCNART_RPC_SIS

#include "tcnart_msgs/msg/Types.idl"
#include "tcnart_msgs/msg/SpatialRelations.idl"
#include "tcnart_msgs/rpc/Requests.idl"

// The Spatial Information Service.
//
// These are thin RPC envelopes over the spatial relationship graph defined in
// tcnart_msgs/msg/SpatialRelations.idl. The graph is the model; nothing here
// re-describes it.

module tcnart_msgs {
  module rpc {

    // --- graph lifecycle ---------------------------------------------------

    // Announce a client and its whole graph at once. Refused if the client
    // already exists, or if the graph's origin is not among its nodes.
    struct SISJoinRequest {
        tcnart_msgs::msg::SRGraph graph;
    };

    // Announce departure. Without this a client is only collected after the
    // inactivity timeout.
    struct SISLeaveRequest {
        string client;
    };

    struct SISNodeUpdateRequest {
        tcnart_msgs::msg::SRNode node;
    };

    // Refused for the graph's origin node.
    struct SISNodeRemoveRequest {
        string name;
    };

    struct SISEdgeUpdateRequest {
        tcnart_msgs::msg::SREdge edge;
    };

    // Removes exactly the named edge, not every edge between its endpoints.
    struct SISEdgeRemoveRequest {
        string name;
    };

    // --- the answer to a mutation -----------------------------------------

    // Mutations used to be `put` onto a plain subscriber and answered by
    // nothing. `/sis/relation/update` is now a **queryable**: one key, one
    // verb. A client `get`s it with the same SISEdgeUpdateRequest as before
    // and is answered with the reply below.
    //
    // The subscriber is gone, not kept alongside. A peer that keeps `put`ting
    // reaches nothing at all -- which is the loud kind of failure, because the
    // calibration it was pushing visibly never lands, and it is affordable
    // here only because every publisher of this key belongs to the engine's
    // own repository. Do not read this as a general licence: a key with
    // publishers outside the engine cannot be moved this way.
    //
    // Nothing about a `get` that writes is anomalous. `/sis/stream/start` and
    // `/sis/stream/stop` are already queryables and both mutate -- starting a
    // stream creates records, spawns a pipeline and publishes a derived edge.
    // The rule this protocol follows is **queryable when the caller needs an
    // answer**, not "queryable when the operation reads", and by that rule the
    // fire-and-forget `put` was the outlier. A calibration push is exactly the
    // case: a rig that computed a transform and cannot tell whether the graph
    // now holds it has not finished its job.
    //
    // This type is deliberately NOT relation-shaped. Only
    // `/sis/relation/update` is a queryable today, because a calibration push
    // is the mutation whose whole point is knowing the value landed. The other
    // mutation keys are expected to follow -- each becoming a queryable in its
    // turn -- and they must not each invent their own reply: one type now is
    // cheaper than four reconciled later.
    // `/sis/leave` is the deliberate exception and will never answer -- a
    // withdrawn liveliness token reaches the identical departure with no query
    // behind it to answer, and one route answering while the other cannot is
    // worse than uniform silence.
    //
    // It carries no handle and no echo of what was written. An echo would be a
    // read, and a read riding on a write reply is the one shape guaranteed to
    // disagree with the read RPC beside it (SISGraphQueryReply, below).
    enum SISMutationStatus {
        SIS_MU_ACCEPTED,        // stored: the row and its transform are in the
                                //   database. It does NOT mean visible to the
                                //   next read -- a read is a separate query on
                                //   a separate task, and nothing orders it
                                //   against this reply. There is no
                                //   read-your-write guarantee here to give.
        SIS_MU_UNKNOWN_CLIENT,  // no such fragment; join before mutating it
        SIS_MU_UNKNOWN_FRAME,   // a named endpoint node does not exist. One
                                //   status, not two: which endpoint was wrong
                                //   is in `detail`, because a client fixes the
                                //   name either way and a status it branches
                                //   on should be one it can branch on usefully
        SIS_MU_REJECTED,        // malformed, undecodable, or a refused value:
                                //   a non-finite weight, an invalid identifier,
                                //   a temporal-type transition the engine
                                //   refuses, or a push naming an engine-derived
                                //   edge -- whose provenance is engine-written
                                //   and is what cycle exclusion is computed
                                //   from, so a client overwrite breaks it
        SIS_MU_UNAVAILABLE      // the write did not complete inside its bound.
                                //   This means *unknown*, not "did not land":
                                //   a timed-out write may still be applied.
                                //   Retrying is safe and is the recommended
                                //   behaviour -- the write is an upsert, so a
                                //   repeat is the same write. Reporting it to
                                //   an operator as a failed calibration is not.
    };

    // `status` first, matching SISRelationStreamReply, so a decoder that reads
    // only the leading enum degrades the way the existing one already does.
    struct SISMutationReply {
        SISMutationStatus status;
        string detail;                  // human-readable; may be empty
    };

    // --- relation streams -------------------------------------------------

    // A frame of reference: a node within an owning graph.
    struct SISFrameRef {
        string client;                  // owning graph
        string node;                    // SRNode.name within it
    };

    // Which dynamic hop of a compiled path drives an SRG_TRIGGER_ON_REFERENCE
    // stream. Ordinals are the wire encoding; append only.
    enum SRReferencePolicy {
        SRG_REF_FIRST,                  // the hop closest to the observer -- first in
                                        // path order, the request naming its path as
                                        // "target located in observer"
        SRG_REF_FASTEST,                // the hop with the highest declared frame_rate
        SRG_REF_SLOWEST                 // the hop with the lowest declared non-zero rate
    };

    enum SRStreamTriggerKind {
        SRG_TRIGGER_FIXED_RATE,         // a timer; sample at "now" less the system latency
        SRG_TRIGGER_ON_STREAM,          // a named stream; sample at its stamp
        SRG_TRIGGER_ON_ANY,             // any input on the path; sample at the arriving stamp
        SRG_TRIGGER_ON_REFERENCE        // one hop of the path; sample at its stamp
    };

    // When a relation stream is evaluated, and therefore at which instant every
    // edge on the path is sampled. They differ in more than rate: a fixed rate
    // extrapolates every edge to the present, while the others interpolate the
    // rest of the path to one arriving sample's timestamp.
    //
    // SRG_TRIGGER_ON_REFERENCE is the one to send for a composed relation, and
    // is what the engine's own clients default to. SRG_TRIGGER_ON_ANY fires
    // once per input, so a path's output rate is the *sum* of its inputs'
    // rates -- and since a derived edge is itself an input to whatever reuses
    // it, that compounds down a chain: on a six-joint arm whose every sensor
    // runs at 30 Hz, three chained relations published 90, 150 and 180 Hz.
    //
    // One relation is one stream, shared by every requester, so two clients
    // asking for the same relation with different triggers is refused. Pick
    // one and use it across the deployment.
    union SRStreamTrigger switch(SRStreamTriggerKind) {
    case SRG_TRIGGER_FIXED_RATE:
        double hz;
    case SRG_TRIGGER_ON_STREAM:
        string topic;
    case SRG_TRIGGER_ON_ANY:
        boolean unused;
    case SRG_TRIGGER_ON_REFERENCE:
        SRReferencePolicy policy;
    };

    // Whether the engine should keep looking for a better route once this
    // stream is running, or serve whatever was best at the moment it compiled.
    //
    // A stream's route is chosen by the pathfinder from what is *walkable* at
    // compile time, and an uncalibrated relation is not walkable. So a request
    // whose shortest route crosses a relation nobody has calibrated yet is
    // served over the longer walkable one -- correctly, and with no way to say
    // so, because SIS_RS_ACTIVE is what the client is told. If that
    // calibration later arrives, the shorter route becomes available and
    // nothing looks at it again.
    enum SISReoptimisePolicy {
        SIS_RO_BEST_AVAILABLE_NOW,  // ordinal 0. Today's behaviour, and the
                                    //   default: serve the best route
                                    //   available at the moment of
                                    //   compilation, and re-evaluate only
                                    //   when something on that route changes.
        SIS_RO_BEST_POSSIBLE        // ordinal 1. Serve me now over whatever is
                                    //   available, and move me when a better
                                    //   route appears -- typically when a
                                    //   calibration makes a shorter path
                                    //   walkable.
    };

    // Publish the spatial relation between two frames as a stream.
    //
    // This replaces topic translation. What a consumer wants is not a copy of
    // some pose stream re-expressed, but the answer to "where is target, as seen
    // from observer, at this instant" -- which the engine resolves through the
    // unified graph. The path may cross tracked edges, static edges, calibrated
    // edges, and several clients' graphs; it may also be entirely static, which
    // topic translation could not express at all.
    //
    // If `target` names a template node, the stream carries one entry per
    // instance materialized from it -- "every ArUco marker this camera sees, in
    // the headset's frame" -- observed at one instant, in one message.
    //
    // The client asks *what* relation it wants, not *where* to put it: there is
    // no output_topic here. 0.3.0's third field is gone, and the engine answers
    // with the topic it assigned (SISRelationStreamReply, below). Field order is
    // now: observer, target, trigger, freshness_bias, reoptimise.
    struct SISRelationStreamStartRequest {
        SISFrameRef observer;           // the frame poses are expressed in
        SISFrameRef target;             // the frame being located
        SRStreamTrigger trigger;

        // How much this consumer prefers freshness over reuse, in [0, 1].
        //
        // A relation already computed by another stream is available as a
        // derived edge weighted below the path it replaces, so it is normally
        // preferred: fewer hops, less work. But it is strictly staler by one
        // publish-ingest-buffer round, which a render loop will never notice
        // and a latency-sensitive alignment might.
        //
        // 0 takes every shortcut available. 1 ignores derived edges entirely
        // and walks only measured relations. Values between move a derived
        // edge's effective weight toward the path it replaced. Applied when the
        // stream is compiled, so no weight changes at runtime and no path is
        // recompiled because a number drifted.
        double freshness_bias;

        // Appended last. Ordinal 0 is today's behaviour, so a zero-filled
        // field is the default and a client that does not care need not think
        // about it.
        //
        // **NOT part of stream identity, and it is the only field here that
        // is not.** `observer`, `target`, `trigger` and `freshness_bias` are
        // what the engine compares when a second request arrives for a
        // relation it is already serving: one handle per (observer, target),
        // and a request differing in `trigger` or `freshness_bias` is refused
        // rather than attached, because both change *what is published*. This
        // one does not: whichever route the engine settles on, the stream
        // carries the same relation, in the same frame, at the same trigger,
        // computed from live data. So a second request differing only in this
        // field ATTACHES to the existing stream, and the policy is recorded
        // against the requester rather than against the stream.
        //
        // A stream re-optimises if ANY of its requesters asked for
        // SIS_RO_BEST_POSSIBLE -- the union, not the intersection. A
        // best-available-now requester sharing such a stream can therefore be
        // re-routed. That was already true before this field existed: a
        // running stream is re-routed today whenever a relation on its own
        // path changes, and always has been. What this field controls is on
        // which *occasions* the engine looks for a better route, not whether
        // re-routing can happen at all. It does not mean "never move me", and
        // the protocol has never offered that.
        //
        // Watch `route_epoch` on SISRelationStreamStatusNotification to know
        // when a re-route actually happened.
        SISReoptimisePolicy reoptimise;
    };

    // Stops the stream named by the handle the engine issued in
    // SISRelationStreamReply.handle. Renamed from 0.3.0's `output_topic` on
    // purpose: the value is no longer a topic the client chose, and a rename
    // turns a peer that keeps supplying its own into a compile error instead of
    // a request that decodes cleanly and stops nothing.
    struct SISRelationStreamStopRequest {
        string handle;
    };

    enum SISRelationStreamStatus {
        SIS_RS_ACTIVE,                  // running
        SIS_RS_INACTIVE,                // not running; stopped, or never started
        SIS_RS_NO_PATH,                 // the graph does not connect these two frames
        SIS_RS_UNKNOWN_FRAME,           // a named client or node does not exist
        SIS_RS_CLOCK_DOMAIN_MISMATCH,   // the path crosses unsynchronized clocks
        SIS_RS_REJECTED,                // malformed request
        SIS_RS_PENDING                  // accepted, but not yet producing: a frame on the
                                         // path was withdrawn and is not pinned, or an edge
                                         // on it is not calibrated yet. Re-evaluated on every
                                         // graph mutation and resumes on its own once the
                                         // missing part arrives — the client does nothing.
                                         // Distinct from SIS_RS_NO_PATH, which means the
                                         // frames are not connectable at all and the request
                                         // is refused. Appended last so existing ordinals
                                         // hold.
    };

    // One relation on a pending stream's path whose value is not usable yet.
    //
    // SIS_RS_PENDING says *something* on the path is not calibrated. It never
    // said **which**, and a client cannot launch a calibration routine for a
    // relation it cannot name -- which is the whole point of accepting the
    // request instead of refusing it. This is that name, in a form the client
    // can act on rather than print.
    //
    // # What identifies a relation here, and why it is three fields
    //
    // The client's next action is a `/sis/relation/update` carrying a full
    // SREdge, and that write is an upsert keyed on (source, target, name). A
    // declared `name` alone does not address anything: two fragments may each
    // declare a relation called `origin_camera`, and the engine's own region
    // loader disambiguates them by row precisely because the name does not.
    // So the pair of endpoints travels with the name, and each endpoint is a
    // SISFrameRef -- the same {client, node} pair the start request named its
    // own frames with, so nothing new has to be learnt to read this.
    //
    // `client` is empty exactly when the node is SRG_NODE_SCOPE_GLOBAL: a
    // global node has one name in one namespace and belongs to no fragment
    // (see SRNodeView, which draws the same distinction for the same reason).
    // It is not "unknown".
    //
    // **Which fragment to send the update under.** The one owning a *local*
    // endpoint -- `source.client` when it is non-empty, otherwise
    // `target.client`, otherwise any joined fragment. That matters because
    // `/sis/relation/update` resolves the bare `source`/`target` names it is
    // given against the *sending* client's fragment first, then globally: sent
    // under the wrong fragment, a local endpoint resolves to nothing and the
    // push is answered SIS_MU_UNKNOWN_FRAME.
    //
    // The relation is **not** carried as a whole SREdge. An SREdge here would
    // be a read riding on a status message, and it would go stale the moment
    // anything else touched the row -- the same objection SISMutationReply
    // records for its own missing echo. What is carried is an address plus the
    // one property that says why the relation blocks.
    struct SISBlockingRelation {
        SISFrameRef source;             // the relation's source frame
        SISFrameRef target;             // the relation's target frame
        string name;                    // SREdge.name, as declared

        // Why this relation cannot be composed: today always
        // SRG_EDGE_STATIC_UNCALIBRATED, the one temporal type the pathfinder
        // refuses (see SREdgeTemporalType). Carried rather than assumed, so a
        // client branches on the reason instead of on a status that has only
        // ever had one.
        tcnart_msgs::msg::SREdgeTemporalType temporal_type;
    };

    // Whether a reply carries a handle at all.
    //
    // A refusal has no stream to name, and an empty string standing in for
    // "absent" is exactly the plausible default this project has been bitten by
    // before: it is a legal topic-shaped value that every consumer would have to
    // remember to special-case. A discriminated union makes absence a case the
    // decoder has to handle.
    enum SISRelationStreamHandleKind {
        SIS_RSH_NONE,                   // no stream to consume, and so no handle
        SIS_RSH_ASSIGNED                // the engine assigned this handle
    };

    // Carries a filler `boolean` in the NONE case because IDL requires every
    // union case to declare a member -- the same reason SRStreamTrigger's
    // SRG_TRIGGER_ON_ANY carries one.
    union SISRelationStreamHandle switch(SISRelationStreamHandleKind) {
    case SIS_RSH_NONE:
        boolean unused;
    case SIS_RSH_ASSIGNED:
        string topic;
    };

    // The answer to SISRelationStreamStartRequest and
    // SISRelationStreamStopRequest. 0.3.0 replied with a bare
    // SISRelationStreamStatus; the handle is what a client now needs to
    // subscribe to anything at all, because it no longer chose the topic.
    //
    // The handle is ASSIGNED exactly when the status is SIS_RS_ACTIVE or
    // SIS_RS_PENDING -- the two statuses that mean "there is a stream on this
    // topic for you". Every other status (including SIS_RS_INACTIVE, the answer
    // to a stop) is NONE.
    //
    // This reply carries exactly ONE key: the data topic, in `handle.topic`.
    // An earlier version of this comment said to "read all three from this
    // reply", which was never possible -- there is one field. What is true:
    //
    //   data topic    read it from `handle.topic`. Never compute it. It is
    //                 "sqe/{engine_id}/rel/{handle}" today, and that shape is
    //                 not a promise -- a client that reconstructs it is broken
    //                 by any change to the engine's own namespace.
    //
    //   status topic  derive it as "{handle.topic}/status". This derivation IS
    //                 part of the contract and is stable; it is where a stream
    //                 announces that it went NoPath, and the only teardown
    //                 event guaranteed to arrive. Deriving it is correct and
    //                 expected -- there is no field for it because it is a
    //                 function of the one there is.
    //
    //   descriptor    do NOT derive it, and do not read it. It is the engine's
    //                 own announcement, addressed to its ingest path, not to
    //                 the client that asked for the stream. Reaching it means
    //                 rewriting a middle segment of the data topic, which is
    //                 exactly the recomputation the first rule forbids. If a
    //                 client ever genuinely needs it, this reply gains a field;
    //                 it does not gain a blessed string manipulation.
    //
    // `blocked_by` is populated only for SIS_RS_PENDING, and is empty for every
    // other status. It is on the reply as well as on the notification below
    // because a client told "pending" should learn why in the same answer: the
    // notification carrying the same list may already have been published
    // before that client subscribed to the status topic.
    //
    // An empty `blocked_by` on a SIS_RS_PENDING reply is meaningful and is not
    // an omission -- the stream is waiting on something that is not a
    // calibration (a withdrawn frame, an upstream stream not yet running), and
    // there is nothing for a calibration routine to do about it.
    //
    // `detail` says *why* an answer that names no stream is what it is, and it
    // is what makes a refusal actionable at all. A client answered
    // SIS_RS_REJECTED, SIS_RS_NO_PATH or SIS_RS_UNKNOWN_FRAME otherwise learns
    // only *that* it failed: which of the two frames was unknown, and which
    // parameter conflicted with the stream already on this handle, are exactly
    // what the status cannot say.
    //
    // **It is the same string the refusal publishes on "{handle}/status".** A
    // refusal emits both this reply and a notification, and both take their
    // text from one value in the engine, so the two cannot disagree. Before
    // this field the notification was the only carrier -- and unreachable in
    // precisely this case, since a refused reply carries SIS_RSH_NONE and the
    // client therefore cannot know the key its own explanation went to.
    //
    // Non-empty exactly when `handle` is SIS_RSH_NONE. An answer that names a
    // stream needs no sentence: SIS_RS_ACTIVE is self-explanatory, and a
    // SIS_RS_PENDING says what to calibrate in `blocked_by`, which prose
    // restating it would only duplicate.
    struct SISRelationStreamReply {
        SISRelationStreamStatus status;
        SISRelationStreamHandle handle;
        // Appended last, so a decoder reading the two leading fields degrades
        // exactly as it already did.
        sequence<SISBlockingRelation> blocked_by;
        // Appended last, after `blocked_by`.
        string detail;                  // why, when there is no handle
    };

    // Published on "{output_topic}/status" when a stream's status changes.
    //
    // A consumer otherwise cannot tell "the engine says there is no path" from
    // "the engine died", and only the first is recoverable by waiting.
    // `output_topic` now carries the engine-issued handle from
    // SISRelationStreamReply, not a topic the client picked. The field name and
    // its position are unchanged.
    //
    // `blocked_by` carries the same list SISRelationStreamReply does, under the
    // same rule, and it is **republished whenever the list itself changes**: a
    // stream pending on two uncalibrated relations, one of which is then
    // supplied, publishes SIS_RS_PENDING again naming only the one that is
    // left. A client drives its calibration sequence off these republications
    // and is done when SIS_RS_ACTIVE arrives.
    //
    // This only helps while the stream is *pending*. If a longer walkable path
    // exists the stream is SIS_RS_ACTIVE, no list is produced, and the client
    // is served -- just not over the shorter route the missing calibration
    // would open.
    //
    // **It is also published when a running stream's route changes**, carrying
    // SIS_RS_ACTIVE for a stream that was already active and an incremented
    // `route_epoch`. A different route is a different composition of a
    // different set of measurements, so the poses step at the switch; before
    // `route_epoch` existed the engine performed the switch and said nothing
    // at all. Every route change is announced, whatever caused it -- a
    // consumer cannot care *why* its geometry provenance changed, only that it
    // did.
    struct SISRelationStreamStatusNotification {
        string output_topic;
        SISRelationStreamStatus status;
        string detail;                  // human-readable reason; may be empty
        // Appended last, for SISRelationStreamReply's reason.
        sequence<SISBlockingRelation> blocked_by;

        // Appended last, after SISRelationStreamReply's reason.
        //
        // Bumped whenever this stream's compiled route changes: a different
        // set of relations composed, therefore a different accumulated error,
        // and poses that step at the switch. A consumer detects a re-route by
        // this value changing, not by the status -- a re-route republishes
        // SIS_RS_ACTIVE for a stream that was already active, which a consumer
        // treating status as state will correctly dedupe.
        //
        // Per-stream, monotonically increasing, starting at 0 on the first
        // successful compile. Not a hash of the route: a stream with no
        // derived edge (a single hop, a template) has no name to hash, and
        // returning to a previously-taken route would reproduce a value
        // already seen.
        //
        // Streams do not persist, so this resets when the engine restarts --
        // together with the handle's whole record. A consumer that reconnects
        // must assume a discontinuity anyway.
        uint32 route_epoch;
    };

    // --- reading the graph -------------------------------------------------

    // What a read may ask for.
    //
    // Every kind is bounded by something the asker already knows the size of.
    // There is no kind meaning "the whole graph", and that is the point rather
    // than an omission: the engine holds no in-memory graph, and the connected
    // region around any seed is the transitive closure over every relation,
    // which in a fused deployment is the entire fleet. A read of it is
    // unbounded however small the reply that comes back is shaped.
    enum SISGraphQueryKind {
        SIS_GQ_FRAGMENT,        // everything one client declared. Bounded by
                                //   that fragment's own size
        SIS_GQ_NEIGHBOURS,      // one node and its incident relations. Bounded
                                //   by that node's degree
        SIS_GQ_SEARCH,          // a filter within one of the two anchors above.
                                //   See the filter fields on the request
        SIS_GQ_PATH             // B64: the relations connecting two frames.
                                //   Was reserved-and-refused, on the grounds
                                //   that a path read has to answer *which*
                                //   predicate it walked and a plain traversal
                                //   answers none of them. Resolved rather than
                                //   dropped: the REQUEST now names the
                                //   predicate (`predicate`, below), so the
                                //   answer is to one question, and the walk is
                                //   bounded by `radius` rather than being the
                                //   whole-graph read this service refuses
    };

    // B64. Which rule a path read walks by. A path is only meaningful with
    // respect to one of these, and a caller comparing a path against what a
    // relation stream did needs to ask for the same one.
    //
    // These mirror the engine's own predicates exactly -- there is no fourth,
    // looser rule reachable from here.
    enum SISPathPredicate {
        SIS_PP_WALKABLE,        // the default: refuses uncalibrated relations,
                                //   which is what a running stream composes by
        SIS_PP_CONNECTABLE,     // the relaxed shape rule a PENDING stream is
                                //   probed with: is there a route at all, once
                                //   the missing measurements arrive?
        SIS_PP_WALKABLE_STATIC  // walkable, and refusing anything that moves.
                                //   What a calibration asks when it needs a
                                //   relation to hold still
    };

    // One request type and one key for all four kinds, not four of each.
    //
    // Four keys would read better and would be worse in every other way: four
    // reply types to keep in step, four places to forget the result cap, and --
    // decisively -- four rate-limit buckets per client instead of one, so a
    // client respecting each limit individually could still poll at four times
    // the intended rate. The cost of one key is its mirror image and is stated
    // here so nobody discovers it: the item cap and the minimum interval are
    // ONE shared budget. A client running a UI refresh and a calibration sweep
    // is competing with itself, which is correct -- it is one client's share of
    // one database.
    //
    // Which fields matter depends on `kind`; the rest are ignored, not refused.
    struct SISGraphQueryRequest {

        SISGraphQueryKind kind;

        // FRAGMENT: whose fragment. SEARCH: the fragment anchor.
        // Empty for the other kinds, and empty for a SEARCH anchored on `from`.
        string client;

        // NEIGHBOURS: the node. SEARCH: the node anchor. PATH: the observer.
        SISFrameRef from;

        // PATH: the target. Unused by every kind that ships today.
        SISFrameRef to;

        // An upper bound on nodes plus edges in one reply. 0 asks for the
        // engine's default. This may only LOWER the engine's own cap, never
        // raise it: a reply is additionally bounded by a byte ceiling, because
        // an item count does not bound bytes when a field like `custom_data`
        // is arbitrary.
        uint32 max_items;

        // Opaque; empty on a first page, otherwise the `next_cursor` of the
        // page before. A cursor and not an offset: the graph mutates under a
        // paginated read and there is no transaction held across pages, so an
        // offset silently skips or repeats rows. What stability a cursor
        // offers is the engine's to state, and it is free to change what the
        // value is -- a client that parses one has broken the contract.
        string cursor;

        // --- search filters ------------------------------------------------
        //
        // Read only for SIS_GQ_SEARCH. Optional, ANDed, and applied to the
        // anchored set -- never to the graph. An empty sequence or an empty
        // string means *unfiltered* for that field, so a SEARCH with an anchor
        // and no filters is "everything in this scope", which is the FRAGMENT
        // or NEIGHBOURS read with a cap.
        //
        // **The anchor is mandatory and has no default.** A SEARCH carrying
        // neither `client` nor `from` is SIS_GQ_REJECTED, and is not treated as
        // "everywhere". This is the single most important sentence here: an
        // unanchored search IS the whole-graph read this service refuses, and a
        // default that widens to the graph is how one arrives without anyone
        // deciding to add it. The anchor is also the only thing that bounds the
        // work -- none of the properties filtered on below is indexed, so every
        // filter is a post-filter over an already-loaded set.
        //
        // The search anchor is one hop. A hop bound of two from a
        // well-connected global node is already most of the region, so a bound
        // that appears to bound does not; there is no field for it.
        //
        // What is deliberately absent, each for a stated reason:
        //
        //   no regex, glob or substring -- unbounded, unservable by any index,
        //     and a glob over an identifier alphabet is one `*` away from
        //     matching everything, which is the unanchored search again;
        //   no top-level negation -- "every edge that is NOT calibrated" reads
        //     as a filter and behaves as a scan. Negation *inside*
        //     `temporal_type` is fine: the set is finite, so spell the wanted
        //     variants out;
        //   no sort key -- sorting means materialising the whole candidate set
        //     before the first page, which defeats the cursor and turns a
        //     bounded read into an unbounded one with a small reply. The cursor
        //     and a sort order are the same mechanism and there can be one;
        //   no cross-fragment aggregation -- "every uncalibrated edge
        //     everywhere" is a real question, and it is the operator's, not a
        //     client's. It is unbounded, and it does not belong on a key
        //     prefixed by one client's id.

        // Which temporal types to keep, as a set. Empty keeps all of them.
        //
        // The reason search exists. { SRG_EDGE_STATIC_UNCALIBRATED } is the
        // work queue an external calibration tool reads -- both ends known,
        // their relation not yet measured -- and a set rather than one value is
        // what makes "not usable yet" and "measured somehow" one round trip
        // each instead of one per variant.
        sequence<tcnart_msgs::msg::SREdgeTemporalType> temporal_type;

        // Which node scopes to keep, as a set. Empty keeps both.
        //
        // "Which of my nodes are shared with other fragments?" is the second
        // question a fragment author asks, and usually the answer to why their
        // relation does not resolve: only a global node joins two graphs.
        sequence<tcnart_msgs::msg::SRNodeScope> scope;

        // Which node types to keep, as a set. Empty keeps all of them.
        sequence<tcnart_msgs::msg::SRNodeType> node_type;

        // Keep names beginning with this. A prefix, and nothing more -- not a
        // pattern, not an expression. Matched against SRNode.name and
        // SREdge.name. Empty keeps everything.
        //
        // A prefix is enough because the composed names this project generates
        // are all prefixes: a materialized marker and an engine-derived edge
        // are each distinguishable from a client's own declaration by their
        // leading text alone. It needs no new validation rule either -- every
        // prefix of a valid identifier is itself a valid identifier -- so this
        // introduces no second alphabet.
        string name_prefix;

        // --- B64 ----------------------------------------------------------
        // Read only for SIS_GQ_PATH; ignored, not refused, by every other
        // kind.

        // Which rule to walk by. This field is what un-reserved SIS_GQ_PATH:
        // a path read that does not say which predicate it used produces an
        // answer that disagrees with a stream start using the other one, and
        // the disagreement reads as an engine bug.
        SISPathPredicate predicate;

        // Hops from either named frame that the walk may consider. 0 asks for
        // the engine's default; the engine's own cap is a ceiling this may
        // only lower.
        //
        // This is the other half of the old refusal. A path read over "the
        // graph" is the unbounded read this service exists not to serve; a
        // path read within a stated radius is bounded before it starts, and
        // the reply says whether the radius stopped it.
        uint32 radius;

    };

    enum SISGraphQueryStatus {
        SIS_GQ_OK,              // answered. A search matching nothing is OK
                                //   with empty sequences, never an UNKNOWN_*:
                                //   "no uncalibrated edges" is the SUCCESS of a
                                //   calibration sweep -- it is what a finished
                                //   deployment looks like -- and a tool obliged
                                //   to treat it as an error will end up
                                //   treating a real error as normal
        SIS_GQ_UNKNOWN_CLIENT,  // the named fragment does not exist
        SIS_GQ_UNKNOWN_FRAME,   // the anchored node does not exist
        SIS_GQ_TRUNCATED,       // a page came back and `next_cursor` is not
                                //   empty. A distinct status, not an inference
                                //   from the cursor, so a client that ignores
                                //   paging can still see from the status alone
                                //   that it did not get everything
        SIS_GQ_REJECTED,        // malformed, undecodable, or a SEARCH with no
                                //   anchor
        SIS_GQ_UNAVAILABLE      // the read failed, timed out, or was refused by
                                //   the per-client rate limit. `detail` says
                                //   which. A read is not a subscription: a
                                //   client that polls this key is the failure
                                //   mode this status exists to report
    };

    // `status` first, for SISMutationReply's reason.
    //
    // Nodes and edges rather than an SRGraph: an SRGraph names one owning
    // client and one origin, and a reply may span fragments and has no origin
    // at all. The two sequences are also independently paged, which a graph
    // could not express.
    struct SISGraphQueryReply {
        SISGraphQueryStatus status;
        sequence<tcnart_msgs::msg::SRNodeView> nodes;
        sequence<tcnart_msgs::msg::SREdgeView> edges;

        // Empty when the reply is complete. Pass it back verbatim in
        // `SISGraphQueryRequest.cursor` for the next page, with every other
        // field unchanged.
        string next_cursor;

        // Human-readable; may be empty. On UNAVAILABLE this is where a rate
        // limit says so, and on REJECTED it is where a missing anchor does.
        string detail;

        // --- B64 ----------------------------------------------------------
        // SIS_GQ_PATH only. The relations connecting `from` to `to` under
        // `predicate`, in walk order, by declared name. Empty when there is
        // no such path -- which is an SIS_GQ_OK answer, not a rejection:
        // "these frames are not connected" is a true and useful reply.
        //
        // `nodes` and `edges` above carry the same path as views, for a caller
        // that wants the values rather than the route.
        sequence<string> path;

        // SIS_GQ_PATH only. True when the walk stopped at `radius` with the
        // target still unreached -- so an empty `path` means "not within the
        // radius you asked for" rather than "not connected". Two different
        // answers, and a caller that cannot tell them apart will widen the
        // radius forever or give up too early.
        boolean radius_exhausted;
    };

    // ======================================================================
    // B63: pattern query -- "how could this edge be produced?"
    // ======================================================================
    //
    // Sent to {client_id}/sis/pattern/query.
    //
    // A NEW KEY, and not a fifth SISGraphQueryKind. The request above argues
    // for one key on the grounds that four keys mean four rate-limit buckets,
    // and that argument is respected rather than overturned: this key shares
    // the graph read's bucket, because it is the same cost against the same
    // database. What it does not share is the reply SHAPE -- a pattern
    // instance is bound roles, bound path segments, an expansion kind and a
    // measurement count, none of which belongs in a reply otherwise made of
    // nodes and edges.
    //
    // The model is Pustka, Huber, Bauer & Klinker, "Spatial Relationship
    // Patterns": a pattern is a small graph over roles, some edges inputs
    // that must exist and some outputs its algorithm produces, applied only
    // in an EXPANDED form -- several instances at one instant, or one
    // instance over several instants.

    // How a pattern was expanded to fit the graph. A pattern is never applied
    // unexpanded, so there is no third value meaning "as declared".
    enum SRPatternExpansion {
        SIS_PX_SPACE,           // several instances at one instant: three
                                //   markers on a rigid body, seen together
        SIS_PX_TIME             // one instance at several instants: one marker
                                //   moved through the volume. Preferred where
                                //   both are possible -- integrating over time
                                //   is more accurate than one snapshot
    };

    // One role of the pattern, bound to a real frame.
    struct SISPatternRole {
        string role;            // the pattern's own name for it: "camera"
        SISFrameRef frame;      // what it was bound to
    };

    // One hop of a bound input.
    //
    // Self-contained on purpose: everything needed to subscribe to this hop
    // and to place it in a pipeline, so a caller never has to ask again. A
    // calibration tool composes these itself rather than asking the engine for
    // a relation stream, because a correspondence relates k measurements at
    // ONE instant and two streams have two independent triggers.
    struct SISPatternSegment {
        string relation;                // the declared relation name
        SISFrameRef from;
        SISFrameRef to;
        boolean inverted;               // walked against its declared direction
        boolean dynamic;
        string stream_topic;            // non-empty exactly when dynamic
        uint32 stream_item_id;          // meaningful only with
                                        //   stream_item_bound, at the end of
                                        //   this struct
        tcnart_msgs::msg::SRTransform transform;  // the static value, or a seed
        boolean computed;               // derived from other edges rather than
                                        //   measured. Usable, and ranked below
                                        //   a raw hop: a computed value was
                                        //   already interpolated once, at its
                                        //   own producer's instants

        // --- B68 -----------------------------------------------------------
        // What a subscriber needs to read this hop the way the engine reads
        // it, and cannot obtain for itself.
        //
        // Both come from the stream's descriptor, and a descriptor is
        // published ONCE. A consumer that joins later never sees one: there is
        // nothing to subscribe to and nothing to query. The engine read it at
        // adoption and is the only party still holding it, so a reply that
        // omitted these left a caller with no way to get them at all.
        //
        // sensor_latency_ns: nanoseconds between the measurement and the
        // header stamp. A sample stamped T was measured at T - latency, and
        // the engine subtracts it on ingest. A consumer that skipped it would
        // interpolate every hop to instants that disagree with every engine
        // stream by a constant -- invisible while everything is still, which
        // is why a discrete calibration survived without this, and wrong the
        // moment anything moves. 0 means unstated.
        //
        // frame_rate: this hop's declared rate in Hz, 0 when unstated. Rolled
        // up per input into SISPatternInput::frame_rate, which is what a
        // session picks its reference input by; without it every session fell
        // back to its FIRST input rather than its slowest, and interpolating
        // toward the sparser signal is always the larger invention.
        int64 sensor_latency_ns;
        double frame_rate;

        // --- B72 ---------------------------------------------------------
        // Whether `stream_item_id` above binds this hop to one entry. The
        // same fact SREdge::stream_item_bound carries, and it has to travel
        // with the segment because a caller composing hops itself never sees
        // the edge -- the calibration tool builds its whole rig from these
        // and nothing else.
        //
        // Inferring it from a non-zero id does not work, and this field
        // exists because that was tried: entry 0 is a real entry, so `!= 0`
        // treats a hop bound to marker 0 as unbound and hands it every entry
        // on the topic. A caller routing entries itself must route on this
        // flag; treating unbound as "entry 0" drops every other entry on a
        // multi-entry topic.
        //
        // Appended last, for the reason SREdge::stream_item_bound documents.
        boolean stream_item_bound;
    };

    // One input of the pattern, bound to a concrete realisation.
    struct SISPatternInput {
        string role_from;
        string role_to;

        // The relations realising this input, in order. One entry is a single
        // declared edge; more is a composed path, and composing it is the
        // caller's -- which is what the basic inversion and concatenation
        // patterns are, applied implicitly.
        sequence<SISPatternSegment> segments;

        SISFrameRef observer;
        SISFrameRef target;

        // Slowest declared rate along this input's path, in Hz; 0 when no hop
        // declares one.
        //
        // What a session picks its REFERENCE INPUT by. A correspondence spans
        // several inputs and needs one instant; the reference supplies it and
        // the others are interpolated to it. The slowest is the safe default:
        // interpolating a 200 Hz stream to 30 Hz instants spans at most 5 ms,
        // while the reverse spans up to 33 ms, and interpolating toward the
        // sparser signal is always the larger invention.
        double frame_rate;
    };

    // --- B67 ---------------------------------------------------------------
    // One duplicate's realisation of one input, in a space expansion.
    //
    // A space expansion IS its duplicates. Absolute orientation over three
    // surveyed landmarks is three correspondences at one instant, one per
    // landmark, and a consumer needs a pipeline per landmark per input to
    // evaluate them.
    //
    // 0.6.0 carried the duplicated ROLES and nothing else, which the matcher
    // had already resolved to paths and then discarded. A consumer could
    // compile only the base binding, so a session over three landmarks would
    // have been a calibration from one of them -- determined, plausible, and
    // wrong. A tool that noticed refused the candidate outright, which is
    // correct and is not what anyone wants.
    //
    // FLAT, AND TAGGED BY DUPLICATE, rather than a sequence of inputs nested
    // inside a sequence of duplicates. Two reasons, and the second is a hard
    // one:
    //
    //  - it keeps space_instances meaning what it meant, so this is an
    //    APPEND rather than a change in the middle of SISPatternInstance;
    //  - a fourth level of nested unbounded sequences (reply -> instances ->
    //    duplicates -> inputs -> segments) overflows the uint32 the IDL
    //    generator computes a worst-case CDR size into. That is not a style
    //    preference; the generated code does not compile.
    struct SISPatternExpansionInput {
        // Which duplicate this input belongs to: an index into
        // SISPatternInstance::space_instances.
        //
        // One index and not a set of role bindings, because exactly one role
        // of a pattern is expandable -- a matcher that met two would have to
        // pair their duplicates, and no catalogue entry asks for that. So each
        // entry of space_instances IS one duplicate, and indexing it is
        // unambiguous.
        uint32 instance;

        // Which of the pattern's inputs this realises: an index into
        // SISPatternInstance::inputs. Only the correspondence inputs appear
        // here; the others are shared across every duplicate and are already
        // bound once on the instance.
        uint32 input;

        // This duplicate's own path for that input.
        SISPatternInput binding;
    };

    struct SISPatternInstance {
        string pattern;                 // catalogue name: "hand_eye"
        string method;                  // the estimator this needs
        sequence<SISPatternRole> roles;
        sequence<SISPatternInput> inputs;

        SRPatternExpansion expansion;

        // For SIS_PX_SPACE: the duplicates FOUND in the graph, one entry per
        // duplicate, each naming its own binding of the expandable role. Empty
        // for SIS_PX_TIME, where the edges are the same on every measurement.
        //
        // Found, not assumed: three point correspondences for absolute
        // orientation are three nodes each observed by both frames, and a
        // graph holding one marker supports no space expansion however often
        // it is asked.
        //
        // These NAME the duplicates; space_inputs below is what makes them
        // runnable. Both are required for a space expansion and a reply
        // carrying only the first is one a consumer must refuse (B67).
        sequence<SISPatternRole> space_instances;

        uint32 min_measurements;        // what the estimator needs
        uint32 max_measurements;        // 0 when unbounded

        // The engine's own ordering, ascending, best first: computed hops
        // dominate, then hop count, then any stated covariance.
        //
        // AN OPINION, NOT AN AUTHORITY. Which of several solutions is best is
        // left open by the paper this implements, and is left open here.
        double cost;

        // --- B67 -----------------------------------------------------------
        // Every duplicate's own path for every correspondence input, tagged by
        // which duplicate and which input it realises.
        //
        // Empty for SIS_PX_TIME. For SIS_PX_SPACE this is what makes the
        // expansion runnable: space_instances names the duplicates and this
        // says how to evaluate each one. A consumer that finds space_instances
        // non-empty and this empty is talking to a pre-0.7.0 engine and should
        // refuse the candidate rather than estimate from the base binding
        // alone -- see SISPatternExpansionInput.
        sequence<SISPatternExpansionInput> space_inputs;
    };

    struct SISPatternQueryRequest {

        // The edge to be produced. Both frames must exist; the edge need not,
        // and normally does not -- that is the point.
        SISFrameRef from;
        SISFrameRef to;

        // What kind of relation is wanted. Patterns are matched against their
        // OUTPUTS: a caller does not choose a method, it states a result, and
        // the methods that produce that result are what come back.
        tcnart_msgs::msg::SRTransformType wanted;

        // Hops from either named frame. 0 asks for the engine's default.
        uint32 radius;

        // Empty considers every pattern the engine knows.
        sequence<string> only_patterns;

        // 0 asks for the engine's default.
        uint32 max_candidates;
    };

    struct SISPatternQueryReply {
        // The graph read's vocabulary, reused: the refusals are identical --
        // rate limited, unknown frame, malformed request -- and a second enum
        // saying the same things in different words would be one more thing to
        // keep in step.
        SISGraphQueryStatus status;

        // Ordered best-first by SISPatternInstance.cost. EMPTY IS AN ANSWER,
        // and an SIS_GQ_OK one: "nothing in this graph produces that edge" is
        // what an under-instrumented setup looks like, and it is the reply
        // that tells an operator to add a landmark or a marker rather than to
        // retry.
        sequence<SISPatternInstance> instances;

        string detail;
    };

  };
};

#endif
