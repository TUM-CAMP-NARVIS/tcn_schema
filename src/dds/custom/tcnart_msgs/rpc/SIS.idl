#ifndef TCNART_RPC_SIS
#define TCNART_RPC_SIS

#include "tcnart_msgs/msg/Types.idl"
#include "tcnart_msgs/msg/SpatialRelations.idl"
#include "tcnart_msgs/rpc/Requests.idl"

// The Spatial Information Service.
//
// These are thin RPC envelopes over the spatial relationship graph defined in
// tcnart_msgs/msg/SpatialRelations.idl. The graph is the model; nothing here
// re-describes it.

module tcnart_msgs {
  module rpc {

    // --- graph lifecycle ---------------------------------------------------

    // Announce a client and its whole graph at once. Refused if the client
    // already exists, or if the graph's origin is not among its nodes.
    struct SISJoinRequest {
        tcnart_msgs::msg::SRGraph graph;
    };

    // Announce departure. Without this a client is only collected after the
    // inactivity timeout.
    struct SISLeaveRequest {
        string client;
    };

    struct SISNodeUpdateRequest {
        tcnart_msgs::msg::SRNode node;
    };

    // Refused for the graph's origin node.
    struct SISNodeRemoveRequest {
        string name;
    };

    struct SISEdgeUpdateRequest {
        tcnart_msgs::msg::SREdge edge;
    };

    // Removes exactly the named edge, not every edge between its endpoints.
    struct SISEdgeRemoveRequest {
        string name;
    };

    // --- topic translation -------------------------------------------------

    struct SISFrameRef {
        string client;                  // the owning graph
        string node;                    // SRNode.name within it
    };

    enum SISEndpointKind {
        SIS_ENDPOINT_FRAME,             // translate into or out of this frame
        SIS_ENDPOINT_RAW                // pass through untransformed
    };

    union SISEndpoint switch(SISEndpointKind) {
    case SIS_ENDPOINT_FRAME:
        SISFrameRef frame;
    case SIS_ENDPOINT_RAW:
        boolean unused;
    };

    // Republish a pose stream from one frame of reference into another.
    // Both endpoints SIS_ENDPOINT_RAW is a plain topic-to-topic relay.
    struct SISTopicTranslationStartRequest {
        string src_topic;
        string dst_topic;
        SISEndpoint src;
        SISEndpoint dst;
    };

    struct SISTopicTranslationStopRequest {
        string src_topic;
        string dst_topic;
    };

    enum SISTopicTranslationStatus {
        SIS_TT_ACTIVE,                  // running
        SIS_TT_INACTIVE,                // not running; stopped, or never started
        SIS_TT_NO_PATH,                 // the graph does not connect these two frames
        SIS_TT_UNKNOWN_FRAME,           // a named client or node does not exist
        SIS_TT_CLOCK_DOMAIN_MISMATCH,   // the path crosses unsynchronized clocks
        SIS_TT_REJECTED                 // malformed request
    };

  };
};

#endif
