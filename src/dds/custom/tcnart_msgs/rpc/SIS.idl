#ifndef TCNART_RPC_SIS
#define TCNART_RPC_SIS

#include "tcnart_msgs/msg/Types.idl"
#include "tcnart_msgs/msg/SpatialRelations.idl"
#include "tcnart_msgs/rpc/Requests.idl"

// The Spatial Information Service.
//
// These are thin RPC envelopes over the spatial relationship graph defined in
// tcnart_msgs/msg/SpatialRelations.idl. The graph is the model; nothing here
// re-describes it.

module tcnart_msgs {
  module rpc {

    // --- graph lifecycle ---------------------------------------------------

    // Announce a client and its whole graph at once. Refused if the client
    // already exists, or if the graph's origin is not among its nodes.
    struct SISJoinRequest {
        tcnart_msgs::msg::SRGraph graph;
    };

    // Announce departure. Without this a client is only collected after the
    // inactivity timeout.
    struct SISLeaveRequest {
        string client;
    };

    struct SISNodeUpdateRequest {
        tcnart_msgs::msg::SRNode node;
    };

    // Refused for the graph's origin node.
    struct SISNodeRemoveRequest {
        string name;
    };

    struct SISEdgeUpdateRequest {
        tcnart_msgs::msg::SREdge edge;
    };

    // Removes exactly the named edge, not every edge between its endpoints.
    struct SISEdgeRemoveRequest {
        string name;
    };

    // --- relation streams -------------------------------------------------

    // A frame of reference: a node within an owning graph.
    struct SISFrameRef {
        string client;                  // owning graph
        string node;                    // SRNode.name within it
    };

    enum SRStreamTriggerKind {
        SRG_TRIGGER_FIXED_RATE,         // a timer; sample at "now"
        SRG_TRIGGER_ON_STREAM,          // a named stream; sample at its stamp
        SRG_TRIGGER_ON_ANY              // any input on the path; sample at the arriving stamp
    };

    // When a relation stream is evaluated, and therefore at which instant every
    // edge on the path is sampled. The three differ in more than rate: a fixed
    // rate extrapolates every edge to the present, while a stream trigger
    // interpolates the others to the master's timestamp.
    union SRStreamTrigger switch(SRStreamTriggerKind) {
    case SRG_TRIGGER_FIXED_RATE:
        double hz;
    case SRG_TRIGGER_ON_STREAM:
        string topic;
    case SRG_TRIGGER_ON_ANY:
        boolean unused;
    };

    // Publish the spatial relation between two frames as a stream.
    //
    // This replaces topic translation. What a consumer wants is not a copy of
    // some pose stream re-expressed, but the answer to "where is target, as seen
    // from observer, at this instant" -- which the engine resolves through the
    // unified graph. The path may cross tracked edges, static edges, calibrated
    // edges, and several clients' graphs; it may also be entirely static, which
    // topic translation could not express at all.
    //
    // If `target` names a template node, the stream carries one entry per
    // instance materialized from it -- "every ArUco marker this camera sees, in
    // the headset's frame" -- observed at one instant, in one message.
    //
    // The client asks *what* relation it wants, not *where* to put it: there is
    // no output_topic here. 0.3.0's third field is gone, and the engine answers
    // with the topic it assigned (SISRelationStreamReply, below). Field order is
    // now: observer, target, trigger, freshness_bias.
    struct SISRelationStreamStartRequest {
        SISFrameRef observer;           // the frame poses are expressed in
        SISFrameRef target;             // the frame being located
        SRStreamTrigger trigger;

        // How much this consumer prefers freshness over reuse, in [0, 1].
        //
        // A relation already computed by another stream is available as a
        // derived edge weighted below the path it replaces, so it is normally
        // preferred: fewer hops, less work. But it is strictly staler by one
        // publish-ingest-buffer round, which a render loop will never notice
        // and a latency-sensitive alignment might.
        //
        // 0 takes every shortcut available. 1 ignores derived edges entirely
        // and walks only measured relations. Values between move a derived
        // edge's effective weight toward the path it replaced. Applied when the
        // stream is compiled, so no weight changes at runtime and no path is
        // recompiled because a number drifted.
        double freshness_bias;
    };

    // Stops the stream named by the handle the engine issued in
    // SISRelationStreamReply.handle. Renamed from 0.3.0's `output_topic` on
    // purpose: the value is no longer a topic the client chose, and a rename
    // turns a peer that keeps supplying its own into a compile error instead of
    // a request that decodes cleanly and stops nothing.
    struct SISRelationStreamStopRequest {
        string handle;
    };

    enum SISRelationStreamStatus {
        SIS_RS_ACTIVE,                  // running
        SIS_RS_INACTIVE,                // not running; stopped, or never started
        SIS_RS_NO_PATH,                 // the graph does not connect these two frames
        SIS_RS_UNKNOWN_FRAME,           // a named client or node does not exist
        SIS_RS_CLOCK_DOMAIN_MISMATCH,   // the path crosses unsynchronized clocks
        SIS_RS_REJECTED,                // malformed request
        SIS_RS_PENDING                  // accepted, but not yet producing: a frame on the
                                         // path was withdrawn and is not pinned, or an edge
                                         // on it is not calibrated yet. Re-evaluated on every
                                         // graph mutation and resumes on its own once the
                                         // missing part arrives — the client does nothing.
                                         // Distinct from SIS_RS_NO_PATH, which means the
                                         // frames are not connectable at all and the request
                                         // is refused. Appended last so existing ordinals
                                         // hold.
    };

    // Whether a reply carries a handle at all.
    //
    // A refusal has no stream to name, and an empty string standing in for
    // "absent" is exactly the plausible default this project has been bitten by
    // before: it is a legal topic-shaped value that every consumer would have to
    // remember to special-case. A discriminated union makes absence a case the
    // decoder has to handle.
    enum SISRelationStreamHandleKind {
        SIS_RSH_NONE,                   // no stream to consume, and so no handle
        SIS_RSH_ASSIGNED                // the engine assigned this handle
    };

    // Carries a filler `boolean` in the NONE case because IDL requires every
    // union case to declare a member -- the same reason SRStreamTrigger's
    // SRG_TRIGGER_ON_ANY carries one.
    union SISRelationStreamHandle switch(SISRelationStreamHandleKind) {
    case SIS_RSH_NONE:
        boolean unused;
    case SIS_RSH_ASSIGNED:
        string topic;
    };

    // The answer to SISRelationStreamStartRequest and
    // SISRelationStreamStopRequest. 0.3.0 replied with a bare
    // SISRelationStreamStatus; the handle is what a client now needs to
    // subscribe to anything at all, because it no longer chose the topic.
    //
    // The handle is ASSIGNED exactly when the status is SIS_RS_ACTIVE or
    // SIS_RS_PENDING -- the two statuses that mean "there is a stream on this
    // topic for you". Every other status (including SIS_RS_INACTIVE, the answer
    // to a stop) is NONE.
    //
    // The assigned topic is "sqe/{engine_id}/rel/{handle}"; its status
    // notifications are on "{topic}/status" and its stream descriptor on
    // "sqe/{engine_id}/cfg/desc/{handle}". Treat all three as opaque: read them
    // from this reply rather than recomputing them.
    struct SISRelationStreamReply {
        SISRelationStreamStatus status;
        SISRelationStreamHandle handle;
    };

    // Published on "{output_topic}/status" when a stream's status changes.
    //
    // A consumer otherwise cannot tell "the engine says there is no path" from
    // "the engine died", and only the first is recoverable by waiting.
    // `output_topic` now carries the engine-issued handle from
    // SISRelationStreamReply, not a topic the client picked. The field name and
    // its position are unchanged, so this struct's wire layout is untouched.
    struct SISRelationStreamStatusNotification {
        string output_topic;
        SISRelationStreamStatus status;
        string detail;                  // human-readable reason; may be empty
    };

  };
};

#endif
