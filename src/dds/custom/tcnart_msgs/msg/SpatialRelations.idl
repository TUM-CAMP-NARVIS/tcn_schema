#ifndef TCNART_MSG_SRG
#define TCNART_MSG_SRG

#include "builtin_interfaces/msg/Time_.idl"
#include "tcnart_msgs/msg/Types.idl"

module tcnart_msgs {
  module msg {

        // --- coordinate conventions ------------------------------------------

        // Which signed axis plays each of the three roles. 6 x 4 x 2 = 48 valid
        // assignments; anything reusing an axis is degenerate.
        enum CoordinateAxis {
            COORD_AXIS_X_POS,
            COORD_AXIS_X_NEG,
            COORD_AXIS_Y_POS,
            COORD_AXIS_Y_NEG,
            COORD_AXIS_Z_POS,
            COORD_AXIS_Z_NEG
        };

        struct CoordinateSystem {
            CoordinateAxis forward;
            CoordinateAxis right;
            CoordinateAxis up;
            uint8 dimensions;             // 2 or 3
        };

        // --- nodes -------------------------------------------------------------

        enum SRNodeType {
          SRG_NODE_GENERIC,
          SRG_NODE_SENSOR,
          SRG_NODE_DISPLAY,
          SRG_NODE_TRACKABLE,
          SRG_NODE_CONTENT
        };

        // Local nodes are private to their graph and are namespaced with the
        // owner's prefix when two graphs are fused. Global nodes keep their bare
        // name and are the only thing that joins two graphs together.
        enum SRNodeScope {
          SRG_SCOPE_LOCAL,
          SRG_SCOPE_GLOBAL
        };

        // --- templates ---------------------------------------------------------

        // A blueprint for entities that are not known when the graph is announced.
        //
        // A client usually cannot know which ArUco ids are in the room, or which
        // instruments will be brought in. A template node stands for "an entity of
        // this kind, not yet identified". It is never traversed itself. When an
        // observation matches its rule, the template node and every edge attached
        // to it are materialized into concrete copies carrying the observed id.
        struct SRNodeTemplate {

            // What kind of observation materializes this template.
            MarkerType marker_type;

            // Ids that match. Empty means any id an observer reports.
            sequence<uint32> match_ids;

            // Name given to a materialized node. "{id}" is substituted with the
            // observed id, so "aruco_{id}" produces "aruco_7".
            string instance_name_pattern;

        };

        struct SRNode {

            // Identity within the graph. Edges reference nodes by this.
            string name;

            SRNodeType node_type;
            SRNodeScope scope;

            // The convention this node's data is expressed in.
            CoordinateSystem coord;

            // Inactive nodes are not traversed when resolving a path.
            boolean active;

            // Stable identity across sessions; all-zero when unused.
            UUID uuid;

            // Non-empty: this node's device announces its streams on this topic.
            string stream_descriptor_topic;

            // Survives fragment retraction. Set by whatever created the node
            // outside a fragment's lifecycle -- a surveyed fiducial, a
            // calibrated rig. The engine never sets this; it only honours it,
            // so no tool needs the engine's permission to keep its own data.
            boolean pinned;

            // 0 or 1 entries. Non-empty makes this node a blueprint rather than a
            // frame of reference: it is never traversed, and observations matching
            // its rule materialize concrete copies of it.
            sequence<SRNodeTemplate> node_template;

            // Non-empty on a materialized node: the template node it came from.
            // Removing a template retires everything it materialized.
            string materialized_from;

            // The observed id that matched. Meaningful only when
            // materialized_from is non-empty.
            uint32 materialized_id;

            // Opaque, application-defined.
            string custom_data;

        };

        // --- edges -------------------------------------------------------------

        // Two different unknowns are expressible here. A template node covers
        // "which entity is this?"; SRG_EDGE_STATIC_UNCALIBRATED covers "both ends
        // are known, but their relation has not been measured yet" -- which is the
        // work queue an external calibration tool reads.
        enum SREdgeTemporalType {
          SRG_EDGE_STATIC,              // fixed by construction or declaration
          SRG_EDGE_STATIC_UNCALIBRATED, // declared; value not yet measured, not traversable
          SRG_EDGE_STATIC_CALIBRATED,   // fixed, and measured; carries provenance
          SRG_EDGE_DYNAMIC,             // supplied live by a tracker
          SRG_EDGE_DYNAMIC_INFERRED,    // derived from other edges, not measured directly

          // A projection into an image plane: camera -> image_plane, where the
          // image plane is its own node. Appended, since 0..4 are taken.
          //
          // Its own temporal value rather than a flag because it changes what a
          // path *is*: a projection may only be a path's LAST hop, and after it
          // the composed value is a 2D image point, not a transform. There is
          // no inverse -- inverting one would invent the depth it discarded --
          // so a path never walks it backwards either.
          //
          // A projection whose intrinsics change (a zoom lens) is this too. The
          // camera *moving* is the ordinary pose edge before it, not this.
          SRG_EDGE_PROJECTION
        };

        // A pose and how well it is known.
        //
        // `covariance` is 0 or 21 doubles: the upper triangle of the 6x6,
        // row-major, ordered (tx, ty, tz, rx, ry, rz) -- translation first --
        // with m^2 on the translational block and rad^2 on the rotational one.
        // Empty means "not stated", which is different from a zero covariance
        // meaning "known exactly".
        //
        // The triangle rather than all 36 makes an asymmetric matrix
        // unrepresentable, which is the failure that otherwise surfaces as a
        // Cholesky decomposition failing far from whatever produced it. Same
        // packing as every other covariance in this schema (see
        // RigidTransformMapItem::pose_covariance): one packing, one unpacking,
        // one place to get it wrong.
        //
        // The convention is stated here because it is not inferable from the
        // type: a 6x6 says nothing about which three of its axes are the
        // translation.
        struct SRPose6DWithCovariance {
            RigidTransform pose;
            sequence<double, 21> covariance;
        };

        // A translation and its 3x3, packed as 0 or 6 doubles -- the upper
        // triangle, row-major, in m^2.
        struct SRTranslation3DWithCovariance {
            Vector3 translation;
            sequence<double, 6> covariance;
        };

        // A camera's internal geometry. Intrinsics ONLY -- the camera's
        // extrinsics are the ordinary pose edge BEFORE the projection edge, so
        // a camera that moves is a dynamic pose edge like any tracked thing and
        // needs no second mechanism. Extrinsic calibration writes the pose
        // edge, intrinsic calibration writes this, and neither can drift from
        // the other because there is only one copy of each fact.
        struct SRIntrinsics {
            double fx; double fy;
            double cx; double cy;

            // Which model the coefficients belong to. An empty string is an
            // ideal pinhole -- stated, not defaulted, so "nobody calibrated
            // this lens" and "this lens is rectilinear" stay distinguishable.
            //
            // "opencv_radtan" is Brown-Conrady, which is what OpenCV, Kalibr,
            // COLMAP and every ART/NDI calibration report emit for an ordinary
            // lens under three different names.
            string distortion_model;          // "" | "opencv_radtan" | "opencv_fisheye"

            // Coefficients in the model's own order: radtan is k1 k2 p1 p2 [k3]
            // (OpenCV's distCoeffs order), fisheye is k1..k4. A length the model
            // does not expect reads as "not stated" rather than being
            // truncated, for the reason a wrong-length covariance does.
            sequence<double, 8> distortion;

            // Pixels; 0 means unknown, which is what "nothing bounds-checks
            // this" is.
            uint32 image_w; uint32 image_h;
        };

        // A point in an image plane, in pixels. The result of a projection,
        // never a declared relation: nothing composes onto it, because the
        // projection that produced it discarded the depth a further hop needs.
        struct SRPoint2D {
            double u; double v;

            // How well (u, v) is known: 0 or 3 doubles, the upper triangle of
            // the 2x2 in row-major order, in px^2. Empty means "not stated".
            sequence<double, 3> covariance;
        };

        enum SRTransformType {
          SRG_TRANSFORM_POSE6D,
          SRG_TRANSFORM_TRANSLATION3D,

          // Each of the following is APPENDED, never inserted. CDR is
          // positional and a union's discriminant is its first four bytes, so
          // renumbering an existing case makes an un-rebuilt publisher misread
          // rather than fail.
          SRG_TRANSFORM_POSE6D_COV,
          SRG_TRANSFORM_TRANSLATION3D_COV,
          SRG_TRANSFORM_PROJECTION,
          SRG_TRANSFORM_POINT2D
        };

        union SRTransform switch(SRTransformType) {
        case SRG_TRANSFORM_POSE6D:
            RigidTransform pose6d;
        case SRG_TRANSFORM_TRANSLATION3D:
            Vector3 translation3d;

        // A pose and how well it is known. A separate case rather than a field
        // appended to SRG_TRANSFORM_POSE6D, because appending to an existing
        // case makes an un-rebuilt publisher misread rather than fail.
        case SRG_TRANSFORM_POSE6D_COV:
            SRPose6DWithCovariance pose6d_cov;

        case SRG_TRANSFORM_TRANSLATION3D_COV:
            SRTranslation3DWithCovariance translation3d_cov;

        // The intrinsics of a projection edge. No pose -- see SRIntrinsics.
        case SRG_TRANSFORM_PROJECTION:
            SRIntrinsics projection;

        // A composed result, carried where a transform would otherwise be:
        // what a path ending in a projection resolves to.
        case SRG_TRANSFORM_POINT2D:
            SRPoint2D point2d;
        };

        struct SRCalibration {
            string method;                    // free-form: "hand-eye", "aruco-board", ...
            double residual;                  // RMS error in metres; negative if not reported
            builtin_interfaces::msg::Time computed_at;

            // The full uncertainty of the calibrated edge, of which `residual`
            // is one scalar summary: 0 or 21 doubles, upper triangle of the
            // 6x6, row-major, (tx, ty, tz, rx, ry, rz), m^2/rad^2.
            //
            // Both are kept. `residual` is what a human reads first and is what
            // this schema has always promised; the covariance is what a
            // consumer propagating uncertainty through a chain actually needs.
            // Appended, because CDR is positional.
            sequence<double, 21> covariance;
        };

        struct SREdge {

            // Identity within the graph. Parallel edges between the same pair of
            // nodes are legal and are distinguished by this.
            string name;

            string source;                    // SRNode.name
            string target;                    // SRNode.name

            SREdgeTemporalType temporal_type;

            // The static value, or a dynamic edge's seed.
            SRTransform transform;

            // Traversal cost. Lower is preferred; a path minimises the sum.
            double weight;

            // Whether a path may walk this relation backwards by composing its
            // inverse. True for a rigid transform, which is what makes the graph
            // effectively bidirectional: one declaration of source -> target is
            // enough to resolve an optimal path in either direction. False for a
            // relation that discards information -- a projection into an image
            // plane has no inverse to compose, and pathfinding routes around it
            // rather than through it backwards.
            boolean is_invertible;

            // Dynamic edges: where this edge's live value comes from.
            string stream_descriptor_topic;

            // 0 or 1 entries; populated for SRG_EDGE_STATIC_CALIBRATED.
            sequence<SRCalibration> calibration;

            // Non-empty on a materialized edge: the template node whose
            // materialization created it.
            string materialized_from;

            // Non-empty on a *derived* edge -- one published by a relation
            // stream rather than declared by a client. Names every edge the
            // stream's path walked.
            //
            // This is not bookkeeping. A derived edge is weighted below the
            // path it replaces so that pathfinding prefers it, which means
            // pathfinding actively steers into cycles: a stream asked to
            // recompute a relation it already publishes would route through its
            // own output. Compiling a stream excludes any derived edge that
            // transitively depends on the edge being compiled, and this list is
            // what makes that computable -- including after a restart, or by a
            // second engine reading the same graph.
            sequence<string> derived_from;

            // Which entry of a multi-pose tracker payload feeds this relation.
            //
            // A Pose6DMapMessage carries `item_id -> pose`, and a device that
            // reports many things at once -- a headset's two controllers, a
            // hand's joints -- sends them in one message. Without this the
            // engine cannot tell which entry belongs to which relation: every
            // entry is written into every claim on the topic, so N relations
            // and N entries is N*N writes and each buffer keeps whichever
            // arrived last. Silently.
            //
            // Appended last, and optional by convention: 0 means "unset", which
            // is what a single-entry tracker sends and what every peer written
            // before this field sends. Those keep today's behaviour exactly.
            //
            // The values are a contract between a publisher and the engine and
            // belong to neither, so they are named: see the XR_POSE_* constants
            // in PoseTracking.idl for the ones this project defines.
            uint32 stream_item_id;

        };

        // --- graph -------------------------------------------------------------

        struct SRGraph {

            string name;                      // the owning client's identifier
            string origin;                    // SRNode.name; the root of this graph

            sequence<SRNode> nodes;
            sequence<SREdge> edges;

        };

        // --- views: the graph as the engine holds it --------------------------

        // Everything above is a *declaration*: what a client asserts about its
        // own fragment. The two types below are the other direction -- what a
        // read of the engine's graph answers with -- and they exist because a
        // declaration is not addressable outside the fragment that made it.
        //
        // SRNode.name and SREdge.source/target are names *within one graph*.
        // That is sufficient while a message describes one client's own
        // fragment, which is all any of the types above ever do. A read is not
        // so confined: a node's neighbours may sit in another client's
        // fragment, and two clients may each declare a local node called
        // "camera". A view therefore carries the owning fragment alongside the
        // declaration, and the pair (client, name) is what identifies a frame
        // across the fused graph.
        //
        // The engine's own fusion key -- a bare name for a global node,
        // "{client}::{name}" for a local one -- is deliberately NOT what is
        // sent. It is an internal encoding, and a wire contract that obliged a
        // client to build or split such a string would break the moment the
        // encoding changed. Two fields cannot be mis-parsed.
        //
        // # What a view does and does not promise
        //
        // The embedded SRNode / SREdge is the declaration as stored, field for
        // field: every one of them persists, so a client reads back what it
        // wrote and may resubmit it unchanged (the write is an idempotent
        // upsert). Two things are still not round-trips, and both are
        // properties of the store rather than of this type:
        //
        //   * a relation carries one transform in one representation. Pushing
        //     a translation over a pose replaces it, rotation included, and a
        //     view reports what is stored, not what was last sent.
        //   * a relation whose stored representation is ambiguous -- both a
        //     6D and a 3D row, neither strictly newer -- reads back as
        //     SRG_EDGE_STATIC_UNCALIBRATED with no transform, which is what
        //     the engine itself sees. That is a truthful report of an
        //     ambiguous row, not a report that the client declared it so.
        //
        // A view is never a template for a mutation the engine promises to
        // reproduce; it is an observation, and `client` is what makes it one.

        struct SRNodeView {

            // The fragment that declared this node. With `node.name`, the
            // frame's identity across the fused graph.
            string client;

            // As stored. `name` is the declared name, not the fusion key.
            SRNode node;

        };

        struct SREdgeView {

            // The fragment that declared this relation. Not necessarily the
            // owner of either endpoint: a client may relate its own node to
            // another fragment's global node.
            string client;

            // The fragments owning `edge.source` and `edge.target`. Each pairs
            // with the corresponding name in `edge` to identify a frame, and
            // either may differ from `client` and from the other.
            string source_client;
            string target_client;

            // As stored. `derived_from` names *declared* edge names, so it
            // means the same thing whichever read produced this view.
            SREdge edge;

        };
    };
};
#endif
