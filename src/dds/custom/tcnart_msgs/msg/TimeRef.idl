#ifndef TCNART_MSG_TIME_REF
#define TCNART_MSG_TIME_REF

// The time-reference query (tcnart's `tcn/time/ref/<name>` queryable): the request and reply payloads, CDR with the
// encapsulation header (00 01 00 00). All times are ns since the Unix epoch of the sender's CLOCK_REALTIME: t1 the
// client's send time, t2 the server's receive time (read first in the handler), t3 the server's send time.
// Protocol: tcnart v3/docs/protocols/time-reference.md. New in 0.10.5.

module tcnart_msgs {
  module msg {
    struct TimeRefRequest {
      int64 t1;
    };

    struct TimeRefReply {
      int64 t1;
      int64 t2;
      int64 t3;
    };
  };
};

#endif  // TCNART_MSG_TIME_REF
