// Test only: version 2 of evo_v1::msg::Thing, which appends an optional and a plain member (0.11 plan 4).
// A V1 reader skips them by the DHEADER; a V2 reader of V1 bytes sees `c` absent and `d` = 0 (decisions E8).
#ifndef EVO_V2_MSG_EVOLUTION_V2_IDL
#define EVO_V2_MSG_EVOLUTION_V2_IDL

module evo_v2 {
  module msg {
    @appendable struct Thing {
      int32 a;
      string b;
      @optional double c;
      int64 d;
    };

    // Data after a grown struct: a reader that does not skip by the DHEADER misreads the second element and `tail`.
    @appendable struct Holder {
      sequence<Thing> things;
      int32 tail;
    };

    // V2 of evo_v1::msg::Choice: KIND_B and its case appended (0.11 plan 6). A V1 reader skips the unknown case.
    @appendable enum Kind {
      KIND_UNKNOWN,
      KIND_A,
      KIND_B
    };

    @appendable union Choice switch (Kind) {
      case KIND_A: int32 a;
      case KIND_B: string b;
    };

    @appendable struct Boxed {
      Choice choice;
      int32 tail;
    };
  };
};

#endif
